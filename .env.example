# Where booking + contact requests are POSTed as JSON (GoHighLevel inbound webhook,
# Zapier/Make webhook, Formspree endpoint, …). Leave empty to fall back to call/text/email.
PUBLIC_LEAD_ENDPOINT=

# Optional Google Maps Places API key (browser key restricted to the site's domain)
# for address autocomplete on the booking form.
PUBLIC_GOOGLE_MAPS_KEY=
