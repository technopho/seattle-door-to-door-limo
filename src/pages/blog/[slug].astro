---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/content/Crumbs.astro';
import Prose from '../../components/content/Prose.astro';
import PostCta from '../../components/content/PostCta.astro';
import PostCard from '../../components/content/PostCard.astro';
import MobileToc from '../../components/content/MobileToc.astro';
import Icon from '../../components/Icon.astro';
import { publishedPosts, type Post, postHref, readingTime, formatDate, postToc, relatedPosts, showDraftBadge } from '../../data/posts';
import { site } from '../../data/site';
import { breadcrumbs, article } from '../../lib/seo';

export function getStaticPaths() {
  // Drafts are only built by the dev server (see posts.ts); production builds skip them entirely.
  return publishedPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const path = postHref(post);
const toc = postToc(post);
const related = relatedPosts(post, 2);
const minutes = readingTime(post);
const draftBadge = showDraftBadge(post);
// The article closes on its own booking card (PostCta), so the footer's CTA band is dropped
// (footerCta={false}) to avoid two identical asks back to back.
const jsonLd = [
  breadcrumbs([['Journal', '/blog/'], [post.title, path]]),
  article({ title: post.title, description: post.description, path, datePublished: post.date, dateModified: post.updated, image: post.image }),
];
---
<Base title={post.seoTitle} description={post.description} jsonLd={jsonLd} ogType="article" ogImage={post.image} noindex={post.draft} footerCta={false}>
  <span class="ap-progress" aria-hidden="true" data-progress></span>

  <article class="ap" aria-labelledby="post-title">
    <header class="ap__head">
      <div class="ap__bg" aria-hidden="true"><span></span></div>
      <div class="container">
      <Crumbs trail={[['Journal', '/blog/'], [post.crumb, path]]} />
      <div class="ap__intro">
        {draftBadge && (
          <p class="ap__draft"><span aria-hidden="true"></span> Draft for client review · not included in the production build</p>
        )}
        <p class="eyebrow" data-reveal="fade">{post.category}</p>
        <h1 id="post-title" class="ap__title" data-split>{post.title}</h1>
        <p class="ap__dek" data-reveal data-delay="0.2">{post.excerpt}</p>
        <p class="ap__meta" data-reveal="fade" data-delay="0.35">
          <span class="ap__by">{site.name}</span>
          <span class="ap__dot" aria-hidden="true"></span>
          <time datetime={post.date}>{formatDate(post.date)}</time>
          <span class="ap__dot" aria-hidden="true"></span>
          <span>{minutes} min read</span>
        </p>
      </div>
      </div>
    </header>

    <figure class="ap__hero container">
      <div class="ap__hero-media" data-reveal="scale">
        <img src={post.image} alt={post.imageAlt} width={post.imageWidth} height={post.imageHeight} decoding="async" fetchpriority="high" style={post.imagePosition ? `object-position: ${post.imagePosition}` : undefined} />
      </div>
    </figure>

    <div class="ap__layout container">
      <aside class="ap__aside">
        <div class="ap__sticky">
          {toc.length > 1 && (
            <nav class="ap-toc" aria-label="In this article">
              <p class="ap-toc__label">In this article</p>
              <ol role="list">
                {toc.map((t) => <li><a href={`#${t.id}`} data-toc-link={t.id}>{t.label}</a></li>)}
              </ol>
            </nav>
          )}
          <a href="/blog/" class="ap__back"><Icon name="arrow-left" /> All articles</a>
        </div>
      </aside>

      <div class="ap__body">
        {toc.length > 1 && <MobileToc items={toc} label="In this article" below={1000} />}
        <Prose html={post.body} class="ap__prose" />
        <PostCta post={post} />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="ap-rel section--tight surface-2" aria-labelledby="ap-rel-title">
      <div class="container">
        <div class="ap-rel__head">
          <h2 id="ap-rel-title" class="ap-rel__title" data-split>More from the <em>Journal</em></h2>
          <a href="/blog/" class="link-underline ap-rel__all" data-reveal="fade">All articles <Icon name="arrow" size={14} /></a>
        </div>
        <div class="ap-rel__grid" data-stagger="0.12">
          {related.map((p) => <PostCard post={p} headingLevel="h3" />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  /* ---------- Reading progress ---------- */
  .ap-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    height: 2px;
    background: var(--accent-grad);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  /* ---------- Head ---------- */
  .ap__head { position: relative; isolation: isolate; padding-top: calc(var(--header-h) + 0.75rem); padding-bottom: clamp(2rem, 4vw, 3.25rem); }
  .ap__bg { position: absolute; inset: 0 0 -40vh; z-index: -1; overflow: hidden; pointer-events: none; }
  .ap__bg span { position: absolute; top: -36vmax; right: -20vmax; width: 66vmax; height: 66vmax; border-radius: 50%; background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.13), rgb(var(--accent-rgb) / 0.03) 55%, transparent 72%); }
  .ap__intro { display: grid; gap: 1.3rem; justify-items: start; max-width: 980px; margin-top: clamp(0.75rem, 2vw, 1.75rem); }
  .ap__title { font-size: var(--fs-page-h1); line-height: 1.02; letter-spacing: -0.038em; max-width: 20ch; }
  .ap__title :global(.split-line) { vertical-align: top; }
  .ap__dek { font-size: clamp(1.08rem, 1.4vw, 1.3rem); line-height: 1.6; color: var(--text-2); max-width: 60ch; }
  .ap__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; font-size: 0.84rem; color: var(--muted); }
  .ap__by { color: var(--text); font-weight: 600; }
  .ap__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--muted-2); }
  /* Dev-server only: marks drafts awaiting client review. */
  .ap__draft { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.95rem; border: 1px dashed rgb(var(--accent-rgb) / 0.5); border-radius: 999px; background: rgb(var(--accent-rgb) / 0.07); font-size: 0.78rem; line-height: 1.35; color: var(--text-2); }
  .ap__draft span { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  /* ---------- Hero image ---------- */
  .ap__hero { margin-block: 0; }
  .ap__hero-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    max-height: 640px;
    width: 100%;
    border-radius: var(--radius-l);
    background: var(--bg-3);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 40px 80px -50px rgb(var(--fg-rgb) / 0.45);
  }
  .ap__hero-media img { width: 100%; height: 100%; object-fit: cover; }
  /* Dark photos on the onyx canvas need a hairline edge. */
  :global([data-theme='dark']) .ap__hero-media { outline: 1px solid var(--line); outline-offset: -1px; box-shadow: none; }

  /* ---------- Body ---------- */
  .ap__layout {
    display: grid;
    grid-template-columns: minmax(200px, 260px) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: var(--section-y);
  }
  .ap__aside { align-self: stretch; }
  .ap__sticky { position: sticky; top: calc(var(--header-h) + 1.5rem); display: grid; gap: 2rem; justify-items: start; }
  .ap-toc__label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); padding: 0 0 0.8rem 1rem; }
  .ap-toc ol { display: grid; border-left: 1px solid var(--line); }
  .ap-toc a { position: relative; display: block; padding: 0.55rem 0.5rem 0.55rem 1rem; font-size: 0.87rem; line-height: 1.4; color: var(--muted); transition: color 0.3s; }
  .ap-toc a::before { content: ''; position: absolute; left: -1px; top: 0.5rem; bottom: 0.5rem; width: 2px; border-radius: 2px; background: var(--accent-grad); transform: scaleY(0); transition: transform 0.5s var(--ease-out); }
  .ap-toc a:hover { color: var(--text); }
  .ap-toc a.is-active { color: var(--text); font-weight: 500; }
  .ap-toc a.is-active::before { transform: scaleY(1); }
  .ap__back { display: inline-flex; align-items: center; gap: 0.55rem; min-height: 44px; padding-left: 1rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2); transition: color 0.3s; }
  .ap__back :global(svg) { width: 15px; height: 15px; color: var(--accent); transition: transform 0.4s var(--ease-out); }
  .ap__back:hover { color: var(--text); }
  .ap__back:hover :global(svg) { transform: translateX(-3px); }
  .ap__body { min-width: 0; }
  /* Standfirst-style first paragraph */
  .ap__body :global(.ap__prose > p:first-child) { font-size: 1.2em; line-height: 1.6; color: var(--text); letter-spacing: -0.005em; }

  /* ---------- Related ---------- */
  .ap-rel__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .ap-rel__title { font-size: var(--fs-h2); }
  .ap-rel__title :global(.split-line) { vertical-align: top; }
  .ap-rel__all { min-height: 44px; }
  .ap-rel__all::after { bottom: 9px; }
  .ap-rel__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem); }

  @media (max-width: 1000px) {
    .ap__layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .ap__aside { display: none; }
    .ap__layout .ap__body { max-width: 68ch; margin-inline: auto; width: 100%; }
  }
  @media (max-width: 700px) {
    .ap-rel__grid { grid-template-columns: 1fr; }
    .ap__hero-media { aspect-ratio: 4 / 3; border-radius: var(--radius); }
  }
  @media (max-width: 560px) {
    .ap__by { flex-basis: 100%; }
    .ap__by + .ap__dot { display: none; }
    .ap__body :global(.ap__prose > p:first-child) { font-size: 1.1em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ap-progress { display: none; }
  }
</style>

<script>
  import { initTocSpy } from '../../components/content/tocSpy';

  initTocSpy();

  // Reading progress across the article body.
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.ap__body');
  if (bar && body) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - r.top) / Math.max(1, total)));
      bar.style.transform = `scaleX(${p})`;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
