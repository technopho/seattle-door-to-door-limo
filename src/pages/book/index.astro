  .bk-seg__opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .bk-seg--dir { max-width: 520px; }
  .bk-seg__opt .bk-seg__plane { width: 15px; height: 15px; transition: transform 0.6s var(--ease-out); }
  .bk-seg__opt .bk-seg__plane--land { transform: rotate(90deg); }

  /* Switch */
  .bk-switch { position: relative; display: flex; align-items: center; gap: 1rem; min-height: 52px; cursor: pointer; }
  .bk-switch__track { position: relative; flex: none; width: 52px; height: 30px; border-radius: 999px; border: 1px solid var(--line-strong); background: rgba(255, 255, 255, 0.04); transition: background 0.4s var(--ease-out), border-color 0.4s; }
  .bk-switch__thumb { position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--text-2); transition: transform 0.5s var(--ease-out), background 0.4s; }
  .bk-switch input:checked + .bk-switch__track { background: var(--accent-grad); border-color: transparent; }
  .bk-switch input:checked + .bk-switch__track .bk-switch__thumb { transform: translateX(22px); background: var(--on-accent); }
  .bk-switch input:focus-visible + .bk-switch__track { outline: 2px solid var(--accent); outline-offset: 3px; }
  .bk-switch__text { display: grid; line-height: 1.35; }
  .bk-switch__text strong { font-weight: 600; color: var(--text); }
  .bk-switch__text span { font-size: 0.8rem; color: var(--muted); }
  .bk-return { margin-top: 1rem; }

  /* Stepper */
  .bk-stepper { display: inline-grid; grid-template-columns: 44px 52px 44px; align-items: center; padding: 3px; border: 1px solid var(--line-strong); border-radius: 999px; background: rgb(var(--bg-rgb) / 0.55); }
  .bk-stepper__btn { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--text); transition: background 0.3s, color 0.3s, opacity 0.3s; }
  .bk-stepper__btn:hover:not(:disabled) { background: rgb(var(--accent-rgb) / 0.14); color: var(--accent-2); }
  .bk-stepper__btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .bk-stepper__btn svg { width: 16px; height: 16px; }
  .bk-stepper__val { width: 100%; border: 0; background: transparent; text-align: center; font-family: var(--font-sans); font-size: 1.12rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1; color: var(--text); -moz-appearance: textfield; appearance: textfield; outline: none; }
  .bk-stepper__val::-webkit-outer-spin-button, .bk-stepper__val::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .bk-stepper:focus-within { border-color: rgb(var(--accent-rgb) / 0.6); }

  /* ---------- Step 2: party + vehicles ---------- */
  .bk-party { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .bk-party__item { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.8rem; padding: 0.6rem 0.6rem 0.6rem 1rem; border: 1px solid var(--line); border-radius: 999px; background: rgba(255, 255, 255, 0.02); }
  .bk-party__icon { color: var(--accent-2); }
  .bk-party__icon svg { width: 20px; height: 20px; }
  .bk-party__label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-2); }
  .bk-fit { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1rem; font-size: 0.84rem; color: var(--muted); margin-top: -0.4rem; }
  .bk-fit__link { color: var(--accent-2); font-weight: 600; text-decoration: underline; text-decoration-color: rgb(var(--accent-2-rgb) / 0.35); text-underline-offset: 4px; }

  .bk-vehicles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; border-radius: var(--radius); }
  .bk-vehicle { position: relative; display: grid; grid-template-rows: auto 1fr; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--bg-2); cursor: pointer; transition: border-color 0.45s var(--ease-out), box-shadow 0.5s var(--ease-out), transform 0.5s var(--ease-out), opacity 0.4s; -webkit-tap-highlight-color: transparent; }
  .bk-vehicle:hover:not(.is-disabled) { border-color: var(--line-strong); transform: translateY(-3px); }
  .bk-vehicle.is-flipping { transition: none; z-index: 1; }
  .bk-vehicle__media { position: relative; display: block; aspect-ratio: 16 / 9.5; overflow: hidden; background: var(--bg-3); }
  .bk-vehicle__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out), filter 0.5s; }
  .bk-vehicle__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgb(var(--bg-rgb) / 0.55)); pointer-events: none; }
  .bk-vehicle:hover:not(.is-disabled) .bk-vehicle__media img { transform: scale(1.05); }
  .bk-vehicle.is-studio .bk-vehicle__media { background: radial-gradient(120% 90% at 50% 30%, #fbf8f2 0%, #ece5d8 70%, #e2d9c8 100%); }
  .bk-vehicle.is-studio .bk-vehicle__media img { object-fit: contain; padding: 6% 9%; mix-blend-mode: multiply; }
  .bk-vehicle.is-studio .bk-vehicle__media::after { background: linear-gradient(180deg, transparent 70%, rgb(var(--bg-rgb) / 0.25)); }
  .bk-vehicle__badge { position: absolute; left: 0.7rem; top: 0.7rem; z-index: 2; padding: 0.32rem 0.7rem; border-radius: 999px; background: var(--accent-grad); color: var(--on-accent); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.6); }
  .bk-vehicle__badge[hidden] { display: none; }
  .bk-vehicle__body { display: grid; align-content: start; gap: 0.35rem; padding: 1rem 1.1rem 1.15rem; }
  .bk-vehicle__cat { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }
  .bk-vehicle__name { font-family: var(--font-display); font-size: 1.45rem; line-height: 1.1; color: var(--text); }
  .bk-vehicle__specs { display: flex; gap: 1rem; margin-top: 0.2rem; font-size: 0.84rem; font-weight: 600; color: var(--text-2); }
  .bk-vehicle__specs > span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .bk-vehicle__specs svg { width: 15px; height: 15px; color: var(--muted); }
  .bk-vehicle__feats { font-size: 0.78rem; line-height: 1.45; color: var(--muted); }
  .bk-vehicle__note { display: inline-flex; justify-self: start; margin-top: 0.3rem; padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid var(--line-strong); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; color: var(--text-2); }
  .bk-vehicle__note[hidden] { display: none; }
  .bk-vehicle:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 30px 60px -34px rgb(var(--accent-rgb) / 0.75); }
  .bk-vehicle:has(input:checked) .bk-tick { opacity: 1; transform: none; }
  .bk-vehicle:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .bk-vehicle.is-disabled { cursor: not-allowed; opacity: 0.42; }
  .bk-vehicle.is-disabled .bk-vehicle__media img { filter: grayscale(1) brightness(0.7); }
  .bk-vehicles[aria-invalid='true'] .bk-vehicle:not(.is-disabled) { border-color: rgba(229, 138, 122, 0.5); }

  /* ---------- Step 3: chips, consent ---------- */
  .bk-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .bk-chip { position: relative; display: inline-flex; align-items: center; gap: 0.6rem; min-height: 46px; padding: 0 1.1rem 0 0.55rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.86rem; font-weight: 500; color: var(--text-2); cursor: pointer; transition: border-color 0.35s, background 0.35s, color 0.35s; -webkit-tap-highlight-color: transparent; }
  .bk-chip:hover { border-color: rgb(var(--fg-rgb) / 0.32); color: var(--text); }
  .bk-chip__box { position: relative; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, 0.05); color: var(--muted); transition: background 0.35s, color 0.35s; }
  .bk-chip__box svg { position: absolute; width: 14px; height: 14px; transition: opacity 0.3s, transform 0.45s var(--ease-out); }
  .bk-chip__check { opacity: 0; transform: scale(0.5) rotate(-30deg); stroke-width: 2.2; }
  .bk-chip:has(input:checked) { border-color: rgb(var(--accent-rgb) / 0.8); background: rgb(var(--accent-rgb) / 0.1); color: var(--text); }
  .bk-chip:has(input:checked) .bk-chip__box { background: var(--accent-grad); color: var(--on-accent); }
  .bk-chip:has(input:checked) .bk-chip__plus { opacity: 0; transform: scale(0.5) rotate(90deg); }
  .bk-chip:has(input:checked) .bk-chip__check { opacity: 1; transform: none; }
  .bk-chip:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }

  .bk-consent-wrap { display: grid; gap: 0.6rem; }
  .bk-consent-row { display: flex; align-items: stretch; border: 1px solid var(--line-strong); border-radius: 14px; background: rgb(var(--bg-rgb) / 0.35); transition: border-color 0.35s, background 0.35s, box-shadow 0.35s; }
  .bk-consent-row:has(input:checked) { border-color: rgb(var(--accent-rgb) / 0.75); background: rgb(var(--accent-rgb) / 0.07); box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.18); }
  .bk-consent-row:has(input[aria-invalid='true']) { border-color: rgba(229, 138, 122, 0.6); }
  .bk-consent { position: relative; flex: 1; display: flex; align-items: center; gap: 0.85rem; min-height: 56px; padding: 0.65rem 0.9rem; cursor: pointer; font-size: 0.95rem; color: var(--text); -webkit-tap-highlight-color: transparent; }
  .bk-consent__view { flex: none; display: inline-flex; align-items: center; min-height: 44px; margin: 6px; padding: 0 0.95rem; border-radius: 10px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-2); transition: background 0.3s, color 0.3s; }
  .bk-consent__view:hover { background: rgb(var(--accent-rgb) / 0.12); }
  .bk-consent__box { display: grid; place-items: center; flex: none; width: 26px; height: 26px; border-radius: 8px; border: 1px solid var(--line-strong); background: rgb(var(--bg-rgb) / 0.5); color: var(--on-accent); transition: background 0.35s, border-color 0.35s; }
  .bk-consent__box svg { width: 15px; height: 15px; stroke-width: 2.4; opacity: 0; transform: scale(0.6); transition: opacity 0.3s, transform 0.45s var(--ease-out); }
  .bk-consent input:checked + .bk-consent__box { background: var(--accent-grad); border-color: transparent; }
  .bk-consent input:checked + .bk-consent__box svg { opacity: 1; transform: none; }
  .bk-consent input:focus-visible + .bk-consent__box { outline: 2px solid var(--accent); outline-offset: 3px; }
  .bk-consent input[aria-invalid='true'] + .bk-consent__box { border-color: var(--err); }

  /* Terms dialog */
  .bk-terms { width: min(480px, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); margin: auto; padding: 0; border: 1px solid var(--line-strong); border-radius: var(--radius-l); background: linear-gradient(180deg, var(--bg-3), var(--bg-2)); color: var(--text); box-shadow: 0 50px 120px -40px rgba(0, 0, 0, 0.9); overflow: auto; }
  .bk-terms::backdrop { background: rgb(var(--bg-rgb) / 0.72); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .bk-terms__inner { position: relative; display: grid; gap: 1rem; padding: clamp(1.5rem, 4vw, 2.2rem); }
  .bk-terms__title { font-size: clamp(1.9rem, 4vw, 2.4rem); line-height: 1.05; }
  .bk-terms__list { display: grid; gap: 0.85rem; margin: 0.3rem 0 0.4rem; }
  .bk-terms__list li { display: flex; gap: 0.75rem; font-size: 0.9rem; line-height: 1.5; color: var(--text-2); }
  .bk-terms__list strong { color: var(--text); font-weight: 600; }
  .bk-terms__list svg { flex: none; width: 17px; height: 17px; margin-top: 0.15rem; color: var(--accent); }
  .bk-terms__x { position: absolute; top: 0.75rem; right: 0.75rem; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--muted); transition: color 0.3s, background 0.3s; }
  .bk-terms__x:hover { color: var(--text); background: rgba(255, 255, 255, 0.06); }
  .bk-terms__x svg { width: 18px; height: 18px; }
  .bk-terms__ok { justify-self: start; }
  .bk-assure { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.82rem; color: var(--muted); line-height: 1.5; }
  .bk-assure svg { width: 17px; height: 17px; flex: none; color: var(--accent); margin-top: 0.1rem; }

  /* ---------- Review ---------- */
  .bk-review { display: grid; gap: 0.8rem; }
  .bk-review__block { padding: 1.1rem 1.25rem 1.2rem; border: 1px solid var(--line); border-radius: 16px; background: rgba(255, 255, 255, 0.018); }
  .bk-review__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
  .bk-review__title { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .bk-review__edit { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.9rem; margin-right: -0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2); transition: color 0.3s, background 0.3s; }
  .bk-review__edit:hover { color: var(--accent-2); background: rgb(var(--accent-rgb) / 0.1); }
  .bk-review__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem 1.5rem; }
  .bk-review__list > div { min-width: 0; }
  .bk-review__list .is-wide { grid-column: 1 / -1; }
  .bk-review__list dt { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.15rem; }
  .bk-review__list dd { margin: 0; font-size: 0.95rem; color: var(--text); overflow-wrap: anywhere; line-height: 1.45; }
  .bk-review__list dd .muted { color: var(--muted); }

  /* ---------- Nav ---------- */
  .bk-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: clamp(1.8rem, 4vw, 2.6rem); padding-top: clamp(1.4rem, 3vw, 1.8rem); border-top: 1px solid var(--line); }
  .bk-nav__journey { display: none; }
  .bk-nav-sentinel { display: block; height: 1px; margin-top: -1px; pointer-events: none; }
  .bk-nav__back.is-hidden { visibility: hidden; }
  .bk-nav__hint { flex: 1; text-align: right; font-size: 0.8rem; color: var(--muted); }
  .bk-nav__next { min-width: 190px; }
  .bk-nav__next.is-final { min-height: 60px; padding: 0 2.2rem; }
  .bk-spinner { position: absolute; left: 50%; top: 50%; width: 20px; height: 20px; margin: -10px 0 0 -10px; border-radius: 50%; border: 2px solid rgba(23, 19, 11, 0.25); border-top-color: var(--on-accent); opacity: 0; animation: bk-spin 0.8s linear infinite; }
  @keyframes bk-spin { to { transform: rotate(360deg); } }
  .bk-nav__next.is-loading { pointer-events: none; }
  .bk-nav__next.is-loading .bk-nav__label, .bk-nav__next.is-loading svg { opacity: 0; }
  .bk-nav__next.is-loading .bk-spinner { opacity: 1; }

  /* ---------- Summary ---------- */
  .bk-sum { position: sticky; top: calc(70px + 1.25rem); border-radius: var(--radius-l); padding: clamp(1.3rem, 2.2vw, 1.8rem); background: linear-gradient(180deg, rgb(var(--bg-rgb) / 0.7), rgb(var(--bg-rgb) / 0.7)); }
  .bk-sum__toggle { display: none; }
  .bk-sum__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--line); }
  .bk-sum__title { font-size: 1.9rem; }
  .bk-sum__live { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .bk-sum__pulse { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0.6); animation: bk-pulse 2.4s infinite; }
  @keyframes bk-pulse { 70% { box-shadow: 0 0 0 8px rgb(var(--accent-rgb) / 0); } 100% { box-shadow: 0 0 0 0 rgb(var(--accent-rgb) / 0); } }
  .bk-sum__row { position: relative; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .bk-sum__row[hidden] { display: none; }
  .bk-sum__k { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .bk-sum__v { font-size: 0.95rem; color: var(--text); line-height: 1.4; overflow-wrap: anywhere; }
  .bk-sum__v.is-empty { color: var(--muted-2); font-style: italic; font-family: var(--font-display); font-size: 1.08rem; }
  .bk-sum__sub { font-size: 0.8rem; color: var(--muted); white-space: pre-line; line-height: 1.5; margin-top: 0.15rem; }
  .bk-sum__sub:empty { display: none; }
  .bk-sum__service { display: flex; gap: 0.9rem; align-items: center; }
  .bk-sum__svc-icon { display: grid; place-items: center; flex: none; width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgb(var(--accent-rgb) / 0.45); color: var(--accent-2); }
  .bk-sum__svc-icon svg { width: 19px; height: 19px; }
  .bk-sum__svc-icon > span[hidden] { display: none; }
  .bk-sum__route { display: grid; gap: 0.9rem; padding-left: 1.6rem; }
  .bk-sum__connector { position: absolute; left: 5px; top: calc(1rem + 9px); bottom: calc(1rem + 2.4rem); width: 1px; background-image: radial-gradient(circle, var(--accent) 1px, transparent 1.4px); background-size: 1px 6px; background-repeat: repeat-y; }
  .bk-sum__stop { position: relative; }
  .bk-sum__dot { position: absolute; left: calc(-1.6rem + 1px); top: 4px; width: 9px; height: 9px; border-radius: 50%; }
  .bk-sum__dot--start { background: var(--accent); box-shadow: 0 0 0 3px rgb(var(--accent-rgb) / 0.2); }
  .bk-sum__dot--end { border: 1.5px solid var(--accent); background: var(--bg); border-radius: 2px; transform: rotate(45deg); width: 8px; height: 8px; left: calc(-1.6rem + 1.5px); }
  .bk-sum__dot--stop { border: 1.5px solid var(--accent-2); background: var(--bg); width: 7px; height: 7px; left: calc(-1.6rem + 2px); top: 5px; }
  [data-sum='stops'] { display: grid; gap: 0.9rem; }
  [data-sum='stops']:empty { display: none; }
  .bk-sum__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .bk-sum__vehicle { display: flex; align-items: center; gap: 0.9rem; }
  .bk-sum__thumb { display: grid; place-items: center; flex: none; width: 84px; height: 56px; overflow: hidden; border-radius: 10px; border: 1px solid var(--line); background: var(--bg-3); color: var(--muted-2); }
  .bk-sum__thumb svg { width: 24px; height: 24px; }
  .bk-sum__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .bk-sum__thumb.is-studio { background: radial-gradient(120% 90% at 50% 30%, #fbf8f2, #e6dfd2); }
  .bk-sum__thumb.is-studio img { object-fit: contain; padding: 4px 6px; mix-blend-mode: multiply; }
  .bk-sum__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }
  .bk-sum__chips .chip { font-size: 0.72rem; padding: 0.3rem 0.7rem; }
  .bk-sum .bk-sum__trust { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem 0.9rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .bk-sum__trust li { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.76rem; line-height: 1.35; color: var(--text-2); }
  .bk-sum__trust svg { width: 15px; height: 15px; flex: none; color: var(--accent); margin-top: 1px; }
  .bk-sum__call { display: flex; align-items: center; gap: 0.85rem; margin-top: 1.1rem; padding: 0.7rem 1rem 0.7rem 0.7rem; min-height: 60px; border: 1px solid var(--line); border-radius: 999px; transition: border-color 0.4s, background 0.4s; }
  .bk-sum__call:hover { border-color: rgb(var(--accent-rgb) / 0.5); background: rgb(var(--accent-rgb) / 0.06); }
  .bk-sum__call > svg { width: 18px; height: 18px; margin-left: auto; color: var(--accent-2); transition: transform 0.4s var(--ease-out); }
  .bk-sum__call:hover > svg { transform: translateX(4px); }
  .bk-sum__call-icon { display: grid; place-items: center; flex: none; width: 42px; height: 42px; border-radius: 50%; background: var(--accent-grad); color: var(--on-accent); }
  .bk-sum__call-icon svg { width: 17px; height: 17px; }
  .bk-sum__call-k { display: block; font-size: 0.7rem; color: var(--muted); letter-spacing: 0.04em; }
  .bk-sum__call-v { display: block; font-weight: 700; letter-spacing: 0.02em; color: var(--text); }
  .bk-sum__row::before { content: ''; position: absolute; inset: 0 -0.8rem; border-radius: 12px; background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.14), transparent 75%); opacity: 0; pointer-events: none; }
  .bk-sum__row.is-flash::before { animation: bk-row-flash 1.3s var(--ease-out); }
  @keyframes bk-row-flash { 0% { opacity: 1; } 100% { opacity: 0; } }

  /* ---------- Success ---------- */
  .bk-success { display: grid; justify-items: center; text-align: center; gap: 1rem; max-width: 820px; margin-inline: auto; padding: clamp(2rem, 5vw, 3.6rem) clamp(1.25rem, 4vw, 3.2rem); border-radius: var(--radius-l); background: linear-gradient(180deg, rgb(var(--bg-rgb) / 0.85), rgb(var(--bg-rgb) / 0.9)); outline: none; }
  .bk-success[hidden] { display: none; }
