---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { fleet, site } from '../../data/site';

// Vehicles ordered by capacity so the grid reads small -> large.
const vehicles = [...fleet].sort((a, b) => a.passengers - b.passengers || a.luggage - b.luggage);

const serviceTypes = [
  { value: 'airport', label: 'Airport transfer', sub: 'SeaTac · Paine Field', icon: 'plane' },
  { value: 'p2p', label: 'Point-to-point', sub: 'Door to door, one way', icon: 'route' },
  { value: 'hourly', label: 'Hourly', sub: 'As directed, chauffeur on call', icon: 'hourglass' },
  { value: 'weddings', label: 'Wedding', sub: 'Couple, party & guests', icon: 'rings' },
  { value: 'events', label: 'Special event', sub: 'Prom, concerts, nights out', icon: 'glass' },
  { value: 'cruise', label: 'Cruise terminal', sub: 'Pier 66 · Pier 91', icon: 'ship' },
  { value: 'corporate', label: 'Corporate', sub: 'Executives & roadshows', icon: 'briefcase' },
];

const addons = [
  { value: 'child-seat', label: 'Child seat' },
  { value: 'meet-greet', label: 'Meet & greet sign' },
  { value: 'champagne', label: 'Champagne on ice' },
  { value: 'extra-luggage', label: 'Extra luggage' },
  { value: 'red-carpet', label: 'Red carpet' },
];

const places = [
  'Seattle-Tacoma International Airport (SEA)',
  'Paine Field Airport (PAE)',
  'Boeing Field (BFI)',
  'Pier 66, Bell Street Cruise Terminal',
  'Pier 91, Smith Cove Cruise Terminal',
  'Downtown Seattle',
  'Downtown Bellevue',
  'Kirkland',
  'Redmond',
  'Tacoma',
  'Everett',
  'Woodinville Wine Country',
];

const airlines = ['Alaska Airlines', 'Delta Air Lines', 'United Airlines', 'American Airlines', 'Southwest Airlines', 'JetBlue', 'Hawaiian Airlines', 'Air Canada', 'British Airways', 'Lufthansa', 'Emirates', 'Japan Airlines'];

const steps = ['Trip', 'Vehicle', 'Details', 'Review'];
const trust = [
  { icon: 'shield', text: 'Licensed & insured' },
  { icon: 'calendar', text: 'Free cancellation up to 24h' },
  { icon: 'clock', text: 'Confirmed in minutes' },
  { icon: 'star', text: `${site.rating.score} · ${site.rating.count} reviews` },
];
---
<Base title="Reserve Your Ride | Seattle Door to Door Limo" footer={false}>
  <div class="bk-bg" aria-hidden="true">
    <span class="bk-bg__glow bk-bg__glow--a"></span>
    <span class="bk-bg__glow bk-bg__glow--b"></span>
    <span class="bk-bg__glow bk-bg__glow--c"></span>
    <span class="bk-bg__grid"></span>
  </div>

  <section class="bk" data-booking>
    <div class="container">
      <header class="bk-head">
        <div class="bk-head__main">
          <p class="eyebrow" data-reveal="fade">Reservations · 24/7</p>
          <h1 class="bk-head__title" data-split>Reserve your <em>ride</em></h1>
        </div>
        <div class="bk-head__aside" data-reveal data-delay="0.2">
          <p class="lead">Four quick steps. A real concierge confirms within minutes.</p>
          <p class="bk-head__proof">
            <span class="stars" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
            <span><strong>{site.rating.score}</strong> from {site.rating.count} reviews · Since {site.since}</span>
          </p>
        </div>
      </header>

      <div class="bk-layout" data-layout>
        <!-- ================= Wizard ================= -->
        <div class="bk-main" data-reveal data-delay="0.1">
          <form class="bk-wizard card" data-wizard novalidate aria-labelledby="bk-wizard-title">
            <h2 id="bk-wizard-title" class="sr-only">Reservation request</h2>

            <div class="bk-restore" data-restore hidden>
              <Icon name="sparkle" />
              <p>Welcome back. We kept your trip details.</p>
              <button type="button" class="bk-restore__btn" data-restart>Start fresh</button>
            </div>

            <nav class="bk-progress" aria-label="Booking steps">
              <span class="bk-progress__track" aria-hidden="true"><span class="bk-progress__reach" data-progress-reach></span><span class="bk-progress__fill" data-progress-fill></span></span>
              <ol role="list" class="bk-progress__list">
                {steps.map((label, i) => (
                  <li class="bk-progress__item" data-progress-item={i + 1}>
                    <button type="button" class="bk-progress__btn" data-goto={i + 1} disabled={i > 0} aria-current={i === 0 ? 'step' : undefined}>
                      <span class="bk-progress__dot" aria-hidden="true">
                        <span class="bk-progress__num">{i + 1}</span>
                        <Icon name="check" class="bk-progress__tick" />
                      </span>
                      <span class="bk-progress__label"><span class="sr-only">Step {i + 1}: </span>{label}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </nav>

            <div class="bk-viewport" data-viewport>
              <!-- ---------- Step 1: Trip ---------- -->
              <fieldset class="bk-step" data-step="1">
                <legend class="sr-only">Step 1 of 4: Trip</legend>
                <div class="bk-step__head" data-anim>
                  <p class="bk-step__kicker">Step 1 of 4 · Trip</p>
                  <h3 class="bk-step__title" tabindex="-1">Where are we <em>taking you?</em></h3>
                </div>

                <div class="bk-group" data-anim>
                  <p class="bk-group__label" id="lbl-type">Service</p>
                  <div class="bk-types" role="radiogroup" aria-labelledby="lbl-type" aria-describedby="err-type" data-group="type">
                    {serviceTypes.map((t) => (
                      <label class="bk-type">
                        <input type="radio" name="type" value={t.value} class="bk-hide-input" />
                        <span class="bk-type__icon"><Icon name={t.icon} /></span>
                        <span class="bk-type__text">
                          <span class="bk-type__title">{t.label}</span>
                          <span class="bk-type__sub">{t.sub}</span>
                        </span>
                        <span class="bk-tick" aria-hidden="true"><Icon name="check" /></span>
                      </label>
                    ))}
                    <a class="bk-type bk-type--talk" href={site.phoneHref}>
                      <span class="bk-type__icon"><Icon name="phone" /></span>
                      <span class="bk-type__text">
                        <span class="bk-type__title">Something else?</span>
                        <span class="bk-type__sub">Talk to a concierge</span>
                      </span>
                    </a>
                  </div>
                  <p class="bk-err" id="err-type" data-err="type"></p>
                </div>

                <!-- Airport direction sits right under the service, before any address is typed -->
                <div class="bk-cond" data-when="airport" hidden>
                  <div class="bk-group">
                    <p class="bk-group__label" id="lbl-direction">Your flight is</p>
                    <div class="bk-seg bk-seg--dir" role="radiogroup" aria-labelledby="lbl-direction">
                      <label class="bk-seg__opt"><input type="radio" name="direction" value="departing" class="bk-hide-input" /><span><Icon name="plane" class="bk-seg__plane" /> Departing Seattle</span></label>
                      <label class="bk-seg__opt"><input type="radio" name="direction" value="arriving" class="bk-hide-input" checked /><span><Icon name="plane" class="bk-seg__plane bk-seg__plane--land" /> Arriving in Seattle</span></label>
                    </div>
                  </div>
                </div>

                <div class="bk-group" data-anim>
                  <p class="bk-group__label">Route</p>
                  <div class="bk-route" data-route>
                    <span class="bk-route__line" aria-hidden="true"></span>
                    <div class="bk-route__row" data-row="from">
                      <span class="bk-route__marker bk-route__marker--start" aria-hidden="true"></span>
                      <div class="bk-route__field">
                        <label class="bk-route__label" for="f-from">Pickup</label>
                        <input class="bk-route__input" id="f-from" name="from" type="text" autocomplete="off" list="bk-places" placeholder="Address, hotel or airport" aria-describedby="err-from" data-ph="from" />
                      </div>
                    </div>
                    <div class="bk-stops" data-stops></div>
                    <div class="bk-route__row" data-row="to">
                      <span class="bk-route__marker bk-route__marker--end" aria-hidden="true"></span>
                      <div class="bk-route__field">
                        <label class="bk-route__label" for="f-to" data-to-label>Drop-off</label>
                        <input class="bk-route__input" id="f-to" name="to" type="text" autocomplete="off" list="bk-places" placeholder="Address, hotel or venue" aria-describedby="err-to" data-ph="to" />
                      </div>
                    </div>
                    <button type="button" class="bk-route__swap" data-swap aria-label="Swap pickup and drop-off"><Icon name="swap" /></button>
                  </div>
                  <p class="bk-err" id="err-from" data-err="from"></p>
                  <p class="bk-err" id="err-stops" data-err="stops"></p>
                  <p class="bk-err" id="err-to" data-err="to"></p>
                  <button type="button" class="bk-addstop" data-add-stop><Icon name="plus" /> Add a stop</button>
                  <datalist id="bk-places">{places.map((p) => <option value={p} />)}</datalist>
                </div>

                <div class="bk-grid-2" data-anim>
                  <div class="field">
                    <label for="f-date">Pickup date</label>
                    <input class="input" id="f-date" name="date" type="date" aria-describedby="err-date" />
                    <p class="bk-err" id="err-date" data-err="date"></p>
                  </div>
                  <div class="field">
                    <label for="f-time">Pickup time</label>
                    <input class="input" id="f-time" name="time" type="time" step="300" aria-describedby="err-time" />
                    <p class="bk-err" id="err-time" data-err="time"></p>
                  </div>
                </div>

                <!-- Airport details -->
                <div class="bk-cond" data-when="airport" hidden>
                  <div class="bk-panel">
                    <div class="bk-panel__head">
                      <span class="bk-panel__icon"><Icon name="plane" /></span>
                      <div>
                        <p class="bk-panel__title">Flight details</p>
                        <p class="bk-panel__note" data-flight-note>We track your flight in real time and adjust pickup automatically.</p>
                      </div>
                    </div>
                    <div class="bk-grid-2">
                      <div class="field">
                        <label for="f-airline">Airline</label>
                        <input class="input" id="f-airline" name="airline" type="text" list="bk-airlines" autocomplete="off" placeholder="e.g. Alaska Airlines" />
                        <datalist id="bk-airlines">{airlines.map((a) => <option value={a} />)}</datalist>
                      </div>
                      <div class="field">
                        <label for="f-flight">Flight number <span class="bk-opt" data-flight-opt hidden>(optional)</span></label>
                        <input class="input" id="f-flight" name="flight" type="text" autocomplete="off" autocapitalize="characters" placeholder="e.g. AS 1234" aria-describedby="err-flight" />
                        <p class="bk-err" id="err-flight" data-err="flight"></p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Hourly -->
                <div class="bk-cond" data-when="hourly" hidden>
                  <div class="bk-panel bk-panel--row">
                    <div class="bk-panel__head">
                      <span class="bk-panel__icon"><Icon name="hourglass" /></span>
                      <div>
                        <p class="bk-panel__title" id="lbl-hours">Hours with your chauffeur</p>
                        <p class="bk-panel__note">Minimum 2 hours. Extend on the day if plans change.</p>
                      </div>
                    </div>
                    <div class="bk-stepper" data-stepper>
                      <button type="button" class="bk-stepper__btn" data-dec aria-label="Fewer hours"><Icon name="minus" /></button>
                      <input class="bk-stepper__val" type="number" name="hours" id="f-hours" value="3" min="2" max="12" inputmode="numeric" aria-labelledby="lbl-hours" />
                      <button type="button" class="bk-stepper__btn" data-inc aria-label="More hours"><Icon name="plus" /></button>
                    </div>
                  </div>
                </div>

                <!-- Round trip -->
                <div class="bk-cond" data-when="not-hourly" data-anim>
                  <label class="bk-switch">
                    <input type="checkbox" name="roundTrip" role="switch" class="bk-hide-input" />
                    <span class="bk-switch__track" aria-hidden="true"><span class="bk-switch__thumb"></span></span>
                    <span class="bk-switch__text"><strong>Round trip</strong><span>Add a return ride with the same chauffeur service</span></span>
                  </label>
                  <div class="bk-cond" data-when="round" hidden>
                    <div class="bk-grid-2 bk-return">
                      <div class="field">
                        <label for="f-rdate">Return date</label>
                        <input class="input" id="f-rdate" name="returnDate" type="date" aria-describedby="err-returnDate" />
                        <p class="bk-err" id="err-returnDate" data-err="returnDate"></p>
                      </div>
                      <div class="field">
                        <label for="f-rtime">Return time</label>
                        <input class="input" id="f-rtime" name="returnTime" type="time" step="300" aria-describedby="err-returnTime" />
                        <p class="bk-err" id="err-returnTime" data-err="returnTime"></p>
                      </div>
                    </div>
                  </div>
                </div>
              </fieldset>

              <!-- ---------- Step 2: Vehicle ---------- -->
              <fieldset class="bk-step" data-step="2" hidden>
                <legend class="sr-only">Step 2 of 4: Vehicle</legend>
                <div class="bk-step__head" data-anim>
                  <p class="bk-step__kicker">Step 2 of 4 · Vehicle</p>
                  <h3 class="bk-step__title" tabindex="-1">Choose your <em>vehicle</em></h3>
                </div>

                <div class="bk-party" data-anim>
                  <div class="bk-party__item">
                    <span class="bk-party__icon"><Icon name="users" /></span>
                    <span class="bk-party__label" id="lbl-pax">Passengers</span>
                    <div class="bk-stepper" data-stepper>
                      <button type="button" class="bk-stepper__btn" data-dec aria-label="Fewer passengers"><Icon name="minus" /></button>
                      <input class="bk-stepper__val" type="number" name="pax" id="f-pax" value="2" min="1" max="20" inputmode="numeric" aria-labelledby="lbl-pax" />
                      <button type="button" class="bk-stepper__btn" data-inc aria-label="More passengers"><Icon name="plus" /></button>
                    </div>
                  </div>
                  <div class="bk-party__item">
                    <span class="bk-party__icon"><Icon name="suitcase" /></span>
                    <span class="bk-party__label" id="lbl-lug">Luggage</span>
                    <div class="bk-stepper" data-stepper>
                      <button type="button" class="bk-stepper__btn" data-dec aria-label="Fewer bags"><Icon name="minus" /></button>
                      <input class="bk-stepper__val" type="number" name="luggage" id="f-lug" value="2" min="0" max="20" inputmode="numeric" aria-labelledby="lbl-lug" />
                      <button type="button" class="bk-stepper__btn" data-inc aria-label="More bags"><Icon name="plus" /></button>
                    </div>
                  </div>
                </div>

                <p class="bk-fit" data-anim aria-live="polite"><span data-fit-text>All vehicles seat your party.</span> <a href={site.phoneHref} class="bk-fit__link">Larger group? Call us</a></p>

                <div class="bk-vehicles" role="radiogroup" aria-label="Vehicle" aria-describedby="err-vehicle" data-group="vehicle" data-anim>
                  {vehicles.map((v) => (
                    <label class:list={['bk-vehicle', v.id === 'sprinter' && 'is-studio']} data-vehicle={v.id} data-cap={v.passengers} data-lug={v.luggage}>
                      <input type="radio" name="vehicle" value={v.id} class="bk-hide-input" />
                      <span class="bk-vehicle__media">
                        <img src={v.image} alt={`${v.name}, ${v.category.toLowerCase()}`} loading="lazy" decoding="async" width="640" height="400" />
                        <span class="bk-vehicle__badge" data-rec hidden>Recommended</span>
                      </span>
                      <span class="bk-tick" aria-hidden="true"><Icon name="check" /></span>
                      <span class="bk-vehicle__body">
                        <span class="bk-vehicle__cat">{v.category}</span>
                        <span class="bk-vehicle__name">{v.name}</span>
                        <span class="bk-vehicle__specs">
                          <span><Icon name="users" /> {v.passengers} <span class="sr-only">passengers</span></span>
                          <span><Icon name="suitcase" /> {v.luggage} <span class="sr-only">bags</span></span>
                        </span>
                        <span class="bk-vehicle__feats">{v.features.slice(0, 2).map((f) => f.replace(/ /g, '\u00a0')).join('\u00a0· ')}</span>
                        <span class="bk-vehicle__note" data-cap-note hidden>Seats up to {v.passengers}</span>
                      </span>
                    </label>
                  ))}
                </div>
                <p class="bk-err" id="err-vehicle" data-err="vehicle"></p>
              </fieldset>

              <!-- ---------- Step 3: Details ---------- -->
              <fieldset class="bk-step" data-step="3" hidden>
                <legend class="sr-only">Step 3 of 4: Details</legend>
                <div class="bk-step__head" data-anim>
                  <p class="bk-step__kicker">Step 3 of 4 · Details</p>
                  <h3 class="bk-step__title" tabindex="-1">Who are we <em>driving?</em></h3>
                </div>

                <div class="field" data-anim>
                  <label for="f-name">Full name</label>
                  <input class="input" id="f-name" name="name" type="text" autocomplete="name" placeholder="As it should appear on the reservation" aria-describedby="err-name" />
                  <p class="bk-err" id="err-name" data-err="name"></p>
                </div>
                <div class="bk-grid-2" data-anim>
                  <div class="field">
                    <label for="f-phone">Mobile phone</label>
                    <input class="input" id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(206) 555-0123" aria-describedby="err-phone" />
                    <p class="bk-err" id="err-phone" data-err="phone"></p>
                  </div>
                  <div class="field">
                    <label for="f-email">Email</label>
                    <input class="input" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" aria-describedby="err-email" />
                    <p class="bk-err" id="err-email" data-err="email"></p>
                  </div>
                </div>
                <div class="field" data-anim>
                  <label for="f-lead">Lead passenger <span class="bk-opt">(if different, optional)</span></label>
                  <input class="input" id="f-lead" name="leadName" type="text" autocomplete="off" placeholder="Who should your chauffeur ask for?" />
                </div>

                <div class="bk-group" data-anim>
                  <p class="bk-group__label" id="lbl-contact">How should we confirm?</p>
                  <div class="bk-seg bk-seg--3" role="radiogroup" aria-labelledby="lbl-contact">
                    <label class="bk-seg__opt"><input type="radio" name="contact" value="call" class="bk-hide-input" /><span><Icon name="phone" /> Call</span></label>
                    <label class="bk-seg__opt"><input type="radio" name="contact" value="text" class="bk-hide-input" checked /><span><Icon name="chat" /> Text</span></label>
                    <label class="bk-seg__opt"><input type="radio" name="contact" value="email" class="bk-hide-input" /><span><Icon name="mail" /> Email</span></label>
                  </div>
                </div>

                <div class="bk-group" data-anim>
                  <p class="bk-group__label" id="lbl-addons">Little luxuries <span class="bk-opt">(optional)</span></p>
                  <div class="bk-chips" role="group" aria-labelledby="lbl-addons">
                    {addons.map((a) => (
                      <label class="bk-chip">
                        <input type="checkbox" name="addons" value={a.value} class="bk-hide-input" />
                        <span class="bk-chip__box" aria-hidden="true"><Icon name="plus" class="bk-chip__plus" /><Icon name="check" class="bk-chip__check" /></span>
                        {a.label}
                      </label>
                    ))}
                  </div>
                </div>

                <div class="field" data-anim>
                  <label for="f-req">Special requests <span class="bk-opt">(optional)</span></label>
                  <textarea class="input bk-textarea" id="f-req" name="requests" rows="3" placeholder="Occasion, accessibility needs, preferred music, anything we should know"></textarea>
                </div>
              </fieldset>

              <!-- ---------- Step 4: Review ---------- -->
              <fieldset class="bk-step" data-step="4" hidden>
                <legend class="sr-only">Step 4 of 4: Review</legend>
                <div class="bk-step__head" data-anim>
                  <p class="bk-step__kicker">Step 4 of 4 · Review</p>
                  <h3 class="bk-step__title" tabindex="-1">Review &amp; <em>reserve</em></h3>
                </div>
                <div class="bk-review" data-review data-anim></div>
                <div class="bk-consent-wrap" data-anim>
                  <div class="bk-consent-row">
                    <label class="bk-consent">
                      <input type="checkbox" name="consent" class="bk-hide-input" aria-describedby="err-consent" />
                      <span class="bk-consent__box" aria-hidden="true"><Icon name="check" /></span>
                      <span class="bk-consent__text">I agree to the booking terms</span>
                    </label>
                    <button type="button" class="bk-consent__view" data-terms-open aria-haspopup="dialog">View terms</button>
                  </div>
                  <p class="bk-err" id="err-consent" data-err="consent"></p>
                </div>
                <p class="bk-assure" data-anim><Icon name="shield" /> Nothing is charged now. Your concierge confirms the full rate before you commit.</p>
              </fieldset>
            </div>

            <div class="bk-nav">
              <p class="bk-nav__journey" data-nav-journey aria-hidden="true" hidden><span class="bk-nav__journey-k">Your journey</span> <span data-nav-journey-text></span></p>
              <button type="button" class="btn btn--ghost bk-nav__back" data-back aria-label="Back to previous step"><Icon name="arrow-left" /> <span class="bk-nav__back-text">Back</span></button>
              <p class="bk-nav__hint" data-hint>Takes about a minute</p>
              <button type="submit" class="btn btn--gold bk-nav__next" data-next data-magnetic="0.2">
                <span class="bk-nav__label" data-next-label>Continue</span>
                <Icon name="arrow" />
                <span class="bk-spinner" aria-hidden="true"></span>
              </button>
            </div>
            <span class="bk-nav-sentinel" data-nav-sentinel aria-hidden="true"></span>
            <p class="bk-err bk-err--submit" data-err="submit" role="alert"></p>
            <p class="sr-only" aria-live="polite" data-announce></p>
          </form>

          <!-- ================= Success ================= -->
          <section class="bk-success card" data-success hidden tabindex="-1" aria-labelledby="bk-success-title">
            <div class="bk-success__mark" aria-hidden="true">
              <span class="bk-success__ring"></span>
              <svg viewBox="0 0 96 96" class="bk-success__svg">
                <defs>
                  <linearGradient id="bk-gold" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#e8d3a2" /><stop offset=".55" stop-color="#c9a86a" /><stop offset="1" stop-color="#8f7040" />
                  </linearGradient>
                </defs>
                <circle cx="48" cy="48" r="44" class="bk-success__circle" data-draw />
                <path d="M30 49.5 L42.5 62 L67 36" class="bk-success__path" data-draw />
              </svg>
            </div>
            <p class="eyebrow bk-success__ref" data-s-anim>Reference <span data-ref>SDD-000000</span></p>
            <h2 class="bk-success__title" id="bk-success-title" data-s-anim>Request <em>received</em></h2>
            <p class="lead bk-success__lead" data-s-anim>A concierge will confirm <span data-confirm-by>by text</span> within minutes.</p>
            <ol role="list" class="bk-next" data-s-anim aria-label="What happens next">
              <li class="bk-next__item">
                <span class="bk-next__n" aria-hidden="true">01</span>
                <span class="bk-next__t">Concierge review</span>
                <span class="bk-next__d">We check availability and prepare your full rate.</span>
              </li>
              <li class="bk-next__item">
                <span class="bk-next__n" aria-hidden="true">02</span>
                <span class="bk-next__t">Confirmation <span data-confirm-by-2>by text</span></span>
                <span class="bk-next__d">Your rate and reservation, within minutes. Nothing is charged now.</span>
              </li>
              <li class="bk-next__item">
                <span class="bk-next__n" aria-hidden="true">03</span>
                <span class="bk-next__t">Chauffeur details</span>
