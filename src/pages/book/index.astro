  .bk-wizard::before { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; padding: 1px; background: linear-gradient(160deg, rgb(var(--accent-2-rgb) / 0.28), transparent 30%, transparent 70%, rgb(var(--accent-2-rgb) / 0.12)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }

