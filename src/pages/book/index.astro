  .bk-type { position: relative; display: grid; align-content: start; gap: 0.9rem; min-height: 132px; padding: 1rem; border: 1px solid var(--line); border-radius: 16px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.006)); cursor: pointer; transition: border-color 0.4s var(--ease-out), background 0.4s var(--ease-out), transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out); -webkit-tap-highlight-color: transparent; }
