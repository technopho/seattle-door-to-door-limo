---
import Icon from '../Icon.astro';
import { areas, hub, landmarks, images } from '../../data/site';

const enc = encodeURIComponent;
const etaMin = (eta: string) => eta.match(/^\d+\s*min/)?.[0] ?? eta;
const routeHref = (to?: string) => `/book/?type=airport&from=${enc(hub.city)}${to ? `&to=${enc(to)}` : ''}`;

const landmarkMeta = [
  { icon: 'ship', tag: 'Cruise terminal', img: images.waterfront, alt: 'Seattle waterfront and downtown skyline at dusk', sub: '', href: `/book/?type=cruise&to=${enc('Pier 66, Bell Street Cruise Terminal')}` },
  { icon: 'ship', tag: 'Cruise terminal', img: images.skyline, alt: 'Seattle skyline with the Space Needle and Mount Rainier', sub: '', href: `/book/?type=cruise&to=${enc('Pier 91, Smith Cove Cruise Terminal')}` },
  { icon: 'pin', tag: 'Sightseeing', img: images.market, alt: 'Pike Place Public Market sign in downtown Seattle', sub: 'Space Needle · Pike Place', href: '/book/?type=hourly' },
  { icon: 'flag', tag: 'Events', img: images.darkCar, alt: 'Black luxury limousine for an evening event', pos: '100% 60%', sub: 'Lumen Field · T-Mobile Park', href: '/book/?type=events' },
];
const marks = landmarks.map((l, i) => {
  const [title, sub] = l.name.split(' — ');
  const meta = landmarkMeta[i];
  return { ...l, ...meta, title, sub: sub ?? meta.sub };
});
---
<section id="areas" class="section am" aria-labelledby="areas-title" data-am>
  <div class="am__glow" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head section-head--split am__head">
      <div class="am__title">
        <p class="eyebrow" data-reveal>Service Areas</p>
        <h2 id="areas-title" data-split>All of Puget Sound, <em data-reveal data-delay="0.3">door to door.</em></h2>
      </div>
      <p class="lead" data-reveal data-delay="0.1">
        From SeaTac to Everett, Bellevue to Tacoma, one standard of chauffeured service across the region. Flight-tracked arrivals, cruise terminal runs and point-to-point rides, wherever the day takes you.
      </p>
    </header>

    <div class="am__grid">
      <div class="am__panel">
        <div class="am__panel-head" data-reveal>
          <span class="label">Cities we serve</span>
          <span class="am__panel-meta">ETA from SeaTac</span>
        </div>
        <ol class="am__list" role="list" data-stagger="0.07">
          {areas.map((a, i) => (
            <li>
              <button type="button" class="am-city" data-am-city={i} aria-pressed="false">
                <span class="am-city__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="am-city__body">
                  <span class="am-city__name">{a.city}</span>
                  <span class="am-city__detail">{a.detail}</span>
                </span>
                <span class="am-city__eta"><b>{etaMin(a.eta)}</b></span>
              </button>
            </li>
          ))}
        </ol>

        <div class="am-route" data-reveal>
          <div class="am-route__info">
            <span class="label">Your route</span>
            <p class="am-route__path">
              <span>SeaTac</span>
              <svg class="am-route__line" viewBox="0 0 48 8" aria-hidden="true"><path d="M1 4h40" stroke-dasharray="2 3" /><path d="M40 1l4 3-4 3" /></svg>
              <span data-am-route-to>Anywhere</span>
            </p>
          </div>
          <a href={routeHref()} class="btn btn--gold am-route__btn" data-magnetic="0.2" data-am-route-link>
            Reserve this route <Icon name="arrow" />
          </a>
        </div>
      </div>

      <div class="am-stage" data-am-stage data-reveal="fade">
        <div class="am-stage__placeholder" aria-hidden="true"></div>
        <div class="am-stage__canvas" data-am-canvas role="img" aria-label={`Interactive map of our service area: routes from ${hub.city} to ${areas.map((a) => a.city).join(', ')}`}></div>
        <div class="am-stage__labels" aria-hidden="true">
          <div class="am-label am-label--hub" data-am-label="hub">
            <span class="am-label__stem"></span>
            <span class="am-label__inner"><span class="am-label__tag">Hub</span><span class="am-label__name">SeaTac</span></span>
          </div>
          {areas.map((a, i) => (
            <div class="am-label" data-am-label={i}>
              <span class="am-label__stem"></span>
              <span class="am-label__inner" data-am-label-hit={i} data-cursor="">
                <span class="am-label__name">{a.city}</span>
                <span class="am-label__eta">{etaMin(a.eta)}</span>
              </span>
            </div>
          ))}
        </div>

        <div class="am-hud am-hud--tl" aria-hidden="true">
          <span class="am-hud__chip" data-am-obstacle><i class="am-hud__dot"></i>Puget Sound coverage · 24/7</span>
        </div>
        <div class="am-hud am-hud--tr" aria-hidden="true">
          <span class="am-compass" data-am-obstacle>
            <span class="am-compass__needle" data-am-compass>
              <svg viewBox="0 0 24 24"><path d="M12 4.5l2.8 7.5H9.2z" fill="currentColor" /><path d="M12 19.5l-2.8-7.5h5.6z" fill="none" stroke="currentColor" stroke-width="1" /></svg>
              <b data-am-compass-n>N</b>
            </span>
          </span>
        </div>
        <div class="am-hud am-hud--bl" aria-hidden="true" data-am-obstacle>
          <span class="am-hud__coords">47.62° N &nbsp;/&nbsp; 122.28° W</span>
          <span class="am-hud__hint">Drag to explore · Hover a city</span>
        </div>
        <div class="am-hud am-hud--br" aria-hidden="true" data-am-obstacle>
          <span class="am-legend"><i class="am-legend__hub"></i>SeaTac hub</span>
          <span class="am-legend"><i class="am-legend__route"></i>Chauffeured routes</span>
        </div>

        <!-- Tablet / phone: the route result docks inside the map, where the tap happened. -->
        <div class="am-chip" data-am-chip data-am-obstacle>
          <div class="am-chip__info">
            <p class="am-chip__idle"><i class="am-hud__dot"></i>Pick a city to see its route</p>
            <p class="am-chip__route" aria-live="polite">
              <span>SeaTac</span>
              <svg class="am-route__line" viewBox="0 0 48 8" aria-hidden="true"><path d="M1 4h40" stroke-dasharray="2 3" /><path d="M40 1l4 3-4 3" /></svg>
              <b data-am-chip-to>Seattle</b>
              <small data-am-chip-eta>25 min</small>
            </p>
          </div>
          <a href={routeHref()} class="am-chip__go" data-am-chip-link tabindex="-1" aria-hidden="true">
            Reserve <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>

    <div class="am-marks">
      <div class="am-marks__head" data-reveal>
        <span class="label">Terminals, landmarks &amp; venues</span>
        <span class="am-marks__swipe" aria-hidden="true">Swipe <Icon name="arrow" /></span>
      </div>
      <div class="am-marks__grid" data-stagger="0.08">
        {marks.map((m) => (
          <a href={m.href} class="am-mark card">
            <span class="am-mark__media media media--shade" data-cursor="Book">
              <img src={m.img} alt={m.alt} loading="lazy" decoding="async" width="800" height="500" style={m.pos ? `object-position: ${m.pos}` : undefined} />
              <span class="am-mark__tag"><Icon name={m.icon} />{m.tag}</span>
            </span>
            <span class="am-mark__body">
              <span class="am-mark__title">{m.title}</span>
              <span class="am-mark__sub">{m.sub}</span>
              <span class="am-mark__text">{m.text}</span>
              <span class="am-mark__go">Book this trip <Icon name="arrow" /></span>
            </span>
          </a>
        ))}
      </div>
      <p class="am-custom" data-reveal>
        <span>Don’t see your destination? <em>We build custom routes.</em></span>
        <a href="/book/" class="link-underline">Plan a custom route <Icon name="arrow" /></a>
      </p>
    </div>
  </div>
</section>

<script>
  import { areas, hub } from '../../data/site';

  type MapHandle = { setActive(i: number | null, still?: boolean): void };
  type LenisLike = { scrollTo: (target: Element, opts?: Record<string, unknown>) => void };

  const root = document.querySelector<HTMLElement>('[data-am]');
  const stage = root?.querySelector<HTMLElement>('[data-am-stage]');
  if (root && stage) {
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compact = window.matchMedia('(max-width: 960px)');
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-am-city]'));
    const labelEls = Array.from(root.querySelectorAll<HTMLElement>('[data-am-label]'));
    const link = root.querySelector<HTMLAnchorElement>('[data-am-route-link]');
    const toEl = root.querySelector<HTMLElement>('[data-am-route-to]');
    const list = root.querySelector<HTMLElement>('.am__list');
    const chip = root.querySelector<HTMLElement>('[data-am-chip]');
    const chipTo = root.querySelector<HTMLElement>('[data-am-chip-to]');
    const chipEta = root.querySelector<HTMLElement>('[data-am-chip-eta]');
    const chipLink = root.querySelector<HTMLAnchorElement>('[data-am-chip-link]');
    let map: MapHandle | null = null;
    let pinned: number | null = null;
    let hovered: number | null = null;
    let still = false; // picked on the map itself: the camera should not move

    const routeHref = (to?: string) => `/book/?type=airport&from=${encodeURIComponent(hub.city)}${to ? `&to=${encodeURIComponent(to)}` : ''}`;
    const etaMin = (eta: string) => eta.match(/^\d+\s*min/)?.[0] ?? eta;

    function apply() {
      const a = hovered ?? pinned;
      items.forEach((btn, i) => {
        btn.classList.toggle('is-active', a === i);
        btn.classList.toggle('is-dim', a !== null && a !== i);
        btn.setAttribute('aria-pressed', String(pinned === i));
      });
      labelEls.forEach((el) => {
        const key = el.dataset.amLabel;
        if (key === 'hub') return;
        const i = Number(key);
        el.classList.toggle('is-active', a === i);
        el.classList.toggle('is-dim', a !== null && a !== i);
      });
      const city = a === null ? null : areas[a].city;
      const label = city ? `Reserve a ride from SeaTac to ${city}` : 'Reserve a ride from SeaTac';
      if (toEl) toEl.textContent = city ?? 'Anywhere';
      if (link) {
        link.href = routeHref(city ?? undefined);
        link.setAttribute('aria-label', label);
      }
      if (chip) {
        chip.classList.toggle('is-on', a !== null);
        if (a !== null) {
          if (chipTo) chipTo.textContent = areas[a].city;
          if (chipEta) chipEta.textContent = etaMin(areas[a].eta);
        }
        if (chipLink) {
          chipLink.href = routeHref(city ?? undefined);
          chipLink.tabIndex = a === null ? -1 : 0;
          chipLink.setAttribute('aria-hidden', String(a === null));
          chipLink.setAttribute('aria-label', label);
        }
      }
      root!.classList.toggle('has-active', a !== null);
      map?.setActive(a, still);
    }

    // Tablet / phone: the list sits below the map, so bring the map back into view to show the route.
    function revealStage() {
      if (!compact.matches) return;
      const r = stage!.getBoundingClientRect();
      const visible = Math.min(r.bottom, window.innerHeight - 80) - Math.max(r.top, 80);
      if (visible > r.height * 0.6) return;
      const lenis = (window as unknown as { lenis?: LenisLike }).lenis;
      if (lenis && !reduced) lenis.scrollTo(stage!, { duration: 1.3, easing: (t: number) => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t)) });
      else stage!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    }

    items.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        still = false;
        pinned = pinned === i ? null : i;
        if (!fine) hovered = null;
        apply();
        if (pinned === i) revealStage();
      });
      btn.addEventListener('focus', () => { still = false; hovered = i; apply(); });
      btn.addEventListener('blur', () => { hovered = null; apply(); });
      if (fine) btn.addEventListener('mouseenter', () => { still = false; hovered = i; apply(); });
    });
    if (fine) list?.addEventListener('mouseleave', () => { hovered = null; apply(); });

    // Labels on the map are hover/tap targets too.
    root.querySelectorAll<HTMLElement>('[data-am-label-hit]').forEach((el) => {
      const i = Number(el.dataset.amLabelHit);
      if (fine) {
        el.addEventListener('mouseenter', () => { still = true; hovered = i; apply(); });
        el.addEventListener('mouseleave', () => { hovered = null; apply(); });
      }
      el.addEventListener('click', () => { still = true; pinned = pinned === i ? null : i; apply(); });
    });

    // Lazy-load three.js + the scene shortly before the map scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../scripts/area-map')
          .then((m) => {
            map = m.createAreaMap(stage);
            apply();
          })
          .catch(() => {
            stage.classList.add('is-fallback-failed');
          });
      },
      { rootMargin: '700px 0px' },
    );
    io.observe(stage);
  }
</script>

<style>
  .am { overflow: hidden; }
  .am__glow {
    position: absolute;
    inset: 10% -20% auto;
    height: 70%;
    background: radial-gradient(50% 50% at 60% 50%, rgba(201, 168, 106, 0.07), transparent 70%);
    pointer-events: none;
  }
  .am__head { margin-bottom: clamp(2.25rem, 5vw, 4rem); }
  .am__head .lead { justify-self: end; }
  /* Line break via CSS: a <br> inside data-split headlines breaks the shared word splitter. */
  .am__title h2 em { display: block; width: fit-content; }

  /* ---------- Grid ---------- */
  .am__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.54fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: stretch;
  }

  /* ---------- Panel ---------- */
  .am__panel { display: flex; flex-direction: column; min-width: 0; }
  .am__panel-head { display: flex; justify-content: space-between; align-items: baseline; padding: 0 0.25rem 0.9rem; }
  .am__panel-meta { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .am__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .am__list li { border-bottom: 1px solid var(--line); }

  .am-city {
    position: relative;
    width: 100%;
    min-height: 64px;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0.75rem 1rem 0.25rem;
    text-align: left;
    border-radius: 2px;
    transition: background 0.6s var(--ease-out), opacity 0.5s var(--ease-out);
  }
  .am-city::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--gold-grad);
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform 0.6s var(--ease-out);
  }
  .am-city.is-active { background: linear-gradient(90deg, rgba(201, 168, 106, 0.09), rgba(201, 168, 106, 0) 75%); }
  .am-city.is-active::before { transform: scaleY(1); }
  .am-city.is-dim { opacity: 0.5; }
  .am-city:focus-visible { outline-offset: -2px; }
  .am-city__num { padding-left: 0.75rem; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; color: var(--muted); transition: color 0.4s; }
  .am-city.is-active .am-city__num { color: var(--gold); }
  .am-city__body { display: grid; gap: 0.2rem; min-width: 0; }
  .am-city__name { font-family: var(--font-display); font-size: clamp(1.4rem, 1.75vw, 1.7rem); line-height: 1.08; color: var(--ivory); transition: transform 0.6s var(--ease-out); }
  .am-city.is-active .am-city__name { transform: translateX(4px); }
  .am-city__detail { font-size: 0.78rem; line-height: 1.45; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .am-city__eta { text-align: right; white-space: nowrap; }
  .am-city__eta b { font-weight: 600; font-size: 0.95rem; color: var(--gold-2); letter-spacing: 0.02em; }

  .am-route {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    padding: 1.15rem 1.15rem 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01));
  }
  .am__list { margin-bottom: 1.5rem; }
  .am-route__info { display: grid; gap: 0.35rem; min-width: 0; }
  .am-route__path { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 1.35rem; line-height: 1.1; color: var(--ivory); min-width: 0; }
  .am-route__path span:last-child { color: var(--gold-2); font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .am-route__line { width: 34px; height: 8px; flex: none; fill: none; stroke: var(--gold); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .am-route__btn { width: 100%; }

  /* ---------- Stage ---------- */
  .am-stage {
    position: relative;
    min-height: max(600px, min(78vh, 760px));
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
    scroll-margin-top: 88px;
    background:
      radial-gradient(70% 60% at 55% 48%, rgba(201, 168, 106, 0.06), transparent 70%),
      radial-gradient(120% 100% at 50% 40%, #131317 0%, #0d0d10 55%, #0a0a0c 100%);
  }
  .am-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(125% 95% at 50% 42%, rgba(10, 10, 12, 0) 52%, rgba(10, 10, 12, 0.8) 100%),
      linear-gradient(to top, rgba(10, 10, 12, 0.94) 0, rgba(10, 10, 12, 0.55) 70px, rgba(10, 10, 12, 0) 150px),
      linear-gradient(to bottom, rgba(10, 10, 12, 0.7) 0, rgba(10, 10, 12, 0) 110px);
  }
  .am-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(243, 238, 228, 0.03);
  }
  .am-stage__placeholder {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(243, 238, 228, 0.12) 1px, transparent 1.4px);
    background-size: 14px 14px;
    -webkit-mask-image: radial-gradient(55% 55% at 50% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(55% 55% at 50% 50%, #000 0%, transparent 100%);
    transition: opacity 1.2s var(--ease-out);
  }
  .am-stage.is-live .am-stage__placeholder,
  .am-stage.is-fallback .am-stage__placeholder { opacity: 0; }
  .am-stage__canvas { position: absolute; inset: 0; z-index: 1; }
  .am-stage__canvas :global(canvas) { width: 100%; height: 100%; display: block; touch-action: pan-y; }
  @media (hover: hover) and (pointer: fine) {
    .am-stage__canvas :global(canvas) { cursor: grab; }
    .am-stage.is-dragging .am-stage__canvas :global(canvas) { cursor: grabbing; }
  }

  /* Labels projected from 3D (positions + leader lines are set every frame in area-map.ts) */
  .am-stage__labels { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .am-stage.is-fallback .am-stage__labels { display: none; }
  .am-label { position: absolute; left: 0; top: 0; opacity: 0; will-change: transform; }
  .am-label__stem {
    position: absolute;
    left: 0;
    top: -0.5px;
    width: 1px;
    height: 1px;
    background: rgba(232, 211, 162, 0.5);
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: opacity 0.5s var(--ease-out);
  }
  .am-label__inner {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.36rem 0.7rem 0.38rem;
    border-radius: 999px;
    background: rgba(12, 12, 15, 0.82);
    border: 1px solid rgba(243, 238, 228, 0.14);
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.8);
    white-space: nowrap;
    pointer-events: auto;
    cursor: pointer;
    transition: opacity 0.5s var(--ease-out), border-color 0.4s, background 0.4s, box-shadow 0.4s;
  }
  .am-label__name { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em; color: var(--ivory); line-height: 1; }
  .am-label__eta { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em; color: var(--gold-2); line-height: 1; padding-left: 0.5rem; border-left: 1px solid var(--line-strong); }
  .am-label__tag { font-size: 0.56rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #17130b; background: var(--gold-grad); padding: 0.22rem 0.42rem; border-radius: 999px; line-height: 1; }
  .am-label--hub .am-label__inner { cursor: default; padding-left: 0.32rem; border-color: rgba(201, 168, 106, 0.45); }
  .am-label.is-active .am-label__inner { border-color: var(--gold); background: rgba(24, 20, 12, 0.94); box-shadow: 0 0 0 4px rgba(201, 168, 106, 0.12), 0 10px 30px -10px rgba(0, 0, 0, 0.9); }
  .am-label.is-dim .am-label__inner, .am-label.is-dim .am-label__stem { opacity: 0.3; }
  @media (pointer: coarse) {
    /* Pills are ~24px tall: grow the tap target without growing the pill. */
    .am-label__inner::before { content: ''; position: absolute; inset: -10px -6px; }
  }

  /* HUD */
  .am-hud { position: absolute; z-index: 4; display: flex; gap: 0.6rem; pointer-events: none; }
  .am-hud--tl { top: 1.25rem; left: 1.25rem; }
  .am-hud--tr { top: 1.1rem; right: 1.1rem; }
  .am-hud--bl { bottom: 1.25rem; left: 1.4rem; flex-direction: column; gap: 0.3rem; }
  .am-hud--br { bottom: 1.25rem; right: 1.4rem; flex-direction: column; align-items: flex-end; gap: 0.45rem; }
  .am-hud__chip { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0.85rem; border-radius: 999px; border: 1px solid var(--line); background: rgba(10, 10, 12, 0.6); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ivory-2); }
