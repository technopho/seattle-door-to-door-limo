---
// Service-area map (3D stage + city list + landmarks). Self-contained: can be embedded on any page.
import Icon from '../Icon.astro';
import { areas, hub, landmarks, images, areaHref } from '../../data/site';

// Slots: "title" (h2 content) and "lead" (intro paragraph) override the home-page copy.
interface Props {
  /** Section id (anchor). */
  id?: string;
  /** Eyebrow above the heading. */
  eyebrow?: string;
  /** "View all service areas" link under the city list. */
  allLink?: boolean;
  /** Terminals / landmarks cards and the custom-route line under the map. */
  marks?: boolean;
}
const { id = 'areas', eyebrow = 'Service Areas', allLink = true, marks: showMarks = true } = Astro.props;
// Never link a page to itself.
const allHref = '/service-areas/';
const showAll = allLink && Astro.url.pathname.replace(/\/?$/, '/') !== allHref;
const titleId = `${id}-title`;

const enc = encodeURIComponent;
const etaMin = (eta: string) => eta.match(/^\d+\s*min/)?.[0] ?? eta;
const routeHref = (to?: string) => `/book/?type=airport&from=${enc(hub.city)}${to ? `&to=${enc(to)}` : ''}`;

const landmarkMeta = [
  { icon: 'ship', tag: 'Cruise terminal', img: images.waterfront, alt: 'Seattle waterfront and downtown skyline at dusk', sub: '', href: `/book/?type=cruise&to=${enc('Pier 66, Bell Street Cruise Terminal')}` },
  { icon: 'ship', tag: 'Cruise terminal', img: images.skyline, alt: 'Seattle skyline with the Space Needle and Mount Rainier', sub: '', href: `/book/?type=cruise&to=${enc('Pier 91, Smith Cove Cruise Terminal')}` },
  { icon: 'pin', tag: 'Sightseeing', img: images.market, alt: 'Pike Place Public Market sign in downtown Seattle', sub: 'Space Needle · Pike Place', href: '/book/?type=hourly' },
  { icon: 'flag', tag: 'Events', img: images.darkCar, alt: 'Black luxury limousine for an evening event', pos: '100% 60%', sub: 'Lumen Field · T-Mobile Park', href: '/book/?type=events' },
];
const marks = landmarks.map((l, i) => {
  const [title, sub] = l.name.split(' — ');
  const meta = landmarkMeta[i];
  return { ...l, ...meta, title, sub: sub ?? meta.sub };
});
---
<section id={id} class="section am" aria-labelledby={titleId} data-am>
  <div class="am__glow" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head section-head--split am__head">
      <div class="am__title">
        {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
        <h2 id={titleId} data-split><slot name="title">All of Puget Sound, <em data-reveal data-delay="0.3">door to door.</em></slot></h2>
      </div>
      <p class="lead" data-reveal data-delay="0.1">
        <slot name="lead">From SeaTac to Everett, Bellevue to Tacoma, one standard of chauffeured service across the region. Flight-tracked arrivals, cruise terminal runs and point-to-point rides, wherever the day takes you.</slot>
      </p>
    </header>

    <div class="am__grid">
      <div class="am__panel">
        <div class="am__panel-head" data-reveal>
          <span class="label">Cities we serve</span>
          <span class="am__panel-meta">ETA from SeaTac</span>
        </div>
        <ol class="am__list" role="list" data-stagger="0.07">
          {areas.map((a, i) => (
            <li>
              <a href={areaHref(a)} class="am-city" data-am-city={i}>
                <span class="am-city__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="am-city__body">
                  <span class="am-city__name">{a.city}</span>
                  <span class="am-city__detail"><span class="am-city__hoods">{a.detail.split(' · ').map((n) => <span>{n}</span>)}</span></span>
                </span>
                <span class="am-city__eta"><b>{etaMin(a.eta)}</b><span class="sr-only"> from SeaTac</span></span>
                <span class="am-city__go" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            </li>
          ))}
        </ol>

        {showAll && (
          <a href={allHref} class="link-underline am__all" data-reveal>
            View all service areas <Icon name="arrow" />
          </a>
        )}

        <div class="am-route" data-reveal>
          <div class="am-route__info">
            <span class="label">Your route</span>
            <p class="am-route__path">
              <span>SeaTac</span>
              <svg class="am-route__line" viewBox="0 0 48 8" aria-hidden="true"><path d="M1 4h40" stroke-dasharray="2 3" /><path d="M40 1l4 3-4 3" /></svg>
              <span class="am-route__to" data-am-route-to>Anywhere</span>
              <button type="button" class="am-route__clear" data-am-route-clear aria-label="Clear destination" hidden>
                <Icon name="close" />
              </button>
            </p>
          </div>
          <a href={routeHref()} class="btn btn--gold am-route__btn" data-magnetic="0.2" data-am-route-link>
            Reserve this route <Icon name="arrow" />
          </a>
        </div>
      </div>

      <div class="am-stage" data-am-stage data-theme="dark" data-reveal="fade">
        <div class="am-stage__placeholder" aria-hidden="true"></div>
        <div class="am-stage__canvas" data-am-canvas role="img" aria-label={`Interactive map of our service area: routes from ${hub.city} to ${areas.map((a) => a.city).join(', ')}`}></div>
        <!-- Pointer shortcuts only: the city list above carries the same links for keyboard and screen readers. -->
        <div class="am-stage__labels" aria-hidden="true">
          <div class="am-label am-label--hub" data-am-label="hub">
            <span class="am-label__stem"></span>
            <span class="am-label__inner"><span class="am-label__tag">Hub</span><span class="am-label__name">SeaTac</span></span>
          </div>
          {areas.map((a, i) => (
            <div class="am-label" data-am-label={i}>
              <span class="am-label__stem"></span>
              <a href={areaHref(a)} class="am-label__inner" data-am-label-hit={i} data-cursor="" tabindex="-1">
                <span class="am-label__name">{a.city}</span>
                <span class="am-label__eta">{etaMin(a.eta)}</span>
              </a>
            </div>
          ))}
        </div>

        <div class="am-hud am-hud--tl" aria-hidden="true">
          <span class="am-hud__chip" data-am-obstacle><i class="am-hud__dot"></i>Puget Sound coverage · 24/7</span>
        </div>
        <div class="am-hud am-hud--tr" aria-hidden="true">
          <span class="am-compass" data-am-obstacle>
            <span class="am-compass__needle" data-am-compass>
              <svg viewBox="0 0 24 24"><path d="M12 4.5l2.8 7.5H9.2z" fill="currentColor" /><path d="M12 19.5l-2.8-7.5h5.6z" fill="none" stroke="currentColor" stroke-width="1" /></svg>
              <b data-am-compass-n>N</b>
            </span>
          </span>
        </div>
        <div class="am-hud am-hud--bl" aria-hidden="true" data-am-obstacle>
          <span class="am-hud__coords">47.62° N &nbsp;/&nbsp; 122.28° W</span>
          <span class="am-hud__hint">Drag to explore · Hover a city</span>
        </div>
        <div class="am-hud am-hud--br" aria-hidden="true" data-am-obstacle>
          <span class="am-legend"><i class="am-legend__hub"></i>SeaTac hub</span>
          <span class="am-legend"><i class="am-legend__route"></i>Chauffeured routes</span>
        </div>

        <!-- Tablet / phone: the route result docks inside the map, where the tap happened.
             Tap a city once to preview its route, again (or tap the route) for its area page. -->
        <div class="am-chip" data-am-chip data-am-obstacle>
          <div class="am-chip__info">
            <p class="am-chip__idle"><i class="am-hud__dot"></i><span class="am-chip__copy am-chip__copy--touch">Tap a city on the map to preview its route</span><span class="am-chip__copy am-chip__copy--hover">Hover a city on the map to preview its route</span></p>
            <!-- Named by its visible text (WCAG 2.5.3); the sr-only parts only add spacing and purpose. -->
            <a href={areaHref(areas[0])} class="am-chip__route" data-am-chip-area tabindex="-1" aria-hidden="true">
              <span>SeaTac</span>
              <svg class="am-route__line" viewBox="0 0 48 8" aria-hidden="true"><path d="M1 4h40" stroke-dasharray="2 3" /><path d="M40 1l4 3-4 3" /></svg>
              <span class="sr-only"> to </span>
              <b data-am-chip-to>{areas[0].city}</b>
              <span class="sr-only">, </span>
              <small data-am-chip-eta>{etaMin(areas[0].eta)}</small>
              <span class="sr-only">: service area page</span>
            </a>
          </div>
          <a href={routeHref()} class="am-chip__go" data-am-chip-link tabindex="-1" aria-hidden="true">
            Reserve <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>

    {showMarks && <div class="am-marks">
      <div class="am-marks__head" data-reveal>
        <span class="label">Terminals, landmarks &amp; venues</span>
        <span class="am-marks__swipe" aria-hidden="true">Swipe <Icon name="arrow" /></span>
      </div>
      <div class="am-marks__grid" data-stagger="0.08" data-am-marks>
        {marks.map((m) => (
          <a href={m.href} class="am-mark card">
            <span class="am-mark__media media media--shade" data-cursor="Book">
              <img src={m.img} alt={m.alt} loading="lazy" decoding="async" width="800" height="500" style={m.pos ? `object-position: ${m.pos}` : undefined} />
              <span class="am-mark__tag"><Icon name={m.icon} />{m.tag}</span>
            </span>
            <span class="am-mark__body">
              <span class="am-mark__title">{m.title}</span>
              <span class="am-mark__sub">{m.sub}</span>
              <span class="am-mark__text">{m.text}</span>
              <span class="am-mark__go">Book this trip <Icon name="arrow" /></span>
            </span>
          </a>
        ))}
      </div>
      <p class="am-custom" data-reveal>
        <span>Don’t see your destination? <em>We build custom routes.</em></span>
        <a href="/book/" class="link-underline">Plan a custom route <Icon name="arrow" /></a>
      </p>
    </div>}
  </div>
</section>

<script>
  import { areas, hub, areaHref } from '../../data/site';

  type MapHandle = { setActive(i: number | null, still?: boolean): void };

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const routeHref = (to?: string) => `/book/?type=airport&from=${encodeURIComponent(hub.city)}${to ? `&to=${encodeURIComponent(to)}` : ''}`;
  const etaMin = (eta: string) => eta.match(/^\d+\s*min/)?.[0] ?? eta;
  // A hover has to rest this long before the route card remembers the city.
  const DWELL = 400;

  // Last real pointer position: content scrolling (or swaying) under a resting pointer is not a hover.
  let px = NaN;
  let py = NaN;
  const moved = (e: PointerEvent) => e.pointerType !== 'touch' && (e.clientX !== px || e.clientY !== py);
  document.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; }, { passive: true });

  document.querySelectorAll<HTMLElement>('[data-am]').forEach(initAreas);

  function initAreas(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-am-stage]');
    if (!stage) return;
    const items = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-am-city]'));
    const labelEls = Array.from(root.querySelectorAll<HTMLElement>('[data-am-label]'));
    const link = root.querySelector<HTMLAnchorElement>('[data-am-route-link]');
    const toEl = root.querySelector<HTMLElement>('[data-am-route-to]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-am-route-clear]');
    const list = root.querySelector<HTMLElement>('.am__list');
    const chip = root.querySelector<HTMLElement>('[data-am-chip]');
    const chipTo = root.querySelector<HTMLElement>('[data-am-chip-to]');
    const chipEta = root.querySelector<HTMLElement>('[data-am-chip-eta]');
    const chipLink = root.querySelector<HTMLAnchorElement>('[data-am-chip-link]');
    const chipArea = root.querySelector<HTMLAnchorElement>('[data-am-chip-area]');
    let map: MapHandle | null = null;
    // pinned: the remembered choice, shown by the route card (and the phone chip). On touch it is
    //   also what the map shows, because it was tapped on the map on purpose.
    // hovered: the live preview while a pointer rests on / keyboard focus is on a city. With a mouse
    //   the map only follows this, so leaving the list or the labels returns it to the overview.
    let pinned: number | null = null;
    let hovered: number | null = null;
    let still = false; // picked on the map itself: the camera (and that label) must not move
    let dwell = 0;
    let escBound = false;

    // label null: the link is named by its own (visible + sr-only) content, so no aria-label override.
    const setLink = (el: HTMLAnchorElement | null, href: string | null, label: string | null, on: boolean) => {
      if (!el) return;
      if (href) el.setAttribute('href', href);
      el.tabIndex = on ? 0 : -1;
      el.setAttribute('aria-hidden', String(!on));
      if (label === null) el.removeAttribute('aria-label');
      else el.setAttribute('aria-label', label);
    };

    function apply() {
      const card = hovered ?? pinned;
      const onMap = hovered ?? (fine ? null : pinned);
      items.forEach((el, i) => {
        el.classList.toggle('is-active', onMap === i);
        // Rows only dim while the list is being explored.
        el.classList.toggle('is-dim', hovered !== null && hovered !== i);
      });
      labelEls.forEach((el) => {
        const key = el.dataset.amLabel;
        if (key === 'hub') return;
        const i = Number(key);
        el.classList.toggle('is-active', onMap === i);
        el.classList.toggle('is-dim', onMap !== null && onMap !== i);
      });
      const area = card === null ? null : areas[card];
      const label = area ? `Reserve a ride from SeaTac to ${area.city}` : 'Reserve a ride from SeaTac';
      if (toEl) toEl.textContent = area?.city ?? 'Anywhere';
      if (clearBtn) {
        clearBtn.hidden = !area;
        if (area) clearBtn.setAttribute('aria-label', `Clear destination: ${area.city}`);
      }
      if (link) {
        link.href = routeHref(area?.city);
        // The accessible name starts with the visible text ("Reserve this route"), per WCAG 2.5.3
        link.setAttribute('aria-label', area ? `Reserve this route: SeaTac to ${area.city}` : 'Reserve this route from SeaTac');
      }
      if (chip) {
        chip.classList.toggle('is-on', !!area);
        if (area) {
          if (chipTo) chipTo.textContent = area.city;
          if (chipEta) chipEta.textContent = etaMin(area.eta);
        }
        setLink(chipLink, routeHref(area?.city), label, !!area);
        setLink(chipArea, area ? areaHref(area) : null, null, !!area);
      }
      root.classList.toggle('has-active', !!area);
      // Escape clears the choice wherever focus is (a mouse user's focus is usually on <body>).
      if (!!area !== escBound) {
        escBound = !!area;
        if (escBound) document.addEventListener('keydown', onEsc);
        else document.removeEventListener('keydown', onEsc);
      }
      map?.setActive(onMap, still);
    }

    function clear() {
      window.clearTimeout(dwell);
      pinned = null;
      hovered = null;
      still = true; // returning to the overview: no camera lean
      apply();
    }
    function onEsc(e: KeyboardEvent) {
      if (e.key === 'Escape') clear();
    }

    function preview(i: number, fromMap: boolean) {
      if (hovered === i && still === fromMap) return;
      still = fromMap;
      hovered = i;
      apply();
      window.clearTimeout(dwell);
      dwell = window.setTimeout(() => {
        if (hovered !== i || pinned === i) return;
        pinned = i;
        apply();
      }, DWELL);
    }
    function endPreview() {
      window.clearTimeout(dwell);
      if (hovered === null) return;
      hovered = null;
      apply();
    }

    // City rows are links to the area pages; hover / focus previews the route on the map.
    items.forEach((el, i) => {
      if (fine) el.addEventListener('pointermove', (e) => { if (moved(e)) preview(i, false); });
      el.addEventListener('focus', () => {
        // Keyboard focus is deliberate: remember it right away. (A mouse press also focuses the
        // link; that one must not hold the preview after the pointer has left.)
        if (!el.matches(':focus-visible')) return;
        window.clearTimeout(dwell);
        still = false;
        hovered = i;
        pinned = i;
        apply();
      });
      el.addEventListener('blur', () => {
        if (hovered !== i) return;
        hovered = null;
        apply();
      });
    });
    if (fine) list?.addEventListener('mouseleave', endPreview);

    // Map labels: hover previews and click opens the area page (mouse); on touch the first tap
    // previews the route (route chip) and a second tap on the same city opens its page.
    root.querySelectorAll<HTMLAnchorElement>('[data-am-label-hit]').forEach((el) => {
      const i = Number(el.dataset.amLabelHit);
      // The labels live in an aria-hidden layer (the city list and route card are the accessible
      // path), so a press must not move focus onto them; the click itself still fires.
      el.addEventListener('mousedown', (e) => e.preventDefault());
      if (fine) {
        el.addEventListener('pointermove', (e) => { if (moved(e)) preview(i, true); });
        el.addEventListener('mouseleave', endPreview);
        return;
      }
      el.addEventListener('click', (e) => {
        // Without the live map (fallback) there is nothing to preview: open the page.
        if (pinned === i || !map) return;
        e.preventDefault();
        still = true;
        hovered = null;
        pinned = i;
        apply();
      });
    });

    // A click or tap on the open map (not a drag, not a label or the chip) clears the choice.
    let down: [number, number] | null = null;
    stage.addEventListener('pointerdown', (e) => { down = [e.clientX, e.clientY]; });
    stage.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a, button, [data-am-chip]')) return;
      if (down && Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 6) return;
      if (pinned !== null || hovered !== null) clear();
    });

    clearBtn?.addEventListener('click', () => {
      clear();
      link?.focus({ preventScroll: true }); // the button hides itself: keep focus in the card
    });

    // Lazy-load three.js + the scene shortly before the map scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../scripts/area-map')
          .then((m) => {
            map = m.createAreaMap(stage);
            apply();
          })
          .catch(() => {
            // Chunk failed to load (stale deploy, flaky network): static route board instead.
            stage.classList.add('is-fallback-failed');
          });
      },
      { rootMargin: '700px 0px' },
    );
    io.observe(stage);
  }

  // Phones: the landmark cards sit in a horizontal scroll-snap strip. Chrome does not scroll a partly
  // visible focus target into view, so a Tab into the next card would leave it mostly off-screen.
  // Bring the focused card fully into the strip, aligned to its snap point (same as CityVehicles).
  document.querySelectorAll<HTMLElement>('[data-am-marks]').forEach((strip) => {
    strip.addEventListener('focusin', (e) => {
      if (strip.scrollWidth <= strip.clientWidth + 1) return; // desktop grid: nothing to scroll
      const card = (e.target as HTMLElement).closest<HTMLElement>('.am-mark');
      if (!card) return;
      const s = strip.getBoundingClientRect();
      const c = card.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(strip).scrollPaddingInlineStart) || 0;
      if (c.left >= s.left + pad - 1 && c.right <= s.right + 1) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      strip.scrollTo({ left: strip.scrollLeft + (c.left - s.left - pad), behavior: reduce ? 'auto' : 'smooth' });
    });
  });
</script>

<style>
  .am {
    overflow: hidden;
    /* Declared in the page theme, then inherited (already resolved) into the always-dark stage:
       the stage reads as a dark navigation screen set into the page, with a neutral hairline bezel.
       (Accent rings are reserved for focus / interactive states.) */
    --am-frame: 0 40px 90px -50px rgb(0 0 0 / 0.9);
    --am-bezel: rgb(var(--fg-rgb) / 0.07);
  }
  :global([data-theme='light']) .am {
    --am-frame:
      0 0 0 1px rgb(var(--fg-rgb) / 0.07),
      0 2px 4px -2px rgb(var(--fg-rgb) / 0.12),
      0 28px 56px -30px rgb(var(--fg-rgb) / 0.42),
      0 70px 120px -60px rgb(var(--fg-rgb) / 0.28);
    --am-bezel: rgb(var(--fg-rgb) / 0.09);
  }
  .am__glow {
    position: absolute;
    inset: 10% -20% auto;
    height: 70%;
    background: radial-gradient(50% 50% at 60% 50%, rgb(var(--accent-rgb) / 0.07), transparent 70%);
    pointer-events: none;
  }
  .am__head { margin-bottom: clamp(2.25rem, 5vw, 4rem); }
  .am__head .lead { justify-self: end; }
  /* Line break via CSS: a <br> inside data-split headlines breaks the shared word splitter. */
  .am__title h2 em { display: block; width: fit-content; }

  /* ---------- Grid ---------- */
  .am__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: stretch;
  }

  /* ---------- Panel ---------- */
  .am__panel { display: flex; flex-direction: column; min-width: 0; }
  .am__panel-head { display: flex; justify-content: space-between; align-items: baseline; padding: 0 0.25rem 0.9rem; }
  .am__panel-meta { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .am__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .am__list li { border-bottom: 1px solid var(--line); }

  .am-city {
    position: relative;
    width: 100%;
    min-height: 64px;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto 1rem;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0.6rem 1rem 0.25rem;
    text-align: left;
    color: inherit;
    border-radius: var(--radius-s);
    overflow: hidden; /* the accent bar follows the rounded corners */
    transition: background 0.6s var(--ease-out), opacity 0.5s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .am-city::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent-grad);
    transform: scaleY(0);
    transform-origin: 50% 0;
    transition: transform 0.6s var(--ease-out);
  }
  .am-city.is-active { background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.09), rgb(var(--accent-rgb) / 0) 75%); }
  .am-city.is-active::before { transform: scaleY(1); }
  .am-city.is-dim { opacity: 0.5; }
  /* Inset ring: follows the row's radius and keeps the accent bar + wash visible. */
  .am-city:focus-visible { outline: none; box-shadow: inset 0 0 0 1.5px var(--accent); }
  .am-city__num { padding-left: 0.75rem; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; color: var(--muted); transition: color 0.4s; }
  .am-city.is-active .am-city__num { color: var(--accent); }
  .am-city__body { display: grid; gap: 0.2rem; min-width: 0; }
  .am-city__name { font-family: var(--font-display); font-size: clamp(1.2rem, 1.45vw, 1.42rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; color: var(--text); transition: transform 0.6s var(--ease-out); }
  .am-city.is-active .am-city__name { transform: translateX(4px); }
  /* Neighbourhoods wrap only between names. Every name carries a leading 1em separator; the list is
     pulled 1em left inside a clipping box, so the separator that starts each line is clipped away. */
  .am-city__detail { display: block; overflow: hidden; font-size: 0.78rem; line-height: 1.45; color: var(--muted); }
  .am-city__hoods { display: block; margin-left: -1em; text-wrap: pretty; }
  .am-city__hoods > :global(span) { display: inline-block; white-space: nowrap; }
  .am-city__hoods > :global(span)::before { content: '·'; display: inline-block; width: 1em; text-align: center; color: var(--muted-2); }
  .am-city__eta { text-align: right; white-space: nowrap; }
  .am-city__eta b { font-weight: 600; font-size: 0.95rem; color: var(--accent-2); letter-spacing: 0.02em; }
  /* Link affordance: a quiet arrow that wakes up with the row. */
  .am-city__go { display: grid; place-items: center; width: 1rem; height: 1rem; margin-left: -0.3rem; color: var(--muted-2); transition: color 0.4s, transform 0.6s var(--ease-out); }
  .am-city__go :global(svg) { width: 15px; height: 15px; }
  .am-city.is-active .am-city__go { color: var(--accent); transform: translateX(3px); }

  .am__all { align-self: flex-start; min-height: 44px; margin: -0.75rem 0 1.25rem 0.25rem; }
  .am__all::after { bottom: calc(50% - 0.95em); }
  .am__all :global(svg) { width: 14px; height: 14px; transition: transform 0.5s var(--ease-out); }
  .am__all:hover :global(svg) { transform: translateX(3px); }

  .am-route {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    padding: 1.15rem 1.15rem 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(var(--fg-rgb) / 0.025);
  }
  :global([data-theme='light']) .am-route { background: var(--bg-3); box-shadow: 0 20px 50px -30px rgb(var(--fg-rgb) / 0.25); }
  .am__list { margin-bottom: 1.5rem; }
  .am-route__info { display: grid; gap: 0.35rem; min-width: 0; }
  .am-route__path { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; color: var(--text); min-width: 0; }
  .am-route__to { color: var(--accent-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Reset to "Anywhere": a quiet 28px disc, 44px hit area that doesn't grow the line. */
  .am-route__clear {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -2px 0 -2px -0.15rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s, background 0.3s;
  }
  .am-route__clear[hidden] { display: none; }
  .am-route__clear::before { content: ''; position: absolute; inset: -8px; border-radius: 50%; }
  .am-route__clear :global(svg) { width: 12px; height: 12px; }
  .am-route__clear:hover { color: var(--text); border-color: var(--line-strong); background: rgb(var(--fg-rgb) / 0.04); }
  .am-route__clear:focus-visible { outline-offset: 2px; }
  .am-route__line { width: 34px; height: 8px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .am-route__btn { width: 100%; }

  /* ---------- Stage ---------- */
  .am-stage {
    position: relative;
    min-height: max(600px, min(78vh, 760px));
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
    scroll-margin-top: 88px;
    box-shadow: var(--am-frame);
    outline: 1px solid var(--am-bezel);
    outline-offset: 6px;
    background:
      radial-gradient(70% 60% at 55% 48%, rgb(var(--accent-rgb) / 0.06), transparent 70%),
      radial-gradient(120% 100% at 50% 40%, var(--bg-2) 0%, var(--bg-2) 55%, var(--bg) 100%);
  }
  .am-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(125% 95% at 50% 42%, rgb(var(--bg-rgb) / 0) 52%, rgb(var(--bg-rgb) / 0.8) 100%),
      linear-gradient(to top, rgb(var(--bg-rgb) / 0.94) 0, rgb(var(--bg-rgb) / 0.55) 70px, rgb(var(--bg-rgb) / 0) 150px),
      linear-gradient(to bottom, rgb(var(--bg-rgb) / 0.7) 0, rgb(var(--bg-rgb) / 0) 110px);
  }
  .am-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    border-radius: inherit;
    /* Glass edge: a faint top highlight, like light catching a screen. */
    box-shadow: inset 0 1px 0 rgb(var(--fg-rgb) / 0.07), inset 0 0 0 1px rgb(var(--fg-rgb) / 0.03);
  }
  .am-stage__placeholder {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(var(--fg-rgb) / 0.12) 1px, transparent 1.4px);
    background-size: 14px 14px;
    -webkit-mask-image: radial-gradient(55% 55% at 50% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(55% 55% at 50% 50%, #000 0%, transparent 100%);
    transition: opacity 1.2s var(--ease-out);
  }
  .am-stage.is-live .am-stage__placeholder,
  .am-stage.is-fallback .am-stage__placeholder { opacity: 0; }
  .am-stage__canvas { position: absolute; inset: 0; z-index: 1; }
  .am-stage__canvas :global(canvas) { width: 100%; height: 100%; display: block; touch-action: pan-y; }
  @media (hover: hover) and (pointer: fine) {
    .am-stage__canvas :global(canvas) { cursor: grab; }
    .am-stage.is-dragging .am-stage__canvas :global(canvas) { cursor: grabbing; }
  }

  /* Labels projected from 3D (positions + leader lines are set every frame in area-map.ts) */
  .am-stage__labels { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .am-stage.is-fallback .am-stage__labels { display: none; }
  .am-label { position: absolute; left: 0; top: 0; opacity: 0; will-change: transform; }
  .am-label__stem {
    position: absolute;
    left: 0;
    top: -0.5px;
    width: 1px;
    height: 1px;
    background: rgb(var(--accent-2-rgb) / 0.5);
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: opacity 0.5s var(--ease-out);
  }
  .am-label__inner {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.36rem 0.7rem 0.38rem;
    border-radius: 999px;
    background: rgb(var(--bg-rgb) / 0.82);
    border: 1px solid rgb(var(--fg-rgb) / 0.14);
    box-shadow: 0 8px 24px -10px rgb(var(--bg-rgb) / 0.8);
    white-space: nowrap;
    color: var(--text);
    pointer-events: auto;
    cursor: pointer;
    transition: opacity 0.5s var(--ease-out), border-color 0.4s, background 0.4s, box-shadow 0.4s;
  }
  .am-label__name { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em; color: var(--text); line-height: 1; }
  .am-label__eta { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em; color: var(--accent-2); line-height: 1; padding-left: 0.5rem; border-left: 1px solid var(--line-strong); }
  .am-label__tag { font-size: 0.56rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--on-accent); background: var(--accent-grad); padding: 0.22rem 0.42rem; border-radius: 999px; line-height: 1; }
  .am-label--hub .am-label__inner { cursor: default; padding-left: 0.32rem; border-color: rgb(var(--accent-rgb) / 0.45); }
  /* Until the scene runs (and during the intro, set inline per label) pills are invisible: not targets. */
  .am-stage:not(.is-live) .am-label__inner { pointer-events: none; }
  .am-label.is-active { z-index: 2; }
  .am-label.is-active .am-label__inner { border-color: var(--accent); background: linear-gradient(rgb(var(--accent-rgb) / 0.1), rgb(var(--accent-rgb) / 0.1)), rgb(var(--bg-rgb) / 0.94); box-shadow: 0 0 0 4px rgb(var(--accent-rgb) / 0.12), 0 10px 30px -10px rgb(var(--bg-rgb) / 0.9); }
  /* Inactive while a city is in focus: a quieter, compact pill (name only) that keeps its solid base. */
  .am-label.is-dim .am-label__inner { opacity: 0.62; border-color: rgb(var(--fg-rgb) / 0.08); box-shadow: none; }
  .am-label.is-dim .am-label__name { color: var(--text-2); }
  .am-label.is-dim .am-label__eta { display: none; }
  .am-label.is-dim .am-label__stem { opacity: 0.35; }
  @media (pointer: coarse) {
    /* Pills are ~24px tall: grow the tap target without growing the pill. */
    .am-label__inner::before { content: ''; position: absolute; inset: -10px -6px; }
  }

  /* HUD */
  .am-hud { position: absolute; z-index: 4; display: flex; gap: 0.6rem; pointer-events: none; }
  .am-hud--tl { top: 1.25rem; left: 1.25rem; }
  .am-hud--tr { top: 1.1rem; right: 1.1rem; }
  .am-hud--bl { bottom: 1.25rem; left: 1.4rem; flex-direction: column; gap: 0.3rem; }
  .am-hud--br { bottom: 1.25rem; right: 1.4rem; flex-direction: column; align-items: flex-end; gap: 0.45rem; }
  .am-hud__chip { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.45rem 0.85rem; border-radius: 999px; border: 1px solid var(--line); background: rgb(var(--bg-rgb) / 0.6); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-2); }
  /* The ring is a ::after scaled with transform + opacity only (compositor), not an animated
     box-shadow, so the endless pulse costs no style recalc or repaint per frame. */
  .am-hud__dot { position: relative; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .am-hud__dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: rgb(var(--accent-rgb) / 0.55); opacity: 0; animation: am-pulse 2.4s var(--ease-out) 4; }
  @keyframes am-pulse { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(4); opacity: 0; } }
  .am-hud__coords { font-size: 0.66rem; letter-spacing: 0.22em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .am-stage.is-fallback .am-hud__hint, .am-stage.no-drag .am-hud__hint { display: none; }
  .am-hud__hint { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .am-compass { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: rgb(var(--bg-rgb) / 0.6); }
  .am-compass__needle { position: relative; display: grid; place-items: center; width: 100%; height: 100%; color: var(--accent); }
  .am-compass__needle svg { width: 20px; height: 20px; }
  .am-compass__needle b { position: absolute; top: 3px; left: 50%; width: 10px; margin-left: -5px; font-size: 0.5rem; font-weight: 700; line-height: 1; text-align: center; color: var(--text-2); }
  .am-legend { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .am-legend__hub { width: 9px; height: 9px; border-radius: 50%; background: var(--text); box-shadow: 0 0 0 3px rgb(var(--accent-rgb) / 0.3), 0 0 12px rgb(var(--accent-2-rgb) / 0.7); }
  .am-legend__route { width: 22px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.2), var(--accent-2)); }

  /* Route chip (tablet / phone only) */
  .am-chip { display: none; }
  .am-chip__info { flex: 1; display: grid; min-width: 0; }
  .am-chip__idle,
  .am-chip__route { grid-area: 1 / 1; margin: 0; display: flex; align-items: center; min-width: 0; transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out); }
  .am-chip__idle { gap: 0.6rem; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-2); white-space: nowrap; }
  .am-chip__route { min-height: 44px; margin-right: 7.5rem; gap: 0.5rem; font-family: var(--font-display); font-size: 1.1rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; color: var(--text); opacity: 0; transform: translateY(8px); white-space: nowrap; pointer-events: none; }
  .am-chip__route:focus-visible { outline-offset: 2px; border-radius: 999px; }
  .am-chip__route .am-route__line { width: 24px; }
  /* The city name doubles as the link to its area page. */
  .am-chip__route b { font-weight: 500; color: var(--accent-2); overflow: hidden; text-overflow: ellipsis; text-decoration: underline; text-decoration-color: rgb(var(--accent-rgb) / 0.45); text-decoration-thickness: 1px; text-underline-offset: 0.18em; padding-block: 0.12em 0.2em; }
  .am-chip__route small { flex: none; font-family: var(--font-sans); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.04em; color: var(--muted); padding-left: 0.5rem; border-left: 1px solid var(--line-strong); }
  .am-chip.is-on .am-chip__idle { opacity: 0; transform: translateY(-8px); }
  .am-chip.is-on .am-chip__route { opacity: 1; transform: none; pointer-events: auto; }
  .am-chip__go {
    position: absolute;
    top: 50%;
    right: 5px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1.05rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.55);
    background: rgb(var(--accent-rgb) / 0.08);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-2);
    opacity: 0;
    transform: translate(6px, -50%);
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out), background 0.4s;
  }
  .am-chip__go :global(svg) { width: 13px; height: 13px; }
  .am-chip.is-on .am-chip__go { opacity: 1; transform: translate(0, -50%); pointer-events: auto; }
  .am-chip__copy { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .am-chip__copy--hover { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .am-chip__copy--touch { display: none; }
    .am-chip__copy--hover { display: inline; }
  }
  /* Static maps: city links open their pages directly, so there is no preview to promise. */
  .am-stage.is-fallback .am-chip,
  .am-stage.is-fallback-failed .am-chip { display: none; }

  /* Scene failed to load: the pills become a static route board over the dot field. */
  .am-stage.is-fallback-failed .am-hud__hint,
  .am-stage.is-fallback-failed .am-hud--br,
  .am-stage.is-fallback-failed .am-label__stem { display: none; }
  .am-stage.is-fallback-failed .am-stage__labels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    gap: 0.75rem;
    margin: auto;
    max-width: 30rem;
    padding: 5rem 1.5rem;
  }
  .am-stage.is-fallback-failed .am-label { position: relative; opacity: 1; will-change: auto; }
  .am-stage.is-fallback-failed .am-label--hub { flex-basis: 100%; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .am-stage.is-fallback-failed .am-label--hub::after { content: ''; width: 1px; height: 2.25rem; background: linear-gradient(var(--accent), rgb(var(--accent-rgb) / 0)); }
  .am-stage.is-fallback-failed .am-label__inner { position: relative; pointer-events: auto; }
  .am-stage.is-fallback-failed .am-label:not(.am-label--hub) .am-label__inner { padding: 0.55rem 0.95rem; }
  .am-stage.is-fallback-failed .am-label__eta { display: block; }
  .am-stage.is-fallback-failed a.am-label__inner:hover { border-color: rgb(var(--accent-rgb) / 0.6); }

  /* SVG fallback (built in JS) */
  .am-stage :global(.am-fb) { width: 100%; height: 100%; padding: 3.5rem 1.5rem; }
  .am-stage :global(.am-fb__water) { fill: rgba(40, 70, 92, 0.28); stroke: rgb(var(--accent-rgb) / 0.35); stroke-width: 0.025; }
  .am-stage :global(.am-fb__arcs path) { fill: none; stroke: var(--accent); stroke-width: 0.035; stroke-linecap: round; opacity: 0.8; }
  .am-stage :global(.am-fb__city circle), .am-stage :global(.am-fb__hub circle) { fill: var(--accent-2); }
  .am-stage :global(.am-fb__hub circle) { fill: var(--text); }
  .am-stage :global(.am-fb .am-fb__halo) { fill: rgb(var(--accent-rgb) / 0.18); }
  .am-stage :global(.am-fb text) { fill: var(--text); font-family: var(--font-sans); font-size: 0.36px; font-weight: 600; letter-spacing: 0.02em; }
  .am-stage :global(.am-fb--narrow text) { font-size: 0.5px; }
  .am-stage :global(.am-fb a:hover text) { fill: var(--accent-2); }

  /* ---------- Landmarks ---------- */
  .am-marks { margin-top: clamp(3.5rem, 7vw, 5.5rem); }
  .am-marks__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
  .am-marks__swipe { display: none; align-items: center; gap: 0.4rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .am-marks__swipe :global(svg) { width: 12px; height: 12px; }
  @media (max-width: 600px) { .am-marks__swipe { display: inline-flex; } }
  .am-marks__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .am-mark {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    transition: border-color 0.5s var(--ease-out), transform 0.6s var(--ease-out), background 0.5s, box-shadow 0.6s var(--ease-out);
  }
  /* Ivory: raised paper cards with a soft shadow, clean (unshaded) photography. */
  :global([data-theme='light']) .am-mark { background: var(--bg-3); box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 20px 50px -34px rgb(var(--fg-rgb) / 0.3); }
  :global([data-theme='light']) .am-mark:hover { box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 30px 60px -30px rgb(var(--fg-rgb) / 0.34); }
  :global([data-theme='light']) .am-mark__media::after { display: none; }
  .am-mark::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--accent-grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }
  .am-mark:hover { border-color: rgb(var(--accent-rgb) / 0.3); transform: translateY(-4px); }
  .am-mark:hover::after { transform: scaleX(1); }
  .am-mark__media { display: block; flex: none; aspect-ratio: 16 / 10; border-radius: 0; }
  .am-mark__media img { display: block; filter: saturate(0.88) brightness(0.88); transform: scale(1.001); transition: transform 1.2s var(--ease-out), filter 0.8s var(--ease-out); }
  .am-mark:hover .am-mark__media img { transform: scale(1.04); filter: saturate(1) brightness(0.95); }
  :global([data-theme='light']) .am-mark__media img { filter: saturate(0.94); }
  :global([data-theme='light']) .am-mark:hover .am-mark__media img { filter: saturate(1); }
  .am-mark__tag {
    position: absolute;
    z-index: 2;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem 0.4rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--fg-rgb) / 0.16);
    background: rgb(var(--bg-rgb) / 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
  }
  .am-mark__tag :global(svg) { width: 13px; height: 13px; color: var(--accent-2); }
  /* Ivory pills need more body to stay legible over dark photography. */
  :global([data-theme='light']) .am-mark__tag { background: rgb(var(--bg-rgb) / 0.88); border-color: rgb(var(--fg-rgb) / 0.08); }
  .am-mark__body { flex: 1; display: flex; flex-direction: column; gap: 0.45rem; padding: 1.25rem 1.35rem 1.3rem; }
  .am-mark__title { font-family: var(--font-display); font-size: clamp(1.2rem, 1.4vw, 1.38rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; color: var(--text); }
  .am-mark__sub { min-height: 1.2em; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-2); }
  .am-mark__text { font-size: 0.86rem; line-height: 1.55; color: var(--muted); }
  .am-mark__go { margin-top: auto; padding-top: 0.75rem; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 32px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-2); transition: color 0.4s; }
  .am-mark__go :global(svg) { width: 14px; height: 14px; transition: transform 0.5s var(--ease-out); }
  .am-mark:hover .am-mark__go { color: var(--accent-2); }
  .am-mark:hover .am-mark__go :global(svg) { transform: translateX(4px); }

  .am-custom {
