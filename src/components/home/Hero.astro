---
// Home hero: cinematic Three.js "Seattle after dark" scene + headline + instant quote widget.
import Icon from '../Icon.astro';
import { site, images, fleet } from '../../data/site';

// Smallest vehicle that seats the party, used for the live "suggested vehicle" hint.
const capacity = [...fleet]
  .sort((a, b) => a.passengers - b.passengers)
  .map((v) => ({ id: v.id, name: v.name, pax: v.passengers }));

// Values are the full names /book/ receives; labels stay short enough for the row beside the swap button.
const airports = [
  { value: 'SeaTac International Airport (SEA)', label: 'SeaTac (SEA)' },
  { value: 'Paine Field (PAE)', label: 'Paine Field (PAE)' },
  { value: 'Boeing Field (BFI)', label: 'Boeing Field (BFI)' },
];
// Same 1–12 range as the booking wizard and the service-page quick quote, so no minimum is implied.
const hours = Array.from({ length: 12 }, (_, i) => i + 1);
---
<section class="hero" data-hero data-theme="dark" aria-label="Seattle luxury chauffeur service">
  <div class="hero__stage" data-hero-stage aria-hidden="true">
    <img class="hero__fallback" data-hero-fallback data-src={images.skyline} alt="" decoding="async" />
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner container" data-hero-content>
    <div class="hero__intro" data-hero-intro>
      <!-- The kicker carries the page's head term inside the h1 (same pattern as /fleet/); the display line stays the brand line. -->
      <h1 class="hero__title display" data-split data-split-manual data-split-done="1" data-hero-title>
        <span class="eyebrow hero__eyebrow" data-hero-in><span>Seattle limo &amp; chauffeur service<span class="hero__eyebrow-since"> · Since {site.since}</span></span></span>
        <span class="split-line" style="display:inline-block"><span class="split-word">Seattle,</span></span> <em><span class="split-line" style="display:inline-block"><span class="split-word">chauffeured.</span></span></em>
      </h1>
      <p class="lead hero__lead" data-hero-rise>
        Private chauffeurs and immaculate black cars for airport runs, executive travel and the nights that matter, across Seattle and the Eastside,&nbsp;24/7.
      </p>
      <div class="hero__ctas" data-hero-rise>
        <a href="/book/" class="btn btn--gold btn--lg" data-magnetic>Reserve your ride <Icon name="arrow" /></a>
        <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
      </div>
      <ul class="hero__trust" role="list" data-hero-rise>
        <li class="hero__rating">
          <span class="stars" aria-hidden="true">
            <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
          </span>
          <span><strong>{site.rating.score}</strong> · {site.rating.count} reviews</span>
        </li>
        <li><Icon name="shield" /> Licensed, vetted chauffeurs</li>
        <li><Icon name="plane" /> Live flight tracking</li>
      </ul>
    </div>

    <aside class="hero__quote" data-hero-in data-hero-quote aria-labelledby="quote-title">
      <form class="quote glass" data-quote data-fleet={JSON.stringify(capacity)} action="/book/" method="get" novalidate>
        <div class="quote__head">
          <p class="quote__kicker"><span class="quote__live" aria-hidden="true"></span> Reserve in four quick steps</p>
          <h2 class="quote__title" id="quote-title">Where can we take you?</h2>
        </div>

        <div class="quote__tabs" role="tablist" aria-label="Trip type" data-quote-tabs>
          <span class="quote__pill" data-quote-pill aria-hidden="true"></span>
          <button type="button" role="tab" id="qt-p2p" aria-selected="true" aria-controls="quote-panel" data-type="p2p">Point-to-Point</button>
          <button type="button" role="tab" id="qt-hourly" aria-selected="false" aria-controls="quote-panel" tabindex="-1" data-type="hourly">Hourly</button>
          <button type="button" role="tab" id="qt-airport" aria-selected="false" aria-controls="quote-panel" tabindex="-1" data-type="airport">Airport</button>
        </div>

        <div class="quote__panel" id="quote-panel" role="tabpanel" aria-labelledby="qt-p2p" data-quote-panel>
          <div class="qgroup qgroup--route" data-quote-route data-dir="to">
            <label class="qrow qrow--from" data-row="from">
              <span class="qrow__icon"><Icon name="pin" /></span>
              <span class="qrow__body">
                <span class="qrow__label" data-from-label>Pickup location</span>
                <input class="qrow__input" type="text" name="from" placeholder="Address, hotel or venue" autocomplete="off" data-from />
              </span>
            </label>
            <label class="qrow qrow--to" data-row="to" data-show="p2p">
              <span class="qrow__icon"><Icon name="flag" /></span>
              <span class="qrow__body">
                <span class="qrow__label">Drop-off location</span>
                <input class="qrow__input" type="text" name="to" placeholder="Where are you headed?" autocomplete="off" data-to />
              </span>
            </label>
            <label class="qrow qrow--hours" data-row="hours" data-show="hourly" hidden>
              <span class="qrow__icon"><Icon name="hourglass" /></span>
              <span class="qrow__body">
                <span class="qrow__label">Duration</span>
                <select class="qrow__input" name="hours" data-hours>
                  {hours.map((h) => <option value={h} selected={h === 3}>{h} {h === 1 ? 'hour' : 'hours'}</option>)}
                </select>
              </span>
              <span class="qrow__chev"><Icon name="chevron" /></span>
            </label>
            <label class="qrow qrow--airport" data-row="airport" data-show="airport" hidden>
              <span class="qrow__icon"><Icon name="plane" /></span>
              <span class="qrow__body">
                <span class="qrow__label" data-airport-label>Drop-off airport</span>
                <select class="qrow__input" name="airport" data-airport>
                  {airports.map((a) => <option value={a.value}>{a.label}</option>)}
                </select>
              </span>
              <span class="qrow__chev"><Icon name="chevron" /></span>
            </label>
            <button type="button" class="qswap" data-show="airport" data-swap hidden aria-label="Swap to a pickup from the airport">
              <Icon name="swap" />
            </button>
          </div>

          <div class="qgroup qgroup--split">
            <label class="qrow">
              <span class="qrow__icon"><Icon name="calendar" /></span>
              <span class="qrow__body">
                <span class="qrow__label">Date</span>
                <input class="qrow__input" type="date" name="date" data-date />
              </span>
            </label>
            <label class="qrow" data-time-row data-empty>
              <span class="qrow__icon"><Icon name="clock" /></span>
              <span class="qrow__body">
                <span class="qrow__label">Time</span>
                <span class="qrow__field">
                  <input class="qrow__input" type="time" name="time" step="900" data-time />
                  <span class="qrow__ph" aria-hidden="true">Select time</span>
                </span>
              </span>
            </label>
          </div>

          <div class="qgroup">
            <div class="qrow qrow--pax">
              <span class="qrow__icon"><Icon name="users" /></span>
              <span class="qrow__body">
                <span class="qrow__label" id="pax-label">Passengers</span>
                <span class="qrow__pax"><output data-pax-out aria-live="polite" for="pax-input">2</output> <span class="qrow__hint" data-pax-hint></span></span>
              </span>
              <div class="stepper" role="group" aria-labelledby="pax-label">
                <button type="button" class="stepper__btn" data-pax="-1" aria-label="Fewer passengers"><Icon name="minus" /></button>
                <button type="button" class="stepper__btn" data-pax="1" aria-label="More passengers"><Icon name="plus" /></button>
              </div>
              <input type="hidden" name="pax" value="2" id="pax-input" data-pax-input />
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn--gold btn--lg btn--block quote__submit" data-magnetic="0.15">
          Choose your vehicle <Icon name="arrow" />
        </button>
        <p class="quote__note"><span class="quote__note-item"><Icon name="check" /> Nothing charged now</span><span class="quote__note-sep" aria-hidden="true">·</span><span class="quote__note-item">Personally confirmed</span></p>
      </form>
    </aside>
  </div>

  <button type="button" class="hero__cue" data-hero-cue data-hero-in aria-label="Scroll to explore">
    <span class="hero__cue-line" aria-hidden="true"></span>
    <span class="hero__cue-text">Scroll</span>
  </button>
</section>

<style>
  /* ---------- Frame ---------- */
  .hero {
    /* Rounded ivory "sheet" the page rises on in light mode (see .hero::after) */
    --hero-curtain: clamp(20px, 2.5vw, 36px);
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: max(100svh, 760px);
    overflow: hidden;
    background: radial-gradient(120% 70% at 58% 58%, var(--bg-2) 0%, var(--bg-2) 45%, var(--bg) 100%);
  }
  .hero__stage { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 2.2s var(--ease-out); }
  .hero__stage.is-live .hero__canvas { opacity: 1; }
  .hero__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    opacity: 0;
    filter: brightness(0.42) saturate(0.75) contrast(1.08);
    transform: scale(1.04);
    transition: opacity 1.4s var(--ease-out);
  }
  .hero__stage.is-fallback .hero__fallback { opacity: 1; }
  .hero__stage.is-fallback .hero__canvas { display: none; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgb(var(--bg-rgb) / 0.6) 0%, rgb(var(--bg-rgb) / 0) 20%),
      radial-gradient(48% 36% at 20% 66%, rgb(var(--bg-rgb) / 0.5) 0%, rgb(var(--bg-rgb) / 0) 100%),
      linear-gradient(90deg, rgb(var(--bg-rgb) / 0.88) 0%, rgb(var(--bg-rgb) / 0.6) 30%, rgb(var(--bg-rgb) / 0) 58%),
      linear-gradient(0deg, var(--bg) 0%, rgb(var(--bg-rgb) / 0.55) 16%, rgb(var(--bg-rgb) / 0) 42%);
  }
  /* Light page: the ivory page rises over the night scene as a rounded sheet, a clean
     hard edge instead of a muddy dark-to-ivory gradient. On the dark page the scene
     already settles into onyx, so the hand-off is seamless and needs no sheet. */
  :global(html[data-theme='light']) .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    height: var(--hero-curtain);
    border-radius: var(--hero-curtain) var(--hero-curtain) 0 0;
    background: var(--page-bg);
    /* a soft champagne glow (no hard rule) lifts the curved edge off the night scene; the next
       section's own hairline then reads as the single rule rather than a doubled edge */
    box-shadow: 0 -8px 56px -6px rgb(var(--accent-rgb) / 0.16);
    pointer-events: none;
  }
  /* The scene settles into flat onyx just above the sheet (or into the onyx page in dark mode),
     so the light hand-off is one crisp edge and the dark one is seamless. */
  .hero__stage::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    height: clamp(120px, 18vh, 200px);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(var(--bg-rgb) / 0) 0%,
      rgb(var(--bg-rgb) / 0.35) 35%,
      rgb(var(--bg-rgb) / 0.75) 65%,
      rgb(var(--bg-rgb) / 0.94) 85%,
      var(--bg) 100%
    );
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 408px);
    align-items: end;
    gap: clamp(2rem, 5vw, 6rem);
    padding-top: calc(var(--header-h) + 2.5rem);
    padding-bottom: clamp(5.5rem, 10vh, 7.5rem);
  }

  /* ---------- Copy ---------- */
  .hero__intro { max-width: 760px; }
  /* The kicker lives inside the h1: a block-level flex row sized to its text, so the display line starts below it */
  .hero__eyebrow {
    display: flex;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1.6rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.24em;
    color: var(--accent-2);
    text-shadow: 0 1px 12px rgb(var(--bg-rgb) / 0.85);
  }
  .hero__eyebrow::before { width: 2rem; background: linear-gradient(90deg, transparent, var(--accent-2)); }
  /* Inter Tight display at the site's hero scale and heading weight (matches /fleet/, /services/);
     tight (not crushed) tracking keeps the "ff" in "chauffeured" from colliding. */
  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.035em;
    font-kerning: normal;
    text-wrap: balance;
    text-shadow: 0 2px 40px rgb(var(--bg-rgb) / 0.35);
  }
  .hero__title em { display: block; font-style: normal; background: none; color: inherit; padding-right: 0; }
  .hero__title :global(.split-line) { padding: 0 0.06em 0.14em 0; margin: 0 -0.06em -0.14em 0; }
  /* Accent word: non-italic champagne gradient with a specular sheen that sweeps once after the
     intro lands (painted per word, since transformed children break a parent's background-clip). */
  .hero__title em :global(.split-word) {
    background-image:
      linear-gradient(100deg, transparent 38%, rgb(var(--fg-rgb) / 0.72) 50%, transparent 62%),
      var(--accent-grad);
    background-size: 260% 100%, 100% 100%;
    background-position: -5% 0, 0 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.04em;
    /* text-shadow would paint over a background-clipped gradient and muddy the gold */
    text-shadow: none;
  }
  .hero.is-sheen .hero__title em :global(.split-word) { animation: hero-sheen 2.6s var(--ease-in-out) both; }
  @keyframes hero-sheen {
    from { background-position: 105% 0, 0 0; }
    to { background-position: -5% 0, 0 0; }
  }
  .hero__lead {
    margin-top: 1.6rem;
    max-width: 44ch;
    font-size: clamp(1.02rem, 1.15vw, 1.14rem);
    line-height: 1.62;
    letter-spacing: -0.003em;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.2rem; }
  /* Proof row: a quiet spec line under a hairline, sized to its content */
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.9rem;
    width: fit-content;
    max-width: 100%;
    margin-top: 2.1rem;
    padding: 1.35rem 0 0;
    border-top: 1px solid var(--line-strong);
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--text-2);
  }
  /* column-gap only: no divider can be orphaned at the start of a wrapped line */
  .hero__trust li { display: inline-flex; align-items: center; gap: 0.55rem; white-space: nowrap; }
  .hero__trust :global(svg) { width: 16px; height: 16px; color: var(--accent); }
  .hero__trust .stars :global(svg) { width: 12px; height: 12px; }
  .hero__trust strong { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* JS-driven intro (with a no-JS failsafe). The kicker, headline, quote card and cue wait for the script.
     The lead, CTAs and proof row are the page's LCP candidates, so they paint from the first frame and
     only rise into place (transform, never opacity). */
  :global(.js) .hero [data-hero-in],
  :global(.js) .hero__title { opacity: 0; animation: hero-failsafe 0.01s linear 6s forwards; }
  :global(.js) .hero [data-hero-rise] { transform: translateY(26px); animation: hero-failsafe-rise 0.01s linear 6s forwards; }
  .hero.is-armed [data-hero-in],
  .hero.is-armed [data-hero-rise],
  .hero.is-armed .hero__title { animation: none; }
  @keyframes hero-failsafe { to { opacity: 1; } }
  @keyframes hero-failsafe-rise { to { transform: none; } }

  /* ---------- Quote widget ---------- */
  .hero__quote { position: relative; width: 100%; }
  .quote {
    position: relative;
    display: grid;
    gap: 1.05rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-radius: var(--radius-l);
    /* Near-opaque onyx instead of .glass's live blur: a backdrop-filter over the WebGL canvas is
       re-rasterised every frame for almost no visible gain at this opacity. */
    background: linear-gradient(180deg, rgb(var(--bg-rgb) / 0.84), rgb(var(--bg-rgb) / 0.88));
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: 0 50px 100px -40px rgb(var(--bg-rgb) / 0.9), inset 0 1px 0 rgb(var(--fg-rgb) / 0.06);
  }
  .quote::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(var(--accent-2-rgb) / 0.75), transparent);
  }
  .quote__head { display: grid; gap: 0.5rem; }
  .quote__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .quote__live { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); animation: q-pulse 2.4s 3; } /* 3 pulses, not forever: an endless box-shadow loop repaints every frame */
  @keyframes q-pulse { 70% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--ok) 0%, transparent); } 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 0%, transparent); } }
  /* A UI heading, not a display line: modest size, gentle tracking */
  .quote__title { font-size: clamp(1.35rem, 1.55vw, 1.55rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.022em; }

  .quote__tabs {
    position: relative;
    display: flex;
    padding: 4px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(var(--bg-rgb) / 0.45);
  }
  .quote__tabs button {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    min-height: 44px;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.5s var(--ease-out);
  }
  .quote__tabs button:hover { color: var(--text); }
  .quote__tabs button[aria-selected='true'] { color: var(--on-accent); }
  .quote__pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--accent-grad);
    box-shadow: 0 6px 24px -8px rgb(var(--accent-rgb) / 0.7);
    transition: transform 0.65s var(--ease-out), width 0.65s var(--ease-out);
  }
  .quote__pill.no-anim { transition: none; }

  .quote__panel { display: grid; gap: 0.7rem; }

  /* Airport direction: a flight-search style swap on the route divider, so every tab keeps the
     same two-row route group and the card never changes height. */
  .qgroup--route { position: relative; }
  .qswap {
    position: absolute;
    top: 50%;
    right: 0.7rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border-radius: 50%;
    border: 1px solid rgb(var(--accent-rgb) / 0.45);
    background: var(--bg-2);
    color: var(--accent-2);
    box-shadow: 0 0 0 5px rgb(var(--bg-rgb) / 0.9), 0 8px 24px -8px rgb(var(--bg-rgb) / 0.9);
    cursor: pointer;
    transition: border-color 0.3s, background 0.3s, color 0.3s;
  }
  .qswap[hidden] { display: none; }
  .qswap :global(svg) { width: 17px; height: 17px; transition: transform 0.7s var(--ease-out); }
  .qswap:hover { border-color: var(--accent); background: var(--bg-2); }
  .qswap:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .qgroup--route[data-dir='from'] .qswap :global(svg) { transform: rotate(180deg); }
  .quote[data-type='airport'] .qgroup--route .qrow { padding-right: 4.1rem; }
  /* The swap button marks the airport row's right edge, so it drops the chevron column */
  .quote[data-type='airport'] .qrow--airport { grid-template-columns: 20px minmax(0, 1fr); }
  .quote[data-type='airport'] .qrow--airport .qrow__chev { display: none; }

  .qgroup {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .qgroup--split { display: grid; grid-template-columns: 1.15fr 1fr; }
  .qrow {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 62px;
    padding: 0.5rem 0.95rem;
    background: rgb(var(--bg-rgb) / 0.86);
    cursor: text;
    transition: background 0.3s;
  }
  .qrow[hidden] { display: none; }
  .qrow::after {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.45s var(--ease-out);
  }
  .qrow:focus-within { background: rgb(var(--bg-rgb) / 0.95); }
  .qrow:focus-within::after { transform: scaleY(1); }
  .qrow__icon { display: grid; place-items: center; color: var(--accent); }
  .qrow__icon :global(svg) { width: 18px; height: 18px; }
  .qrow__body { display: grid; gap: 0.1rem; min-width: 0; }
  .qrow__label { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .qrow__input {
    width: 100%;
    min-width: 0;
    min-height: 26px;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    font-variant-numeric: tabular-nums;
    color-scheme: dark;
  }
  .qrow__input::placeholder { color: var(--muted); opacity: 1; }
  select.qrow__input {
    appearance: none;
    cursor: pointer;
    padding-right: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  select.qrow__input option { background: var(--bg-3); color: var(--text); }
  /* Date/time: one icon (ours), and a tap anywhere on the row opens the native picker */
  .qrow__input[type='date'],
  .qrow__input[type='time'] { -webkit-appearance: none; appearance: none; cursor: pointer; text-align: left; }
  .qrow__input::-webkit-calendar-picker-indicator {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
    background: none;
  }
  .qrow__input::-webkit-date-and-time-value { text-align: left; margin: 0; }
  .qrow__input::-webkit-datetime-edit { padding: 0; }
  /* Time starts unset: a muted "Select time" sits over the native field until the guest picks one */
  .qrow__field { display: grid; min-width: 0; }
  .qrow__field > * { grid-area: 1 / 1; }
  .qrow__ph {
    align-self: center;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
    pointer-events: none;
    opacity: 0;
  }
  :global(.js) .qrow[data-empty] .qrow__ph { opacity: 1; }
  :global(.js) .qrow[data-empty] .qrow__input { color: transparent; }
  .qrow__chev { color: var(--muted); pointer-events: none; }
  .qrow__chev :global(svg) { width: 16px; height: 16px; }
  .qgroup--split .qrow { grid-template-columns: 18px minmax(0, 1fr); gap: 0.7rem; padding-right: 0.7rem; }
  .qgroup--route[data-dir='from'] .qrow--airport { order: -1; }

  .qrow--pax { cursor: default; }
  .qrow__pax { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.45rem; min-width: 0; line-height: 1.35; }
  .qrow__pax output { font-size: 1.05rem; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; min-width: 1.2ch; }
  /* Suggested vehicle: a caption under the count wherever the card is narrow (it may wrap, and
     there is no separator to orphan); on wide cards it sits inline after a drawn "·" (below). */
  .qrow__hint { flex-basis: 100%; min-width: 0; font-size: 0.72rem; line-height: 1.3; color: var(--muted); }
  @media (min-width: 1201px) {
    .qrow__pax { flex-wrap: nowrap; }
    .qrow__hint { flex-basis: auto; font-size: 0.74rem; line-height: inherit; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .qrow__hint:not(:empty)::before { content: '· '; content: '· ' / ''; }
  }
  .stepper { display: flex; gap: 0.4rem; }
  .stepper__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text);
    transition: border-color 0.3s, background 0.3s, color 0.3s, opacity 0.3s;
  }
  .stepper__btn :global(svg) { width: 16px; height: 16px; }
  .stepper__btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent-2); background: rgb(var(--accent-rgb) / 0.08); }
  .stepper__btn:disabled { opacity: 0.3; cursor: not-allowed; }

  .quote__submit { margin-top: 0.15rem; }
  .quote__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.2rem 0.45rem;
    font-size: 0.74rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    text-align: center;
  }
  /* each phrase wraps as a unit; on the narrowest phones the dot drops and they stack */
  .quote__note-item { display: inline-flex; align-items: center; gap: 0.45rem; white-space: nowrap; }
  .quote__note :global(svg) { width: 14px; height: 14px; color: var(--ok); }
  @media (max-width: 379px) {
    .quote__note-sep { display: none; }
    .quote__note { flex-direction: column; }
    /* Date/time drop their icons so "Select time" and a full date still fit */
    .qgroup--split .qrow { grid-template-columns: minmax(0, 1fr); }
    .qgroup--split .qrow__icon { display: none; }
  }

  /* ---------- Scroll cue ---------- */
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--hero-curtain) + 0.6rem);
    z-index: 2;
    display: none;
    justify-items: center;
    gap: 0.7rem;
    min-width: 44px;
    padding: 0.4rem;
    transform: translateX(-50%);
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    transition: color 0.3s;
  }
  .hero__cue:hover { color: var(--accent-2); }
  .hero__cue-text { padding-left: 0.32em; }
  .hero__cue-line { position: relative; width: 1px; height: 34px; overflow: hidden; background: var(--line-strong); }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, transparent, var(--accent-2));
    animation: cue-drop 2.4s var(--ease-in-out) infinite;
  }
  @keyframes cue-drop {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  /* Scroll cue only where there is clear room under the content */
  @media (min-width: 1200px) and (min-height: 860px) {
    .hero__cue { display: grid; }
    .hero__inner { padding-bottom: calc(clamp(6.5rem, 12vh, 8.5rem) + var(--hero-curtain)); }
  }

  /* ---------- Laptop heights ---------- */
  @media (min-width: 981px) and (max-height: 820px) {
    .hero__inner { padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: 4.8rem; }
    .hero__eyebrow { margin-bottom: 1.1rem; }
    .hero__lead { margin-top: 1.2rem; }
    .hero__ctas, .hero__trust { margin-top: 1.6rem; }
    .quote { gap: 0.8rem; }
    .qrow { min-height: 56px; }
  }

  /* ---------- Small laptops / iPad landscape ---------- */
  @media (min-width: 981px) and (max-width: 1200px) {
    /* Squarer screens shift the lit skyline left, behind the copy: carry the scrim further across */
    .hero__scrim {
      background:
        linear-gradient(180deg, rgb(var(--bg-rgb) / 0.6) 0%, rgb(var(--bg-rgb) / 0) 20%),
        radial-gradient(48% 36% at 20% 66%, rgb(var(--bg-rgb) / 0.5) 0%, rgb(var(--bg-rgb) / 0) 100%),
        linear-gradient(90deg, rgb(var(--bg-rgb) / 0.9) 0%, rgb(var(--bg-rgb) / 0.72) 38%, rgb(var(--bg-rgb) / 0) 70%),
        linear-gradient(0deg, var(--bg) 0%, rgb(var(--bg-rgb) / 0.55) 16%, rgb(var(--bg-rgb) / 0) 42%);
    }
    .hero__inner { grid-template-columns: minmax(0, 1fr) minmax(320px, 360px); gap: 2.5rem; }
    .hero__title { font-size: clamp(3.6rem, 6.8vw, 5rem); }
    .hero__lead { font-size: 1.02rem; }
    .hero__ctas { flex-wrap: nowrap; gap: 0.7rem; }
    .hero__ctas .btn { min-height: 54px; padding: 0 1.45rem; letter-spacing: 0.12em; }
    /* three proofs don't fit one line here: rating above, the two badges paired below */
    .hero__trust { gap: 0.6rem 1.5rem; }
    .hero__trust li.hero__rating { flex-basis: 100%; }
    .quote { padding: 1.25rem; }
    .quote__tabs button { padding: 0 0.5rem; letter-spacing: 0.07em; }
    .qrow { padding-inline: 0.85rem; gap: 0.7rem; }
    .qgroup--split .qrow { padding-inline: 0.75rem 0.5rem; gap: 0.55rem; }
    .qgroup--split .qrow__input,
    .qgroup--split .qrow__ph { letter-spacing: -0.01em; }
  }

  /* ---------- Tablet & mobile ---------- */
  @media (max-width: 980px) {
    /* flat onyx so the area under the stage (quote card) meets the stage's fade without a step */
    .hero { display: block; min-height: 0; background: var(--bg); }
    .hero__title { font-size: clamp(3rem, 9vw, 5rem); }
    .hero__stage { inset: 0 0 auto 0; height: calc(100svh + 160px); }
    .hero__stage::before { display: none; }
    .hero__stage::after {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      height: 220px;
      background: linear-gradient(180deg, rgb(var(--bg-rgb) / 0), var(--bg));
    }
    .hero__scrim {
      background:
        linear-gradient(180deg, rgb(var(--bg-rgb) / 0.55) 0%, rgb(var(--bg-rgb) / 0) 16%),
        linear-gradient(180deg, rgb(var(--bg-rgb) / 0) 24%, rgb(var(--bg-rgb) / 0.72) 37%, rgb(var(--bg-rgb) / 0.8) 56%, rgb(var(--bg-rgb) / 0.9) 80%, rgb(var(--bg-rgb) / 0.94) 100%);
    }
    .hero__inner { grid-template-columns: 1fr; gap: 0.5rem; padding-top: 0; padding-bottom: clamp(3rem, 8vw, 5rem); }
    .hero__intro {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100svh;
      max-width: 640px;
      padding-top: calc(var(--header-h) + 1rem);
      padding-bottom: 2.25rem;
    }
    /* The card spans the column; on tablets its date/time and passenger rows pair up (below) */
    .hero__quote { max-width: none; }
    /* The eyebrow sits on the road's vanishing point here, so it gets a quiet (unblurred) backdrop */
    .hero__eyebrow {
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      background: rgb(var(--bg-rgb) / 0.72);
      box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / 0.18);
    }
    .hero__eyebrow::before { display: none; }
  }
  @media (min-width: 720px) and (max-width: 980px) {
    .quote__panel { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .qgroup--route { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .hero__eyebrow { margin-bottom: 1.1rem; padding: 0.5rem 0.85rem; font-size: 0.68rem; letter-spacing: 0.18em; }
    .hero__eyebrow-since { display: none; }
    .hero__title { font-size: clamp(3.1rem, 14.5vw, 4rem); }
    .hero__lead { margin-top: 1.15rem; font-size: 0.98rem; line-height: 1.6; }
    .hero__ctas { flex-direction: column; margin-top: 1.6rem; gap: 0.65rem; }
    .hero__ctas .btn { width: 100%; min-height: 54px; }
    .hero__trust { margin-top: 1.4rem; gap: 0.55rem 1.25rem; font-size: 0.78rem; }
    .hero__trust li.hero__rating { flex-basis: 100%; }
    .quote { padding: 1.15rem; border-radius: 22px; }
    .quote__tabs button { font-size: 0.7rem; letter-spacing: 0.08em; padding: 0 0.45rem; }
    .qrow { padding-inline: 0.85rem; gap: 0.7rem; }
    /* fields stay at 16px so iOS Safari never zooms on focus; tracking recovers the width */
    .qgroup--split .qrow { padding-inline: 0.75rem 0.5rem; gap: 0.55rem; }
    .qgroup--split .qrow__input,
    .qgroup--split .qrow__ph { letter-spacing: -0.01em; }
  }
  @media (max-width: 379px) {
    /* The column may not grow past the screen (the trip-type tabs' min-content used to widen it on
       320px phones, pushing the lead past the right gutter); the tabs tighten to fit instead. */
    .hero__inner { grid-template-columns: minmax(0, 1fr); }
    .quote { padding: 1rem; }
    .quote__tabs button { padding: 0 0.3rem; font-size: 0.64rem; letter-spacing: 0.04em; }
    .hero__eyebrow { padding-inline: 0.75rem; letter-spacing: 0.12em; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero [data-hero-in], :global(.js) .hero__title { opacity: 1; animation: none; }
    :global(.js) .hero [data-hero-rise] { transform: none; animation: none; }
    .hero__cue-line::after { animation: none; transform: none; }
    .hero.is-sheen .hero__title em :global(.split-word) { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { splitWords } from '../../scripts/global';
  import type { HeroScene } from '../../scripts/hero-scene';

  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHero(hero);

  function initHero(hero: HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const stage = hero.querySelector<HTMLElement>('[data-hero-stage]')!;
    const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
    const fallbackImg = hero.querySelector<HTMLImageElement>('[data-hero-fallback]')!;
    const title = hero.querySelector<HTMLElement>('[data-hero-title]')!;
    const content = hero.querySelector<HTMLElement>('[data-hero-content]')!;
    const intro = hero.querySelector<HTMLElement>('[data-hero-intro]')!;
    const quote = hero.querySelector<HTMLElement>('[data-hero-quote]')!;
    const cue = hero.querySelector<HTMLElement>('[data-hero-cue]');
    const ins = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-in]')).filter((el) => el !== quote && el !== cue);
    // Lead, CTAs and proof row: visible from the first paint (LCP), they only rise into place
    const rise = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-rise]'));

    /* ---------- Intro choreography (starts as soon as the script runs) ---------- */
    hero.classList.add('is-armed');
    const words = splitWords(title);
    let scene: HeroScene | null = null;
    let ready = false;

    if (reduce) {
      gsap.set([title, quote, cue, ...ins], { opacity: 1 });
    } else {
      gsap.set(words, { yPercent: 120, rotate: 4, transformOrigin: '0% 100%' });
      gsap.set(title, { opacity: 1 });
      gsap.set(ins, { opacity: 0, y: 26 });
      gsap.set(rise, { y: 26 }); // matches the CSS first-paint offset; never hidden
      gsap.set(quote, { opacity: 0, y: 40 });
      if (cue) gsap.set(cue, { opacity: 0 });
    }

    const play = () => {
      if (ready) return;
      ready = true;
      scene?.playIntro();
      if (reduce) return;
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.to(ins, { opacity: 1, y: 0, duration: 1.2 }, 0)
        .to(words, { yPercent: 0, rotate: 0, duration: 1.6, stagger: 0.09 }, 0.05)
        .to(rise, { y: 0, duration: 1.3, stagger: 0.1 }, 0.2)
        .to(quote, { opacity: 1, y: 0, duration: 1.6 }, 0.55)
        // one specular pass across the champagne accent once the headline has settled
        .call(() => hero.classList.add('is-sheen'), undefined, 1.0);
      if (cue) tl.to(cue, { opacity: 1, duration: 1.2, ease: 'power2.out' }, 1.15);
    };
    // The intro never waits on anything but a preloader, if a page ever turns one back on.
    const preloading = !!document.querySelector('[data-preloader]') && !document.documentElement.classList.contains('is-ready');
    if (preloading) document.addEventListener('sdd:ready', play, { once: true });
    else play();

    /* ---------- WebGL scene (code-split) with photographic fallback ---------- */
    const showFallback = () => {
      if (!fallbackImg.src && fallbackImg.dataset.src) fallbackImg.src = fallbackImg.dataset.src;
      stage.classList.add('is-fallback');
    };
    const hasWebGL2 = () => {
      try {
        return !!document.createElement('canvas').getContext('webgl2');
      } catch {
        return false;
      }
    };
    // Data-saver and low-end devices skip the 3D scene (and its ~140 KB three.js chunk): Save-Data keeps
    // the plain onyx gradient, low-memory / few-core devices get the photographic fallback.
    const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
    const saveData = !!nav.connection?.saveData;
    const lowEnd = (nav.deviceMemory ?? 8) < 4 || (navigator.hardwareConcurrency || 4) < 4;
    const loadScene = () => import('../../scripts/hero-scene')
      .then(({ createHeroScene }) => {
        scene = createHeroScene(canvas, {
          reducedMotion: reduce,
          onFirstFrame: () => stage.classList.add('is-live'),
          onContextLost: showFallback,
        });
        if (!scene) return showFallback();
        if (ready) scene.playIntro();
        const io = new IntersectionObserver(([entry]) => scene?.setActive(entry.isIntersecting), { rootMargin: '80px' });
        io.observe(stage);
        if (!reduce) {
          ScrollTrigger.create({
            trigger: stage,
            start: 'top top',
            end: 'bottom top',
            onUpdate: (self) => scene?.setScroll(self.progress),
          });
          if (finePointer) {
            window.addEventListener('pointermove', (e) => {
              scene?.setPointer((e.clientX / window.innerWidth) * 2 - 1, (e.clientY / window.innerHeight) * 2 - 1);
            }, { passive: true });
          }
        }
      })
      .catch(showFallback);
    if (saveData) {
      /* the hero's own onyx gradient stands in: no photo, no 3D */
    } else if (lowEnd) showFallback();
    else {
      // Kept off the critical path: the WebGL probe, the three.js fetch and the scene build all wait
      // until the page has loaded and the main thread is idle, so they never compete with the hero
      // copy (LCP) or the fonts.
      const start = () => (hasWebGL2() ? loadScene() : showFallback());
      const whenIdle = () => {
        if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 2500 });
        else window.setTimeout(start, 200);
      };
      if (document.readyState === 'complete') whenIdle();
      else window.addEventListener('load', whenIdle, { once: true });
    }

    /* ---------- Scroll: content lifts and dissolves as the camera pushes in ---------- */
    if (!reduce) {
      const mm = gsap.matchMedia();
      mm.add('(min-width: 981px)', () => {
        const tl = gsap.timeline({ scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6 } });
        tl.to(content, { y: -150, ease: 'none', duration: 1 }, 0).to(content, { opacity: 0, ease: 'power1.in', duration: 0.75 }, 0);
        if (cue) tl.to(cue, { opacity: 0, duration: 0.15, ease: 'none' }, 0);
      });
      mm.add('(max-width: 980px)', () => {
        gsap.to(intro, { y: -70, opacity: 0, ease: 'power1.in', scrollTrigger: { trigger: intro, start: 'top top', end: 'bottom 20%', scrub: 0.5 } });
      });
    }

    cue?.addEventListener('click', () => {
      const y = hero.offsetTop + hero.offsetHeight - 40;
      if (window.lenis) window.lenis.scrollTo(y, { duration: 1.6 });
      else window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
    });

    initQuote(hero, reduce);
  }

  /* ---------- Quick quote widget ---------- */
  function initQuote(hero: HTMLElement, reduce: boolean) {
    const form = hero.querySelector<HTMLFormElement>('[data-quote]');
    if (!form) return;
    const tabs = Array.from(form.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const tablist = form.querySelector<HTMLElement>('[data-quote-tabs]')!;
    const pill = form.querySelector<HTMLElement>('[data-quote-pill]')!;
    const panel = form.querySelector<HTMLElement>('[data-quote-panel]')!;
    const route = form.querySelector<HTMLElement>('[data-quote-route]')!;
    const fromInput = form.querySelector<HTMLInputElement>('[data-from]')!;
    const fromLabel = form.querySelector<HTMLElement>('[data-from-label]')!;
    const airportLabel = form.querySelector<HTMLElement>('[data-airport-label]')!;
    const swapBtn = form.querySelector<HTMLButtonElement>('[data-swap]')!;
    const toInput = form.querySelector<HTMLInputElement>('[data-to]')!;
    const hoursSel = form.querySelector<HTMLSelectElement>('[data-hours]')!;
    const airportSel = form.querySelector<HTMLSelectElement>('[data-airport]')!;
    const dateInput = form.querySelector<HTMLInputElement>('[data-date]')!;
    const timeInput = form.querySelector<HTMLInputElement>('[data-time]')!;
    const paxOut = form.querySelector<HTMLOutputElement>('[data-pax-out]')!;
    const paxHint = form.querySelector<HTMLElement>('[data-pax-hint]')!;
    const paxInput = form.querySelector<HTMLInputElement>('[data-pax-input]')!;
    const paxBtns = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-pax]'));
    const fleet: { id: string; name: string; pax: number }[] = JSON.parse(form.dataset.fleet || '[]');

    let type = 'p2p';
    let dir: 'to' | 'from' = 'to';
    let pax = 2;

    /* Date shows today; time starts unset ("Select time"). Only what the guest actually chose is
       carried into /book/, so an untouched card never sends a made-up pickup time. */
    const pad = (n: number) => String(n).padStart(2, '0');
    const ymd = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const today = ymd(new Date());
    dateInput.value = today;
    dateInput.min = today;
    let dateChosen = false;
    const timeRow = timeInput.closest<HTMLElement>('[data-time-row]');
    const syncTime = () => timeRow?.toggleAttribute('data-empty', !timeInput.value && document.activeElement !== timeInput);
    timeInput.addEventListener('focus', () => timeRow?.removeAttribute('data-empty'));
    timeInput.addEventListener('blur', syncTime);
    ['input', 'change'].forEach((ev) => {
      timeInput.addEventListener(ev, syncTime);
      dateInput.addEventListener(ev, () => { dateChosen = !!dateInput.value; });
    });
    syncTime();
    // values restored by back/forward navigation count as the guest's own choice
    window.addEventListener('pageshow', () => {
      if (dateInput.value && dateInput.value !== today) dateChosen = true;
      syncTime();
    });

    /* A tap anywhere on the date/time row opens the native picker (not just the tiny indicator) */
    [dateInput, timeInput].forEach((input) => {
      input.closest('.qrow')?.addEventListener('click', () => {
        try {
          (input as HTMLInputElement & { showPicker?: () => void }).showPicker?.();
        } catch {
          /* picker already open or unsupported: native behaviour still applies */
        }
      });
    });

    /* Tabs + sliding gold pill */
    const movePill = (animate: boolean) => {
      const active = tabs.find((b) => b.dataset.type === type)!;
      pill.classList.toggle('no-anim', !animate);
      pill.style.width = `${active.offsetWidth}px`;
      pill.style.transform = `translateX(${active.offsetLeft}px)`;
    };

    const labelFrom = () => {
      if (type === 'airport') {
        fromLabel.textContent = dir === 'to' ? 'Pickup address' : 'Drop-off address';
        fromInput.placeholder = dir === 'to' ? 'Home, hotel or office' : 'Where are you headed?';
        airportLabel.textContent = dir === 'to' ? 'Drop-off airport' : 'Pickup airport';
        swapBtn.setAttribute('aria-label', dir === 'to' ? 'Swap to a pickup from the airport' : 'Swap to a drop-off at the airport');
      } else {
        fromLabel.textContent = 'Pickup location';
        fromInput.placeholder = 'Address, hotel or venue';
      }
    };

    const setType = (next: string, animate = true) => {
      if (next === type && animate) return;
      const h0 = panel.offsetHeight;
      type = next;
      form.dataset.type = type;
      tabs.forEach((b) => {
        const on = b.dataset.type === type;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on) panel.setAttribute('aria-labelledby', b.id);
      });
      form.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => {
        el.hidden = !(el.dataset.show || '').split(' ').includes(type);
      });
      labelFrom();
      movePill(animate);
      if (animate && !reduce) {
        // All tabs share the same two-row route group, so this is a no-op guard against sub-pixel drift
        const h1 = panel.offsetHeight;
        if (Math.abs(h1 - h0) > 1) gsap.fromTo(panel, { height: h0 }, { height: h1, duration: 0.6, ease: 'expo.out', clearProps: 'height' });
        const shown = Array.from(panel.querySelectorAll<HTMLElement>('[data-show]')).filter((el) => !el.hidden);
        gsap.fromTo(shown, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.7, ease: 'expo.out', stagger: 0.05, clearProps: 'opacity,transform' });
      }
    };

    tabs.forEach((b, i) => {
      b.addEventListener('click', () => setType(b.dataset.type!));
      b.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End') return;
        e.preventDefault();
        let j = i;
        if (e.key === 'ArrowRight') j = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') j = 0;
        if (e.key === 'End') j = tabs.length - 1;
        tabs[j].focus();
        setType(tabs[j].dataset.type!);
      });
    });
    setType('p2p', false);
    new ResizeObserver(() => movePill(false)).observe(tablist);
    document.fonts?.ready.then(() => movePill(false));

    /* Airport direction: swap pickup/drop-off in place (rows trade places, card height unchanged) */
    swapBtn.addEventListener('click', () => {
      const rows = Array.from(route.querySelectorAll<HTMLElement>('.qrow:not([hidden])'));
      const before = rows.map((r) => r.getBoundingClientRect().top);
      dir = dir === 'to' ? 'from' : 'to';
      route.dataset.dir = dir;
      labelFrom();
      if (reduce) return;
      rows.forEach((r, i) => {
        const dy = before[i] - r.getBoundingClientRect().top;
        gsap.fromTo(r, { y: dy, opacity: 0.35 }, { y: 0, opacity: 1, duration: 0.7, ease: 'expo.out', clearProps: 'opacity,transform' });
      });
    });

    /* Passengers stepper + suggested vehicle */
    const renderPax = () => {
      paxOut.value = String(pax);
      paxOut.textContent = String(pax);
      paxInput.value = String(pax);
      paxBtns[0].disabled = pax <= 1;
      paxBtns[1].disabled = pax >= 20;
      const fit = fleet.find((v) => v.pax >= pax);
      paxHint.textContent = fit ? fit.name : '';
    };
    paxBtns.forEach((b) =>
      b.addEventListener('click', () => {
        pax = Math.min(20, Math.max(1, pax + Number(b.dataset.pax)));
        renderPax();
        if (!reduce) gsap.fromTo(paxOut, { yPercent: Number(b.dataset.pax) > 0 ? 40 : -40, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.45, ease: 'expo.out' });
      }),
    );
    renderPax();

    /* Submit → booking flow (URL contract) */
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const params = new URLSearchParams();
      params.set('type', type);
      const addr = fromInput.value.trim();
      let from = addr;
      let to = '';
      if (type === 'p2p') to = toInput.value.trim();
      if (type === 'airport') {
        if (dir === 'to') to = airportSel.value;
        else { from = airportSel.value; to = addr; }
      }
      if (from) params.set('from', from);
      if (to) params.set('to', to);
      // A chosen time makes the shown date (today by default) part of the request; otherwise the
      // date only travels if the guest picked one, and /book/ asks for whatever is missing.
      const time = timeInput.value;
      if (dateInput.value && (dateChosen || time)) params.set('date', dateInput.value);
      if (time) params.set('time', time);
      params.set('pax', String(pax));
      if (type === 'hourly') params.set('hours', hoursSel.value);
      window.location.href = `/book/?${params.toString()}`;
    });
  }
</script>
