---
// Services: pinned horizontal gallery on desktop, native snap carousel on touch / small screens.
import Icon from '../Icon.astro';
import { services, site, images, serviceHref } from '../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
// Card photography overrides. The shared chauffeur photo is unsuitable as a feature image, so Corporate gets
// the studio sedan; Events gets the low-lit black car (a night-out mood) instead of the daytime market sign.
// PLACEHOLDER until the client supplies their own vehicle / event photography.
const override: Record<string, { src: string; pos?: string }> = {
  corporate: { src: images.studioSedan, pos: '50% 62%' },
  events: { src: images.darkCar, pos: '88% 58%' },
};
const imageFor = (s: (typeof services)[number]) => override[s.slug]?.src ?? s.image;
const posFor = (s: (typeof services)[number]) => override[s.slug]?.pos;
// Kicker phrases render as unbreakable units so lines only wrap between phrases.
const phrases = (k: string) => k.split(' · ');
---
<section id="services" class="svc" data-svc aria-labelledby="svc-title">
  <div class="svc__pin" data-svc-pin>
    <div class="svc__track" data-svc-track>
      <header class="svc__head">
        <p class="eyebrow" data-reveal>Services</p>
        <h2 id="svc-title" data-split>Every journey, <em>orchestrated.</em></h2>
        <p class="lead" data-reveal data-delay="0.15">
          Six ways we move Seattle, each timed to the minute and handled by a dedicated chauffeur from first call to final door.
        </p>
        <div class="svc__head-foot" data-reveal data-delay="0.25">
          <span class="svc__hint" aria-hidden="true">
            <span class="svc__hint-line"></span>
            <span class="svc__hint-desk">Scroll to explore</span>
            <span class="svc__hint-mouse">Drag or use the arrows</span>
            <span class="svc__hint-touch">Swipe to explore</span>
          </span>
          <a href={site.phoneHref} class="svc__call">Or call {site.phone}</a>
        </div>
      </header>

      <div class="svc__cards" data-svc-cards>
        {services.map((s, i) => (
          <article class="svc-card" data-svc-card aria-labelledby={`svc-${s.slug}`}>
            <div class="svc-card__media">
              <span class="svc-card__img" data-svc-par>
                <img src={imageFor(s)} alt="" loading="lazy" decoding="async" width="900" height="1100" draggable="false" style={posFor(s) ? `object-position:${posFor(s)}` : undefined} />
              </span>
              <span class="svc-card__num" aria-hidden="true">{pad(i + 1)}</span>
            </div>
            <div class="svc-card__body">
              <p class="svc-card__kicker"><span class="svc-card__kicker-in">{phrases(s.kicker).map((k) => <span>{k}</span>)}</span></p>
              <h3 id={`svc-${s.slug}`} class="svc-card__title">{s.title}</h3>
              <p class="svc-card__blurb">{s.blurb}</p>
              <ul class="svc-card__points" role="list">
                {s.points.map((p) => (
                  <li><Icon name="check" /><span>{p}</span></li>
                ))}
              </ul>
              <div class="svc-card__foot">
                <a href={`/book/?type=${s.slug}`} class="svc-card__cta" aria-label={`Reserve ${s.title}`}>
                  <span>Reserve</span>
                  <span class="svc-card__cta-icon"><Icon name="arrow" /></span>
                </a>
                <a href={serviceHref(s)} class="svc-card__more">
                  <span>Explore<span class="sr-only"> {s.title}</span></span>
                  <Icon name="chevron-right" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="svc__progress">
      <span class="svc__count" aria-hidden="true"><b data-svc-cur>01</b><span class="svc__count-sep">/</span>{pad(services.length)}</span>
      <span class="svc__bar" aria-hidden="true"><span class="svc__bar-fill" data-svc-bar></span></span>
      <span class="svc__name" data-svc-name aria-hidden="true">{services[0].title}</span>
      <span class="svc__nav">
        <button type="button" class="svc__arrow" data-svc-prev aria-label="Previous service"><Icon name="arrow-left" /></button>
        <button type="button" class="svc__arrow" data-svc-next aria-label="Next service"><Icon name="arrow" /></button>
      </span>
    </div>
  </div>
</section>

<style>
  /* ---------- Base: native horizontal carousel (mobile, tablet, reduced motion) ---------- */
  .svc {
    position: relative;
    padding-block: var(--section-y);
    background: var(--bg);
  }
  .svc__pin { position: relative; isolation: isolate; }
  .svc__pin::before {
    content: '';
    position: absolute;
    left: 40%;
    top: 50%;
    width: 70vw;
    height: 60vh;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, var(--bg-3), transparent);
    pointer-events: none;
    z-index: -1;
  }
  :global([data-theme='dark']) .svc__pin::before { background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.07), transparent); }
  .svc__head {
    width: min(100% - var(--gutter) * 2, var(--container));
    margin: 0 auto clamp(2.2rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.3rem;
  }
  .svc__head .lead { max-width: 46ch; text-wrap: pretty; }
  .svc h2 :global(.split-line) { overflow: clip; }
  .svc__head-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.6rem; margin-top: 0.4rem; }
  .svc__hint { display: inline-flex; align-items: center; gap: 0.8rem; font-size: var(--fs-micro); font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-2); }
  .svc__hint-line { position: relative; width: 3.2rem; height: 1px; background: var(--line-strong); overflow: hidden; }
  .svc__hint-line::after { content: ''; position: absolute; inset: 0; background: var(--accent); transform: translateX(-100%); animation: svc-hint 2.6s var(--ease-in-out) infinite; }
  @keyframes svc-hint { 0% { transform: translateX(-100%); } 55%, 100% { transform: translateX(100%); } }
  .svc__hint-desk, .svc__hint-mouse { display: none; }
  /* Pointer users on the non-pinned carousel get arrow/drag copy instead of "swipe" */
  @media (hover: hover) and (pointer: fine) {
    .svc:not(.is-pinned) .svc__hint-touch { display: none; }
    .svc:not(.is-pinned) .svc__hint-mouse { display: inline; }
    .svc:not(.is-pinned) .svc__cards { cursor: grab; }
    .svc:not(.is-pinned) .svc__cards.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
    .svc__cards.is-dragging .svc-card { pointer-events: none; }
  }
  .svc__call { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.86rem; color: var(--muted); border-bottom: 1px solid transparent; transition: color 0.3s; }
  .svc__call:hover { color: var(--accent-2); }

  .svc__cards {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding-inline: max(var(--gutter), (100% - var(--container)) / 2);
    scroll-padding-inline: max(var(--gutter), (100% - var(--container)) / 2);
    padding-bottom: 0.5rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .svc__cards::-webkit-scrollbar { display: none; }

  .svc-card {
    position: relative;
    flex: 0 0 min(82vw, 400px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 24px 50px -34px rgb(var(--fg-rgb) / 0.3);
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .svc-card:hover { border-color: rgb(var(--accent-rgb) / 0.38); box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 30px 60px -32px rgb(var(--fg-rgb) / 0.38); }
  /* Onyx: depth comes from the surface step, not a cast shadow (an ivory shadow would glow) */
  :global([data-theme='dark']) .svc-card,
  :global([data-theme='dark']) .svc-card:hover { box-shadow: none; }
  /* bg-4 reads as an image slot while the hotlinked photo loads; Ivory gets a crisp hairline edge */
  .svc-card__media {
    position: relative;
    aspect-ratio: 4 / 3.3;
    overflow: hidden;
    background: var(--bg-4);
    border-bottom: 1px solid var(--line);
    flex: none;
  }
  :global([data-theme='dark']) .svc-card__media { border-bottom-color: transparent; }
  /* Wrapper carries the scroll parallax (GSAP); the img keeps its own scale so hover zoom still works */
  .svc-card__img {
    position: absolute;
    top: 0;
    left: -8%;
    width: 116%;
    height: 100%;
  }
  .svc-card__img img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: scale(1.04);
    transition: transform 1.4s var(--ease-out), filter 1.2s var(--ease-out);
    filter: saturate(0.94);
    -webkit-user-drag: none;
  }
  :global([data-theme='dark']) .svc-card__img img { filter: saturate(0.9) brightness(0.9); }
  .svc-card:hover .svc-card__img img,
  :global([data-theme='dark']) .svc-card:hover .svc-card__img img { transform: scale(1.1); filter: saturate(1) brightness(1); }
  /* Onyx only: a short fade into the card's own surface. Ivory keeps the photo crisp (a fade to ivory hazes it). */
  :global([data-theme='dark']) .svc-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--bg-3) 0%, transparent 26%);
    pointer-events: none;
  }
  /* Index: a small frosted tab, not a giant outlined numeral */
  .svc-card__num {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    display: inline-grid;
    place-items: center;
    height: 1.9rem;
    padding: 0 0.6rem 0 0.72rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--text-2);
    transition: color 0.6s var(--ease-out), border-color 0.6s var(--ease-out);
  }
  .svc-card:hover .svc-card__num { color: var(--accent); border-color: rgb(var(--accent-rgb) / 0.4); }

  .svc-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.4rem clamp(1.25rem, 2vw, 1.75rem) clamp(1.25rem, 2vw, 1.6rem);
    flex: 1;
  }
  .svc-card__kicker { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); }
  /* Two-line kicker slot, bottom-aligned: every title shares one line even when a kicker wraps */
  .svc-card__kicker { display: flex; align-items: flex-end; min-height: 3.2em; line-height: 1.6; overflow: hidden; }
  /* Phrases never break internally. Each carries its separator in a 1.5em lead-in; the row is shifted
     left by that amount and clipped, so the dot is hidden on whichever phrase starts a line. */
  .svc-card__kicker-in { flex: 1 1 auto; min-width: 0; display: flex; flex-wrap: wrap; margin-left: -1.5em; }
  .svc-card__kicker-in > span { position: relative; padding-left: 1.5em; white-space: nowrap; }
  .svc-card__kicker-in > span::before {
    content: '·';
    content: '·' / '';
    position: absolute;
    left: 0;
    width: 1.5em;
    text-align: center;
    opacity: 0.7;
  }
  .svc-card__title { font-size: clamp(1.6rem, 2.1vw, 1.95rem); line-height: 1.08; letter-spacing: -0.03em; text-wrap: balance; }
  .svc-card__blurb { font-size: 0.9rem; line-height: 1.6; color: var(--muted); }
  .svc-card__points { display: grid; gap: 0.45rem; padding: 0.9rem 0 0; margin: 0.1rem 0 0; border-top: 1px solid var(--line); list-style: none; }
  .svc-card__points li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.84rem; line-height: 1.4; color: var(--text-2); }
  .svc-card__points :global(svg) { width: 15px; height: 15px; flex: none; color: var(--accent); margin-top: 0.12em; stroke-width: 2; }

  .svc-card__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .svc-card__cta {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding: 0.35rem 0.35rem 0.35rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
    transition: border-color 0.5s var(--ease-out), background 0.5s var(--ease-out), color 0.5s var(--ease-out);
  }
  /* Stretch the link so the whole card is tappable */
  .svc-card__cta::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .svc-card__cta-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--cta-bg);
    color: var(--cta-fg);
    transition: transform 0.6s var(--ease-out);
  }
  .svc-card__cta-icon :global(svg) { width: 16px; height: 16px; }
  .svc-card:hover:not(:has(.svc-card__more:hover)) .svc-card__cta { border-color: rgb(var(--accent-rgb) / 0.55); background: rgb(var(--accent-rgb) / 0.08); color: var(--accent-2); }
  .svc-card:hover:not(:has(.svc-card__more:hover)) .svc-card__cta-icon { transform: rotate(-45deg); }
  .svc-card__cta:focus-visible { outline-offset: 4px; }

  /* Secondary: the service's own page. Sits above the stretched Reserve overlay. */
  .svc-card__more {
    position: relative;
    z-index: 3;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 52px;
    padding-inline: 0.35rem 0.15rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: color 0.4s var(--ease-out);
  }
  .svc-card__more > span { position: relative; }
  .svc-card__more > span::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
    transform-origin: left;
    transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .svc-card__more :global(svg) { width: 15px; height: 15px; color: var(--accent); transition: transform 0.5s var(--ease-out); }
  .svc-card__more:hover { color: var(--accent); }
  .svc-card__more:hover > span::after { opacity: 1; }
  .svc-card__more:hover :global(svg) { transform: translateX(3px); }
  .svc-card__more:focus-visible { outline-offset: 2px; border-radius: var(--radius-s); }

  /* Progress */
  .svc__progress {
    width: min(100% - var(--gutter) * 2, var(--container));
    margin: clamp(1.4rem, 3vw, 2rem) auto 0;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.2rem;
  }
  .svc__count { font-family: var(--font-display); font-size: 1.2rem; color: var(--muted); font-variant-numeric: lining-nums tabular-nums; white-space: nowrap; }
  .svc__count b { font-weight: 500; color: var(--text); }
  .svc__count-sep { margin-inline: 0.4em; color: var(--accent); opacity: 0.8; }
  .svc__bar { position: relative; height: 1px; background: var(--line-strong); overflow: hidden; }
  .svc__bar-fill { position: absolute; inset: 0; background: var(--accent-grad); transform-origin: left; transform: scaleX(0.1667); }
  .svc__name { display: none; }
  .svc__progress { grid-template-columns: auto 1fr auto; }
  .svc__nav { display: inline-flex; gap: 0.5rem; }
  .svc__arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text);
    transition: border-color 0.4s var(--ease-out), color 0.4s var(--ease-out), background 0.4s var(--ease-out), opacity 0.3s;
  }
  .svc__arrow :global(svg) { width: 17px; height: 17px; }
  .svc__arrow:hover { border-color: var(--accent); color: var(--accent-2); background: rgb(var(--accent-rgb) / 0.08); }
  .svc__arrow:disabled { opacity: 0.35; pointer-events: none; }
  @media (max-width: 599px) { .svc__nav { display: none; } .svc__progress { grid-template-columns: auto 1fr; } }

  /* ---------- Desktop pinned horizontal gallery (class added by JS) ---------- */
  .svc.is-pinned { padding-block: 0; }
  /* Vertical budget: the header (it can slide back in while pinned) + a hairline of air on top, the
     progress row at the bottom. Cards fill what is left, capped at 680px. */
  .svc.is-pinned .svc__pin {
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-h) + 0.75rem);
    padding-bottom: 5.2rem;
  }
  .svc.is-pinned .svc__track {
    display: flex;
    align-items: center;
    width: max-content;
    padding-left: max(var(--gutter), (100vw - var(--container)) / 2);
    padding-right: max(var(--gutter), (100vw - var(--container)) / 2);
    will-change: transform;
  }
  .svc.is-pinned .svc__head {
    width: clamp(380px, 33vw, 500px);
    margin: 0 clamp(3rem, 6vw, 7rem) 0 0;
    flex: none;
  }
  .svc.is-pinned .svc__hint-desk { display: inline; }
  .svc.is-pinned .svc__hint-touch { display: none; }
  .svc.is-pinned .svc__cards {
    overflow: visible;
    padding: 0;
    gap: clamp(1.25rem, 1.8vw, 2rem);
    scroll-snap-type: none;
  }
  .svc.is-pinned .svc-card {
    --svc-card-h: min(calc(100svh - var(--header-h) - 0.75rem - 5.2rem - 1rem), 680px);
    flex: 0 0 clamp(340px, 27vw, 410px);
    height: var(--svc-card-h);
  }
  /* Fixed image height (same on every card) so kicker + title share one top line;
     points + CTA are anchored to the bottom of the card. 26rem is the tallest body (blurb included). */
  .svc.is-pinned .svc-card__media {
    aspect-ratio: auto;
    flex: none;
    height: max(180px, calc(var(--svc-card-h) - 26rem));
    min-height: 0;
  }
  .svc.is-pinned .svc-card__title { font-size: clamp(1.5rem, 1.85vw, 1.85rem); }
  .svc.is-pinned .svc-card__body { gap: 0.7rem; }
  .svc.is-pinned .svc-card__points { margin-top: auto; }
  @media (max-width: 1199px) {
    /* Narrower pinned cards: keep the longest kicker on one line */
    .svc.is-pinned .svc-card__kicker { font-size: 0.62rem; letter-spacing: 0.12em; }
  }
  .svc.is-pinned .svc-card__foot { margin-top: 0.35rem; }
  .svc.is-pinned .svc__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2.1rem;
    margin: 0 auto;
    grid-template-columns: auto 1fr 17rem;
    gap: 1.6rem;
  }
  .svc.is-pinned .svc__nav { display: none; }
  .svc.is-pinned .svc__name {
    display: block;
    min-width: 0;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-2);
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .svc-card { flex-basis: 380px; }
  }
  /* Laptop heights (e.g. 1440x789, 1280x720): drop the blurb entirely rather than truncate it mid-word.
     The kicker, title and points still carry the service, and the photo keeps a generous slot. */
  @media (max-height: 820px) {
    .svc.is-pinned .svc__pin { padding-bottom: 4.5rem; }
    .svc.is-pinned .svc__progress { bottom: 1.6rem; }
    .svc.is-pinned .svc-card { --svc-card-h: min(calc(100svh - var(--header-h) - 0.75rem - 4.5rem - 1rem), 680px); }
    .svc.is-pinned .svc-card__blurb { display: none; }
    .svc.is-pinned .svc-card__media { height: max(180px, calc(var(--svc-card-h) - 19.5rem)); }
  }
  /* Short laptops (1366x657, 1280x689): tighten the chrome around the card, never the photo below 180px */
  @media (max-height: 700px) {
    .svc.is-pinned .svc__pin { padding-top: calc(var(--header-h) + 0.5rem); padding-bottom: 4rem; }
    .svc.is-pinned .svc__progress { bottom: 1.25rem; }
    .svc.is-pinned .svc-card { --svc-card-h: calc(100svh - var(--header-h) - 0.5rem - 4rem - 0.75rem); }
    .svc.is-pinned .svc-card__body { gap: 0.6rem; }
    .svc.is-pinned .svc-card__points { gap: 0.3rem; padding-top: 0.75rem; }
    .svc.is-pinned .svc-card__cta,
    .svc.is-pinned .svc-card__more { min-height: 46px; }
    .svc.is-pinned .svc-card__cta-icon { width: 38px; height: 38px; }
    .svc.is-pinned .svc-card__media { height: max(180px, calc(var(--svc-card-h) - 18.25rem)); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-svc]');
  if (root) {
    const pin = root.querySelector<HTMLElement>('[data-svc-pin]')!;
    const track = root.querySelector<HTMLElement>('[data-svc-track]')!;
    const scroller = root.querySelector<HTMLElement>('[data-svc-cards]')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-card]'));
    const bar = root.querySelector<HTMLElement>('[data-svc-bar]')!;
    const cur = root.querySelector<HTMLElement>('[data-svc-cur]')!;
    const nameEl = root.querySelector<HTMLElement>('[data-svc-name]')!;
    const titles = cards.map((c) => c.querySelector('h3')?.textContent || '');
    const total = cards.length;

    let index = -1;
    const setIndex = (i: number) => {
      i = Math.max(0, Math.min(total - 1, i));
      if (i === index) return;
      index = i;
      cur.textContent = String(i + 1).padStart(2, '0');
      nameEl.textContent = titles[i];
    };
    const setProgress = (p: number) => { bar.style.transform = `scaleX(${Math.max(1 / total, p)})`; };
    setIndex(0);

    // The active card is the one nearest a reference line, not a share of progress: the header panel
    // scrolls with the cards, so progress alone runs a card ahead. Centres are layout offsets within the
    // track (rect deltas cancel the GSAP transform) and are re-measured on every ScrollTrigger refresh.
    let centres: number[] = [];
    const measure = () => {
      const left = track.getBoundingClientRect().left;
      centres = cards.map((c) => { const r = c.getBoundingClientRect(); return r.left - left + r.width / 2; });
    };
    const nearest = (pos: number, points: number[]) => {
      let best = 0;
      let bestD = Infinity;
      points.forEach((c, i) => { const d = Math.abs(c - pos); if (d < bestD) { bestD = d; best = i; } });
      return best;
    };

    // Carousel arrows (non-pinned layouts)
    const prev = root.querySelector<HTMLButtonElement>('[data-svc-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-svc-next]')!;
    const step = (dir: number) => {
      const gap = parseFloat(getComputedStyle(scroller).columnGap) || 16;
      scroller.scrollBy({ left: dir * (cards[0].offsetWidth + gap), behavior: 'smooth' });
    };
    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    const syncArrows = () => {
      const max = scroller.scrollWidth - scroller.clientWidth - 2;
      prev.disabled = scroller.scrollLeft <= 2;
      next.disabled = scroller.scrollLeft >= max;
    };
    syncArrows();

    // Mouse drag-to-scroll for the non-pinned carousel (touch keeps native swipe)
    let drag: { x: number; left: number; moved: boolean } | null = null;
    const blockClick = (ev: Event) => { ev.preventDefault(); ev.stopPropagation(); };
    scroller.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0 || root.classList.contains('is-pinned')) return;
      drag = { x: e.clientX, left: scroller.scrollLeft, moved: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (!drag.moved) {
        if (Math.abs(dx) < 6) return;
        drag.moved = true;
        scroller.classList.add('is-dragging');
      }
      scroller.scrollLeft = drag.left - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!drag) return;
      const moved = drag.moved;
      drag = null;
      if (!moved) return;
      // Settle on the nearest card, then restore snapping
      const padL = parseFloat(getComputedStyle(scroller).paddingLeft) || 0;
      const base = scroller.getBoundingClientRect().left + padL;
      let target = scroller.scrollLeft;
      let best = Infinity;
      cards.forEach((c) => {
        const d = c.getBoundingClientRect().left - base;
        if (Math.abs(d) < best) { best = Math.abs(d); target = scroller.scrollLeft + d; }
      });
      scroller.scrollTo({ left: target, behavior: 'smooth' });
      window.setTimeout(() => scroller.classList.remove('is-dragging'), 450);
      scroller.addEventListener('click', blockClick, { capture: true, once: true });
      window.setTimeout(() => scroller.removeEventListener('click', blockClick, { capture: true }), 60);
    });

    // Native carousel progress (mobile / tablet / reduced motion)
    let raf = 0;
    scroller.addEventListener('scroll', () => {
      if (root.classList.contains('is-pinned')) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const max = scroller.scrollWidth - scroller.clientWidth;
        const p = max > 0 ? scroller.scrollLeft / max : 0;
        setProgress(p);
        // Active = the card sitting at the snap line; at the very end the last card is the one in view.
        if (max > 0 && scroller.scrollLeft >= max - 2) setIndex(total - 1);
        else {
          const padL = parseFloat(getComputedStyle(scroller).scrollPaddingLeft) || parseFloat(getComputedStyle(scroller).paddingLeft) || 0;
          const base = scroller.getBoundingClientRect().left + padL;
          setIndex(nearest(0, cards.map((c) => c.getBoundingClientRect().left - base)));
        }
        syncArrows();
      });
    }, { passive: true });

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px) and (min-height: 620px) and (prefers-reduced-motion: no-preference)', () => {
      root.classList.add('is-pinned');
      scroller.scrollLeft = 0;
      const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
      // Reference line, in track coordinates, for a track offset x: the viewport centre, easing over the
      // final card pitch of travel onto the last card (which can never reach the centre), so 05 and 06
      // each get a fair share of the scroll instead of 06 appearing only in the last few pixels.
      const refAt = (x: number) => {
        const d = distance();
        const vw = window.innerWidth;
        const last = centres[total - 1] ?? 0;
        const pitch = total > 1 ? Math.max(1, last - centres[total - 2]) : 1;
        const t = gsap.utils.clamp(0, 1, (x - (d - pitch)) / pitch);
        return x + vw / 2 + t * (last - d - vw / 2);
      };
      // Inverse of refAt (it is monotonic): the track offset at which card i sits on the reference line.
      const offsetFor = (i: number) => {
        let lo = 0;
        let hi = distance();
        for (let k = 0; k < 24; k++) {
          const mid = (lo + hi) / 2;
          if (refAt(mid) < centres[i]) lo = mid; else hi = mid;
        }
        return hi;
      };

      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        // Bar = raw (scrubbed) progress. Counter = the card nearest the reference line at the track's
        // current offset (x = progress * distance, the same maths as the focus handler below).
        onUpdate() {
          const p = this.progress();
          setProgress(p);
          if (!centres.length) measure();
          setIndex(p > 0.995 ? total - 1 : nearest(refAt(p * distance()), centres));
        },
        scrollTrigger: {
          trigger: pin,
          start: 'top top',
          end: () => '+=' + distance(),
          pin: true,
          scrub: 0.9,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onRefresh: measure,
        },
      });
      measure();

      cards.forEach((card) => {
        const par = card.querySelector<HTMLElement>('[data-svc-par]');
        if (!par) return;
        gsap.fromTo(par, { xPercent: 5 }, {
          xPercent: -5,
          ease: 'none',
          scrollTrigger: { trigger: card, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true },
        });
      });

      // Keyboard focus: the browser would scroll the overflow:hidden pin sideways on top of the
      // GSAP transform. Keep the pin at scrollLeft 0 and instead move the page so the focused card
      // is scrubbed onto the reference line (the viewport centre, or as close as the track allows),
      // which also makes it the active card in the counter.
      const resetPinScroll = () => {
        if (pin.scrollLeft) pin.scrollLeft = 0;
        if (pin.scrollTop) pin.scrollTop = 0;
      };
      let focusRaf = 0;
      const onFocusIn = (e: FocusEvent) => {
        if (!root.classList.contains('is-pinned')) return;
        const st = tween.scrollTrigger;
        const d = distance();
        if (!st || !d) return;
        const card = (e.target as HTMLElement).closest<HTMLElement>('[data-svc-card]');
        if (!centres.length) measure();
        const i = card ? cards.indexOf(card) : -1;
        const x = i >= 0 ? offsetFor(i) : 0;
        const y = st.start + (x / d) * (st.end - st.start);
        cancelAnimationFrame(focusRaf);
        // Run after the browser's own focus scroll so ours wins
        focusRaf = requestAnimationFrame(() => {
          resetPinScroll();
          if (window.lenis) window.lenis.scrollTo(y, { immediate: true, force: true });
          else window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
        });
      };
      pin.addEventListener('scroll', resetPinScroll);
      root.addEventListener('focusin', onFocusIn);

      return () => {
        pin.removeEventListener('scroll', resetPinScroll);
        root.removeEventListener('focusin', onFocusIn);
        cancelAnimationFrame(focusRaf);
        resetPinScroll();
        root.classList.remove('is-pinned');
        centres = [];
        gsap.set(track, { clearProps: 'transform' });
        setProgress(0);
        setIndex(0);
      };
    });
  }
</script>
