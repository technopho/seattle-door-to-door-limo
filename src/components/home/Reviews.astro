---
import Icon from '../Icon.astro';
import { site, ratings, testimonials } from '../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const total = testimonials.length;
---
<section id="reviews" class="section rv" aria-labelledby="reviews-title">
  <div class="rv__glow" aria-hidden="true"></div>
  <div class="container rv__grid">
    <!-- Score column -->
    <div class="rv__score">
      <p class="eyebrow" data-reveal="fade">Client Reviews</p>
      <h2 id="reviews-title" class="sr-only">Rated {site.rating.score} out of 5 from {site.rating.count} five-star reviews</h2>

      <div class="rv__big" data-reveal aria-hidden="true">
        <span class="rv__num" data-rv-score data-value={site.rating.score}>{site.rating.score}</span>
        <span class="rv__outof">/5</span>
      </div>

      <div class="rv__meta" data-reveal data-delay="0.1">
        <span class="rv__stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" />)}
        </span>
        <p class="rv__count"><strong>{site.rating.count}</strong> five-star reviews</p>
      </div>

      <ul class="rv__platforms" role="list" data-stagger="0.08">
        {ratings.map((r) => (
          <li class="rv__plat">
            <span class="rv__plat-name">{r.platform}</span>
            <span class="rv__plat-score">{r.score}</span>
            <span class="rv__plat-stars" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => <Icon name="star" />)}
            </span>
            <span class="rv__plat-count">{r.count}<span class="sr-only"> on {r.platform}, rated {r.score} out of 5</span></span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Testimonial slider -->
    <div
      class="rv__slider"
      role="region"
      aria-roledescription="carousel"
      aria-label="Client testimonials"
      data-rv
      data-reveal
      data-delay="0.1"
    >
      <span class="rv__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <defs>
            <linearGradient id="rv-gold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#a5844a" /><stop offset="0.45" stop-color="#e8d3a2" /><stop offset="0.7" stop-color="#c9a86a" /><stop offset="1" stop-color="#8f7040" />
            </linearGradient>
          </defs>
          <path fill="url(#rv-gold)" d="M4 18.5V13c0-4.4 2.2-7.6 6-9l1 1.7C8.8 7 7.7 8.8 7.6 11H11v7.5zm9 0V13c0-4.4 2.2-7.6 6-9l1 1.7c-2.2 1.3-3.3 3.1-3.4 5.3H20v7.5z" />
        </svg>
      </span>

      <div class="rv__slides" aria-live="polite" aria-atomic="false" data-cursor="Drag" data-rv-track>
        {testimonials.map((t, i) => (
          <figure
            class:list={['rv__slide', i === 0 && 'is-active']}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-rv-slide={i}
          >
            <blockquote class="rv__quote">
              <p data-rv-text>{t.quote}</p>
            </blockquote>
            <figcaption class="rv__by" data-rv-by>
              <span class="rv__line" aria-hidden="true"></span>
              <span class="rv__who">
                <span class="rv__name">{t.name}</span>
                <span class="rv__ctx">{t.context}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="rv__controls">
        <div class="rv__progress-wrap">
          <span class="rv__counter" aria-hidden="true"><span data-rv-current>01</span><span class="rv__counter-of"> / {pad(total)}</span></span>
          <span class="rv__progress" aria-hidden="true"><span class="rv__bar" data-rv-bar></span></span>
        </div>
        <div class="rv__btns">
          <button type="button" class="rv__btn" aria-label="Previous testimonial" data-rv-prev><Icon name="arrow-left" /></button>
          <button type="button" class="rv__btn rv__btn--pause" aria-label="Pause autoplay" aria-pressed="false" data-rv-pause>
            <svg class="rv__ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <svg class="rv__ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 6.2v11.6L18 12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="rv__btn" aria-label="Next testimonial" data-rv-next><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rv { background: var(--ink-2); overflow: clip; border-top: 1px solid var(--line); }
  .rv__glow {
    position: absolute; pointer-events: none;
    width: min(900px, 120vw); aspect-ratio: 1;
    right: -20%; top: -30%;
    background: radial-gradient(closest-side, rgba(201, 168, 106, 0.12), rgba(201, 168, 106, 0) 70%);
  }
  .rv__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.5fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  /* ---------- Score ---------- */
  .rv__score { display: grid; gap: 1.3rem; align-content: start; }
  .rv__big { display: flex; align-items: flex-start; gap: 0.4rem; margin-top: 0.4rem; }
  .rv__num {
    font-family: var(--font-display);
    font-size: clamp(7.5rem, 13vw, 12.5rem);
    line-height: 0.78;
    letter-spacing: -0.04em;
    color: var(--ivory);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .rv__outof {
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
    margin-top: 0.3em;
  }
  .rv__meta { display: grid; gap: 0.6rem; }
  .rv__stars { display: inline-flex; gap: 4px; color: var(--gold); }
  .rv__stars :global(svg) { width: 20px; height: 20px; }
  .rv__count { font-size: 0.95rem; color: var(--ivory-2); letter-spacing: 0.02em; }
  .rv__count strong { color: var(--ivory); font-weight: 700; }

  .rv__platforms { display: grid; margin-top: 1.4rem; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .rv__plat {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'name score stars' 'name count count';
    align-items: center;
    column-gap: 0.9rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .rv__plat-name { grid-area: name; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ivory-2); }
  .rv__plat-score { grid-area: score; font-family: var(--font-display); font-size: 1.9rem; line-height: 1; color: var(--ivory); font-variant-numeric: lining-nums; }
  .rv__plat-stars { grid-area: stars; display: inline-flex; gap: 2px; color: var(--gold); }
  .rv__plat-stars :global(svg) { width: 12px; height: 12px; }
  .rv__plat-count { grid-area: count; justify-self: end; font-size: 0.75rem; color: var(--muted); letter-spacing: 0.04em; }

  /* ---------- Slider ---------- */
  .rv__slider {
    position: relative;
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    padding-left: clamp(0rem, 4vw, 4rem);
    border-left: 1px solid var(--line);
    min-width: 0;
  }
  .rv__mark { display: block; width: clamp(48px, 5vw, 72px); color: var(--gold); }
  .rv__mark svg { width: 100%; height: auto; }

  .rv__slides { display: grid; touch-action: pan-y; user-select: none; -webkit-user-select: none; cursor: grab; }
  .rv__slides:active { cursor: grabbing; }
  .rv__slide { grid-area: 1 / 1; margin: 0; display: grid; gap: clamp(1.6rem, 3vw, 2.4rem); align-content: start; visibility: hidden; opacity: 0; will-change: transform; }
  .rv__slide.is-active { visibility: visible; opacity: 1; }
  .rv__quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.7rem, 3.1vw, 3rem);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--ivory);
    text-wrap: pretty;
    max-width: 22em;
  }
  .rv__quote :global(.rv-w) { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .rv__quote :global(.rv-w > span) { display: inline-block; will-change: transform; }
  .rv__by { display: flex; align-items: center; gap: 1rem; }
  .rv__line { width: 2.6rem; height: 1px; background: var(--gold-grad); }
  .rv__who { display: grid; gap: 0.15rem; }
  .rv__name { font-weight: 700; font-size: 0.95rem; color: var(--ivory); letter-spacing: 0.02em; }
  .rv__ctx { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }

  .rv__controls { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .rv__progress-wrap { display: flex; align-items: center; gap: 1.1rem; flex: 1; min-width: 0; }
  .rv__counter { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; color: var(--ivory); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rv__counter-of { color: var(--muted-2); }
  .rv__progress { position: relative; flex: 1; height: 1px; background: var(--line-strong); overflow: hidden; }
  .rv__bar { position: absolute; inset: 0; background: var(--gold-grad); transform: scaleX(0); transform-origin: left; }
  .rv__btns { display: flex; gap: 0.6rem; }
  .rv__btn {
    display: grid; place-items: center;
    width: 52px; height: 52px; border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ivory);
    transition: border-color 0.4s var(--ease-out), background 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .rv__btn :global(svg) { width: 18px; height: 18px; }
  .rv__btn:hover { border-color: var(--gold); color: #17130b; background: var(--gold-2); }
  .rv__btn--pause { width: 44px; height: 44px; align-self: center; color: var(--muted); }
  .rv__btn--pause .rv__ico-play { display: none; }
  .rv__btn--pause[aria-pressed='true'] .rv__ico-pause { display: none; }
  .rv__btn--pause[aria-pressed='true'] .rv__ico-play { display: block; }

  @media (max-width: 960px) {
    .rv__grid { grid-template-columns: 1fr; gap: 3.5rem; }
    .rv__slider { border-left: 0; padding-left: 0; padding-top: 3rem; border-top: 1px solid var(--line); }
    .rv__score { grid-template-columns: auto 1fr; align-items: end; column-gap: 1.6rem; }
    .rv__score > .eyebrow, .rv__platforms { grid-column: 1 / -1; }
    .rv__meta { padding-bottom: 0.6rem; }
    .rv__platforms { grid-template-columns: repeat(3, 1fr); border-top: 0; margin-top: 0.6rem; gap: 0.6rem; }
    .rv__plat {
      grid-template-columns: 1fr; grid-template-areas: 'name' 'score' 'stars' 'count';
      row-gap: 0.4rem; padding: 1rem 0.9rem; border: 1px solid var(--line); border-radius: var(--radius-s);
      background: rgba(255, 255, 255, 0.015);
    }
    .rv__plat-count { justify-self: start; }
    .rv__plat-name { font-size: 0.64rem; letter-spacing: 0.2em; }
    .rv__quote p { font-size: clamp(1.9rem, 4.6vw, 2.6rem); }
  }
  @media (max-width: 560px) {
    .rv__score { grid-template-columns: 1fr; }
    .rv__big { margin-top: 0; }
    .rv__num { font-size: 7.4rem; }
    .rv__plat { padding: 0.85rem 0.7rem; }
    .rv__plat-score { font-size: 1.6rem; }
    .rv__plat-count { font-size: 0.68rem; }
    .rv__controls { flex-wrap: wrap; }
    .rv__quote p { font-size: clamp(1.65rem, 7.2vw, 1.9rem); }
    .rv__btn { width: 48px; height: 48px; }
    .rv__btn--pause { width: 44px; height: 44px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DURATION = 7;

  /* ---------- Score count-up ---------- */
  const scoreEl = document.querySelector<HTMLElement>('[data-rv-score]');
  // Counts up from 4.0 only, so a low rating never flashes next to the five stars.
  if (scoreEl && !reduce) {
    const end = Number(scoreEl.dataset.value || '4.9');
    const startAt = Math.min(4, end);
    scoreEl.textContent = startAt.toFixed(1);
    ScrollTrigger.create({
      trigger: scoreEl,
      start: 'top 90%',
      once: true,
      onEnter: () => {
        const o = { v: startAt };
        gsap.to(o, { v: end, duration: 1.4, ease: 'expo.out', onUpdate: () => { scoreEl.textContent = o.v.toFixed(1); } });
      },
    });
  }

  /* ---------- Slider ---------- */
  const root = document.querySelector<HTMLElement>('[data-rv]');
  if (root) initSlider(root);

  function initSlider(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-rv-track]')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-rv-slide]'));
    const bar = root.querySelector<HTMLElement>('[data-rv-bar]')!;
    const counter = root.querySelector<HTMLElement>('[data-rv-current]')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-rv-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-rv-next]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-rv-pause]')!;
    const n = slides.length;
    let current = 0;
    let hover = false;
    let focusWithin = false;
    let inView = false;
    let userPaused = reduce; // no autoplay under reduced motion
    let progress: gsap.core.Tween | null = null;

    if (reduce) { pauseBtn.setAttribute('aria-pressed', 'true'); pauseBtn.setAttribute('aria-label', 'Start autoplay'); }

    // Split each quote into masked words for the reveal.
    const words: HTMLElement[][] = slides.map((s) => {
      const p = s.querySelector<HTMLElement>('[data-rv-text]')!;
      const text = p.textContent || '';
      p.textContent = '';
      const sr = document.createElement('span');
      sr.className = 'sr-only';
      sr.textContent = text;
      p.appendChild(sr);
      const list: HTMLElement[] = [];
      text.split(/\s+/).filter(Boolean).forEach((w, i, arr) => {
        const mask = document.createElement('span');
        mask.className = 'rv-w';
        mask.setAttribute('aria-hidden', 'true');
        const inner = document.createElement('span');
        inner.textContent = w;
        mask.appendChild(inner);
        p.appendChild(mask);
        if (i < arr.length - 1) p.appendChild(document.createTextNode(' '));
        list.push(inner);
      });
      return list;
    });
    const bys = slides.map((s) => s.querySelector<HTMLElement>('[data-rv-by]')!);

    const pad = (v: number) => String(v).padStart(2, '0');

    function show(i: number, dir: number, auto = false) {
      i = (i + n) % n;
      if (i === current) return;
      track.setAttribute('aria-live', auto ? 'off' : 'polite');
      const prev = slides[current];
      const next = slides[i];
      const prevIdx = current;
      current = i;
      counter.textContent = pad(i + 1);

      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === i);
        if (k === i) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
      });

      if (reduce) {
        gsap.set(slides, { clearProps: 'opacity,visibility' });
      } else {
        gsap.killTweensOf([prev, next, ...words[prevIdx], ...words[i], bys[i], bys[prevIdx]]);
        // Outgoing: words lift away, slide fades (and settles back from any drag offset).
        gsap.set(prev, { visibility: 'visible', opacity: 1 });
        gsap.to(prev, { x: 0, duration: 0.8, ease: 'expo.out' });
        gsap.to(words[prevIdx], { yPercent: -110 * dir, duration: 0.5, ease: 'power3.in', stagger: 0.006 });
        gsap.to(bys[prevIdx], { opacity: 0, y: -10, duration: 0.4, ease: 'power2.in' });
        gsap.to(prev, {
          opacity: 0, duration: 0.3, delay: 0.4, ease: 'none',
          onComplete: () => {
            if (slides[current] !== prev) gsap.set(prev, { visibility: 'hidden' });
            gsap.set(words[prevIdx], { yPercent: 0 });
          },
        });
        // Incoming: masked word-by-word rise.
        gsap.set(next, { visibility: 'visible', opacity: 1, x: 0 });
        gsap.fromTo(words[i], { yPercent: 110 * dir, rotate: 2 * dir }, { yPercent: 0, rotate: 0, duration: 1.15, ease: 'expo.out', stagger: 0.022, delay: 0.42 });
        gsap.fromTo(bys[i], { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 1, ease: 'expo.out', delay: 0.75 });
      }
      restartProgress();
    }

    function shouldPlay() {
      return !userPaused && !hover && !focusWithin && inView && document.visibilityState === 'visible';
    }

    function restartProgress() {
      progress?.kill();
      gsap.set(bar, { scaleX: 0 });
      if (userPaused) return;
      progress = gsap.to(bar, { scaleX: 1, duration: DURATION, ease: 'none', paused: true, onComplete: () => show(current + 1, 1, true) });
      syncPlay();
    }

    function syncPlay() {
      if (!progress) { if (!userPaused) restartProgress(); return; }
      if (shouldPlay()) progress.play(); else progress.pause();
    }

    prevBtn.addEventListener('click', () => show(current - 1, -1));
    nextBtn.addEventListener('click', () => show(current + 1, 1));
    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.setAttribute('aria-pressed', userPaused ? 'true' : 'false');
      pauseBtn.setAttribute('aria-label', userPaused ? 'Start autoplay' : 'Pause autoplay');
      if (userPaused) { progress?.kill(); progress = null; gsap.to(bar, { scaleX: 0, duration: 0.6, ease: 'expo.out' }); }
      else restartProgress();
    });

    root.addEventListener('mouseenter', () => { hover = true; syncPlay(); });
    root.addEventListener('mouseleave', () => { hover = false; syncPlay(); });
    root.addEventListener('focusin', (e) => { const t = e.target as HTMLElement; focusWithin = !!t.matches?.(':focus-visible'); syncPlay(); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) { focusWithin = false; syncPlay(); } });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1, -1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1, 1); }
    });
    document.addEventListener('visibilitychange', syncPlay);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { inView = entries[0].isIntersecting; syncPlay(); }, { threshold: 0.35 }).observe(root);
    } else inView = true;

    // Swipe / drag: the active quote follows the pointer with rubber-band resistance, then
    // either hands over to the next slide or springs back.
    let startX = 0, startY = 0, dragging = false, pid = -1;
    let dragSlide: HTMLElement | null = null;
    let xTo: ((v: number) => void) | null = null;
    const MAX_PULL = 80;
    const resist = (dx: number) => MAX_PULL * Math.tanh(dx / 220);
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true; pid = e.pointerId; startX = e.clientX; startY = e.clientY;
      if (!reduce) {
        dragSlide = slides[current];
        gsap.killTweensOf(dragSlide, 'x');
        xTo = gsap.quickTo(dragSlide, 'x', { duration: 0.4, ease: 'expo.out' });
      }
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging || e.pointerId !== pid || !xTo) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dy) > Math.abs(dx) && Math.abs(dx) < 10) return; // vertical intent: leave it to scrolling
      xTo(resist(dx));
    }, { passive: true });
    const release = () => {
      if (dragSlide && slides[current] === dragSlide) gsap.to(dragSlide, { x: 0, duration: 0.9, ease: 'expo.out', overwrite: 'auto' });
      dragSlide = null; xTo = null;
    };
    const end = (e: PointerEvent) => {
      if (!dragging || e.pointerId !== pid) return;
      dragging = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.2) show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      release();
    };
    window.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', () => { dragging = false; release(); });

    // Initial state.
    if (!reduce) {
      gsap.set(slides, { visibility: 'hidden', opacity: 0 });
      gsap.set(slides[0], { visibility: 'visible', opacity: 1 });
      // Reveal the first quote word-by-word when it scrolls into view.
      gsap.set(words[0], { yPercent: 110 });
      ScrollTrigger.create({
        trigger: root, start: 'top 80%', once: true,
        onEnter: () => gsap.to(words[0], { yPercent: 0, duration: 1.2, ease: 'expo.out', stagger: 0.022, delay: 0.2 }),
      });
    }
    restartProgress();
  }
</script>
