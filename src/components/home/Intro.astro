---
// Intro: occasions marquee, scroll-scrubbed brand statement and proof stats.
import Icon from '../Icon.astro';
import { site, stats, occasions } from '../../data/site';

// Statement copy, tokenised so each word can be scrubbed from muted to ivory. The closing brand line is
// one token joined by no-break spaces, so "door to door." never splits.
// (Was "on time, every time,": an absolute punctuality promise the client has not substantiated.)
const nb = (phrase: string) => phrase.replace(/ /g, '\u00A0');
const statement: { t: string; gold?: boolean }[] = [
  ...`Since ${site.since}, we’ve driven Seattle’s executives, newlyweds and night owls\u00A0—`.split(' ').map((t) => ({ t })),
  { t: 'punctually,' },
  { t: 'discreetly,' },
  { t: nb('door to door.'), gold: true },
];

// Years in business is derived from the founding year so it can never contradict "Since 2008" above it
// (site.ts carried a hard-coded "20+"; the client is confirming the right figure).
const years = new Date().getFullYear() - site.since;
const figures = stats.map((s) => (/years/i.test(s.label) ? { value: years, suffix: '', label: 'Years serving Seattle' } : s));

const rowB = [...occasions.slice(6), ...occasions.slice(0, 6)];
---
<section class="intro" aria-label="Who we are">
  <div class="mq-wrap">
  <div class="mq" data-mq>
    <div class="mq__row mq__row--a" data-mq-row data-dir="-1">
      <div class="mq__track" data-mq-track>
        <ul class="mq__group" role="list" aria-label="Occasions we serve">
          {occasions.map((o) => (
            <li class="mq__item"><span>{o}</span><span class="mq__dot" aria-hidden="true"></span></li>
          ))}
        </ul>
        <ul class="mq__group" role="list" aria-hidden="true">
          {occasions.map((o) => (
            <li class="mq__item"><span>{o}</span><span class="mq__dot"></span></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mq__row mq__row--b" data-mq-row data-dir="1" aria-hidden="true">
      <div class="mq__track" data-mq-track>
        {[0, 1].map(() => (
          <ul class="mq__group" role="list">
            {rowB.map((o) => (
              <li class="mq__item"><span>{o}</span><span class="mq__dash"></span></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
  <!-- WCAG 2.2.2: the ticker loops indefinitely, so it gets a pause control (revealed by the script that animates it) -->
  <button type="button" class="mq__toggle" aria-label="Pause scrolling occasions" aria-pressed="false" data-mq-toggle hidden>
    <svg class="mq__ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <svg class="mq__ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 6.2v11.6L18 12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  </button>
  </div>

  <div class="container intro__body">
    <div class="intro__grid">
      <aside class="intro__aside" data-reveal>
        <p class="eyebrow">Our promise</p>
        <p class="intro__aside-text">{site.tagline}. Driven by locals who treat your schedule as sacred.</p>
        <a href="/fleet/" class="link-underline">Meet the fleet <Icon name="arrow" /></a>
      </aside>
      <p class="intro__statement display" data-statement>
        {statement.map((w) => (
          <>
            <span class:list={['intro__w', w.gold && 'intro__w--gold']}>{w.t}</span>{' '}
          </>
        ))}
      </p>
    </div>

    <dl class="intro__stats" data-stagger="0.1">
      {figures.map((s) => (
        <div class="intro__stat">
          <dt class="intro__stat-label">{s.label}</dt>
          <dd class="intro__stat-value">
            <span data-count={s.value}>{s.value.toLocaleString('en-US')}</span><span class="intro__stat-suffix">{s.suffix}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .intro { position: relative; background: var(--bg); overflow: hidden; }

  /* ---------- Marquee ---------- */
  .mq {
    position: relative;
    padding-block: clamp(1.6rem, 3.4vw, 2.8rem);
    border-block: 1px solid var(--line);
    /* Ivory: a paper-white lift (a bronze wash reads as a smudge on ivory); Onyx: faint champagne glow */
    background:
      radial-gradient(60% 120% at 50% 50%, var(--bg-3), transparent 70%),
      var(--bg);
    display: grid;
    gap: clamp(0.9rem, 1.8vw, 1.5rem);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  :global([data-theme='dark']) .mq {
    background:
      radial-gradient(60% 120% at 50% 50%, rgb(var(--accent-rgb) / 0.07), transparent 70%),
      var(--bg);
  }
  .mq__row { overflow: hidden; }
  .mq__track { display: flex; width: max-content; will-change: transform; }
  .mq__group { display: flex; flex: none; align-items: center; list-style: none; padding: 0; margin: 0; }
  .mq__item {
    display: inline-flex;
    align-items: center;
    flex: none;
    white-space: nowrap;
    transition: color 0.6s var(--ease-out);
  }
  /* Row A: confident display sans; row B: a quiet, widely tracked index line */
  .mq__row--a .mq__item {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.1rem, 5vw, 4.6rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .mq__row--b .mq__item {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(0.68rem, 0.95vw, 0.82rem);
    line-height: 1.6;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mq__item:hover { color: var(--accent); }
  .mq__dot {
    flex: none;
    width: 0.16em;
    height: 0.16em;
    margin-inline: 0.62em;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(0.06em);
  }
  .mq__dash { flex: none; width: 2.4rem; height: 1px; margin-inline: 1.5rem 1.2rem; background: rgb(var(--accent-rgb) / 0.6); }

  /* Pause/play: a small disc sitting on the ticker's bottom rule, aligned to the container edge */
  .mq-wrap { position: relative; }
  .mq__toggle {
    position: absolute;
    right: max(var(--gutter), (100% - var(--container)) / 2);
    bottom: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--muted);
    transform: translateY(50%);
    transition: border-color 0.4s var(--ease-out), background 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .mq__toggle[hidden] { display: none; }
  .mq__toggle svg { width: 16px; height: 16px; }
  .mq__toggle:hover { border-color: var(--text); color: var(--bg); background: var(--text); }
  .mq__toggle .mq__ico-play { display: none; }
  .mq__toggle[aria-pressed='true'] .mq__ico-pause { display: none; }
  .mq__toggle[aria-pressed='true'] .mq__ico-play { display: block; }

  /* ---------- Statement ---------- */
  .intro__body { padding-block: clamp(4.5rem, 10vw, 9rem) clamp(2.5rem, 5vw, 4rem); }
  .intro__grid {
    display: grid;
    gap: 2.2rem;
  }
  @media (min-width: 1024px) {
    .intro__grid { grid-template-columns: minmax(220px, 3fr) 9fr; gap: clamp(3rem, 6vw, 6rem); align-items: start; }
  }
  .intro__aside { display: grid; gap: 1.1rem; align-content: start; max-width: 34ch; }
  @media (min-width: 1024px) { .intro__aside { padding-top: 1.1rem; } }
  .intro__aside-text { color: var(--muted); font-size: 0.95rem; line-height: 1.7; }
  /* Tap target from padding, so the gold underline still sits right under the text */
  .intro__aside .link-underline { justify-self: start; min-height: 0; padding-block: 0.75rem; }
  .intro__aside .link-underline::after { bottom: 0.55rem; }
  .intro__aside .link-underline :global(svg) { width: 15px; height: 15px; }

  .intro__statement {
    font-size: clamp(1.7rem, 3.3vw, 3.15rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: pretty;
    font-variant-numeric: lining-nums;
  }
  .intro__w { display: inline; }
  /* Emphasis by colour, not italics */
  .intro__w--gold {
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.03em;
  }

  /* ---------- Stats ---------- */
  .intro__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) { .intro__stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .intro__stat {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.7rem;
    padding: clamp(1.6rem, 3vw, 2.4rem) clamp(0.9rem, 2.2vw, 2rem) 0;
  }
  .intro__stat:first-child, .intro__stat:nth-child(3) { padding-left: 0; }
  @media (min-width: 900px) { .intro__stat:nth-child(3) { padding-left: clamp(0.9rem, 2.2vw, 2rem); } }
  .intro__stat + .intro__stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: clamp(1.6rem, 3vw, 2.4rem);
    bottom: 0.4rem;
    width: 1px;
    background: linear-gradient(180deg, var(--line-strong), transparent);
  }
  @media (max-width: 899px) {
    .intro__stat:nth-child(3)::before { display: none; }
    .intro__stat:nth-child(n + 3) { margin-top: 1.2rem; }
  }
  .intro__stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.8vw, 4.3rem);
    font-weight: 400;
    line-height: 1;
    color: var(--text);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }
  .intro__stat-suffix {
    font-weight: 300;
    color: var(--accent);
    margin-left: 0.04em;
  }
  .intro__stat-label {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Marquee: infinite rows, slows on hover, leans with scroll velocity ---------- */
  const mq = document.querySelector<HTMLElement>('[data-mq]');
  if (mq && !reduce) {
    const rows = Array.from(mq.querySelectorAll<HTMLElement>('[data-mq-row]'));
    const tracks = rows.map((r) => r.querySelector<HTMLElement>('[data-mq-track]')!);
    const loops = rows.map((row, i) => {
      const dir = Number(row.dataset.dir) || -1;
      const group = tracks[i].firstElementChild as HTMLElement;
      const speed = i === 0 ? 62 : 48; // px per second
      const duration = Math.max(20, group.offsetWidth / speed);
      return gsap.fromTo(
        tracks[i],
        { xPercent: dir < 0 ? 0 : -50 },
        { xPercent: dir < 0 ? -50 : 0, duration, ease: 'none', repeat: -1 },
      );
    });

    let hover = 1;
    let boost = 0;
    let paused = false;
    let inView = false;
    const apply = (dur = 0.6) => loops.forEach((t) => gsap.to(t, { timeScale: hover * (1 + boost), duration: dur, ease: 'power2.out', overwrite: true }));
    const skewTo = gsap.quickTo(tracks, 'skewX', { duration: 0.7, ease: 'power3.out' });
    const run = () => loops.forEach((t) => (inView && !paused ? t.play() : t.pause()));

    mq.addEventListener('mouseenter', () => { hover = 0.22; apply(0.9); });
    mq.addEventListener('mouseleave', () => { hover = 1; apply(0.9); });

    // Pause/play control (keyboard, touch and mouse alike)
    const toggle = mq.parentElement?.querySelector<HTMLButtonElement>('[data-mq-toggle]');
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        paused = !paused;
        toggle.setAttribute('aria-pressed', String(paused));
        if (paused) skewTo(0);
        run();
      });
    }

    let idle = 0;
    const st = ScrollTrigger.create({
      trigger: mq,
      start: 'top bottom',
      end: 'bottom top',
      onToggle: (self) => { inView = self.isActive; run(); },
      onUpdate: (self) => {
        if (paused) return;
        const v = self.getVelocity();
        boost = gsap.utils.clamp(0, 3.2, Math.abs(v) / 900);
        skewTo(gsap.utils.clamp(-7, 7, v / -260));
        apply(0.35);
        window.clearTimeout(idle);
        idle = window.setTimeout(() => { boost = 0; skewTo(0); apply(1.2); }, 140);
      },
    });
    inView = st.isActive;
    run();
  }

  /* ---------- Statement: scroll-scrubbed word highlight ---------- */
  const statement = document.querySelector<HTMLElement>('[data-statement]');
  if (statement && !reduce) {
    const words = statement.querySelectorAll<HTMLElement>('.intro__w');
    // Words start at half strength (still >= 3:1 against the page) and the whole line is fully lit by the
    // time it reaches the middle of the screen, so it is never dim where it is read.
    gsap.fromTo(
      words,
      { opacity: 0.5 },
      {
        opacity: 1,
        ease: 'none',
        stagger: 0.12,
        scrollTrigger: { trigger: statement, start: 'top 88%', end: 'center 56%', scrub: 0.6 },
      },
    );
  }
</script>
