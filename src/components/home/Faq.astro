---
import Icon from '../Icon.astro';
import { site, faqs } from '../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <aside class="faq__aside">
      <div class="faq__sticky">
        <p class="eyebrow" data-reveal="fade">FAQ</p>
        <h2 id="faq-title" data-split>Questions, <em>answered.</em></h2>
        <p class="lead faq__lead" data-reveal data-delay="0.1">Everything worth knowing before you ride, from booking to flight delays. Anything else, a real person is a call or text away, 24/7.</p>
        <!-- Same aside as the service-page FAQs (ServiceFaq.astro): unboxed Call/Text pills and an underlined link -->
        <div class="faq__contact" data-reveal data-delay="0.2">
          <a href={site.phoneHref} class="btn btn--gold" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
          <a href={site.smsHref} class="btn btn--ghost"><Icon name="chat" /> Text us</a>
        </div>
        <a href="/faq/" class="link-underline faq__all" data-reveal="fade" data-delay="0.3">All questions <Icon name="arrow" size={14} /></a>
      </div>
    </aside>

    <div class="faq__list" data-faq data-stagger="0.07">
      {faqs.map((f, i) => {
        const open = i === 0;
        return (
          <div class:list={['faq__item', open && 'is-open']} data-faq-item>
            <h3 class="faq__q">
              <button
                type="button"
                class="faq__btn"
                id={`faq-btn-${i}`}
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={`faq-panel-${i}`}
                data-faq-btn
              >
                <span class="faq__idx" aria-hidden="true">{pad(i + 1)}</span>
                <span class="faq__qtext">{f.q}</span>
                <span class="faq__icon" aria-hidden="true"><span></span><span></span></span>
              </button>
            </h3>
            <div class="faq__panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
              <div class="faq__panel-inner">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 7vw, 7.5rem);
    align-items: start;
  }
  .faq__aside { align-self: stretch; }
  .faq__sticky {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .faq__lead { max-width: 40ch; }

  /* ---------- Contact (matches ServiceFaq) ---------- */
  .faq__contact { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.4rem; }
  .faq__all { min-height: 44px; }
  .faq__all::after { bottom: calc(50% - 0.95em); }

  /* ---------- Accordion ---------- */
  .faq__list { border-top: 1px solid var(--line); }
  .faq__item { position: relative; isolation: isolate; border-bottom: 1px solid var(--line); }
  /* Open/hover wash: a faint warm light that fades in past the index and out before the icon
     (bronze on ivory, champagne on onyx). It overhangs the list slightly with soft corners, so it
     reads as light on the page rather than a highlighted table row. */
  .faq__item::after {
    content: ''; position: absolute; inset: 0 -1rem; z-index: -1; pointer-events: none;
    border-radius: var(--radius-s);
    background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0), rgb(var(--accent-rgb) / 0.06) 12%, rgb(var(--accent-rgb) / 0) 75%);
    opacity: 0; transition: opacity 0.6s var(--ease-out);
  }
  .faq__item:hover::after { opacity: 0.5; }
  .faq__item.is-open::after { opacity: 1; }
  .faq__item::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: var(--accent-grad);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.9s var(--ease-out);
  }
  .faq__item.is-open::before { transform: scaleX(1); }
  .faq__q { font: inherit; margin: 0; }
  /* Index, question and icon share a 42px first-line box so they stay aligned when a question wraps. */
  .faq__btn {
    --row: 42px;
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    align-items: start;
    gap: 1rem;
    width: 100%;
    min-height: 84px;
    padding: 1.3rem 0;
    text-align: left;
    color: var(--text-2);
  }
  .faq__idx { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; line-height: var(--row); color: var(--muted); font-variant-numeric: tabular-nums; transition: color 0.4s; }
  .faq__qtext {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    font-weight: 450;
    line-height: 1.3;
    letter-spacing: -0.02em;
    padding-top: calc((var(--row) - 1.3em) / 2);
    transition: color 0.4s, transform 0.6s var(--ease-out);
  }
  .faq__btn:hover .faq__qtext { color: var(--text); transform: translateX(4px); }
  .faq__icon {
    position: relative;
    width: var(--row); height: var(--row); flex: none;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform 0.7s var(--ease-out), background 0.5s var(--ease-out), border-color 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .faq__icon span {
    position: absolute; left: 50%; top: 50%;
    width: 14px; height: 1.5px; margin: -0.75px 0 0 -7px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.7s var(--ease-out), background 0.5s;
  }
  .faq__icon span:last-child { transform: rotate(90deg); }
  /* Closed + hover: the disc lifts off the page (raised paper on ivory, a faint sheen on onyx). */
  .faq__item:not(.is-open) .faq__btn:hover .faq__icon { border-color: rgb(var(--fg-rgb) / 0.45); background: var(--bg-3); box-shadow: 0 8px 20px -12px rgb(var(--fg-rgb) / 0.35); }
  :global([data-theme='dark']) .faq__item:not(.is-open) .faq__btn:hover .faq__icon { background: rgb(var(--fg-rgb) / 0.05); box-shadow: none; }
  .faq__btn:focus-visible { outline-offset: 4px; }

  /* Open: onyx disc on ivory (champagne on onyx), bronze index and rule. */
  .faq__item.is-open .faq__idx { color: var(--accent); }
  .faq__item.is-open .faq__qtext { color: var(--text); }
  .faq__item.is-open .faq__icon { transform: rotate(180deg); background: var(--cta-bg); border-color: transparent; }
  .faq__item.is-open .faq__icon span { background: var(--cta-fg); }
  .faq__item.is-open .faq__icon span:last-child { transform: rotate(0deg); }

  .faq__panel { --row: 42px; display: grid; grid-template-rows: 1fr; transition: grid-template-rows 0.7s var(--ease-out); }
  .faq__panel-inner { overflow: hidden; min-height: 0; }
  .faq__panel p {
    padding: 0 calc(var(--row) + 1rem) 1.8rem 3.6rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 62ch;
    transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-out);
  }
  :global(.js) .faq__item:not(.is-open) .faq__panel { grid-template-rows: 0fr; }
  :global(.js) .faq__item:not(.is-open) .faq__panel-inner { visibility: hidden; transition: visibility 0s linear 0.7s; }
  :global(.js) .faq__item:not(.is-open) .faq__panel p { opacity: 0; transform: translateY(-8px); }
  .faq__item.is-open .faq__panel p { color: var(--text-2); }

  @media (max-width: 900px) {
    .faq__grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .faq__sticky { position: static; }
  }
  @media (max-width: 560px) {
    .faq__btn { --row: 40px; grid-template-columns: 1fr auto; min-height: 74px; padding: 1.1rem 0; gap: 0.9rem; }
    .faq__idx { display: none; }
    .faq__item::after { display: none; } /* text runs edge to edge here, so the wash would read as a box */
    .faq__qtext { font-size: 1.12rem; }
    .faq__panel p { padding: 0 0 1.5rem 0; font-size: 0.96rem; }
    .faq__contact { display: grid; width: 100%; }
    .faq__contact .btn { width: 100%; }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import gsap from 'gsap';

  gsap.registerPlugin(ScrollTrigger);

  const list = document.querySelector<HTMLElement>('[data-faq]');
  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-faq-item]'));
    let refreshTimer = 0;
    const refresh = () => {
      window.clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(() => {
        ScrollTrigger.refresh();
        (window as any).lenis?.resize?.();
      }, 750);
    };

    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('[data-faq-btn]');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        item.classList.toggle('is-open', open);
        refresh();
      });
    });
  }
</script>
