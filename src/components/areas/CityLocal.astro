---
// Local coverage: second intro paragraph + neighborhoods served as chips.
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import type { AreaEntry } from '../../data/area-pages';

interface Props { area: AreaEntry }
const { area } = Astro.props;
const { page } = area;
---
<section class="section surface-2 cl" aria-labelledby="cl-title">
  <div class="container cl__grid">
    <div class="cl__copy">
      <p class="eyebrow" data-reveal="fade">Local coverage</p>
      <h2 id="cl-title" data-split>{area.city}, <em>door to door.</em></h2>
      <p class="lead" data-reveal data-delay="0.1">{page.intro[1]}</p>
    </div>

    <div class="cl__panel" data-reveal data-delay="0.15">
      <div class="cl__panel-head">
        <h3 class="cl__panel-title">Neighborhoods we serve</h3>
        <span class="cl__count" aria-hidden="true">{String(page.neighborhoods.length).padStart(2, '0')}</span>
      </div>
      <ul class="cl__chips" role="list">
        {page.neighborhoods.map((n) => <li class="chip"><Icon name="pin" />{n}</li>)}
      </ul>
      <div class="cl__note">
        <p>Not on the list? Every {area.city} address is door to door, and custom routes are a call away.</p>
        <a href={site.phoneHref} class="cl__call" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cl__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .cl__copy { display: grid; gap: 1.3rem; justify-items: start; }
  .cl__copy h2 :global(.split-line) { vertical-align: top; }
  .cl__copy .lead { max-width: 50ch; }

  .cl__panel {
    padding: clamp(1.4rem, 3vw, 2.4rem);
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    background: var(--card-bg);
    box-shadow: var(--card-highlight), var(--card-shadow);
  }
  .cl__panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: 1.1rem; margin-bottom: 1.3rem; border-bottom: 1px solid var(--line); }
  .cl__panel-title { font-size: 0.7rem; font-family: var(--font-sans); font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); line-height: 1.4; }
  .cl__count { font-family: var(--font-display); font-size: 1.6rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  .cl__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; }
  .cl__chips .chip { font-size: 0.84rem; padding: 0.5rem 0.95rem; color: var(--text); }
  .cl__note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.4rem 1.5rem; margin-top: 1.4rem; font-size: 0.86rem; line-height: 1.6; color: var(--muted); }
  .cl__note p { flex: 1 1 22rem; }
  .cl__call { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; font-size: 0.9rem; font-weight: 600; color: var(--text); white-space: nowrap; transition: color 0.3s; }
  .cl__call :global(svg) { width: 15px; height: 15px; color: var(--accent); }
  .cl__call:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .cl__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .cl__panel { border-radius: var(--radius); }
    .cl__chips .chip { font-size: 0.8rem; padding: 0.45rem 0.8rem; }
  }
</style>
