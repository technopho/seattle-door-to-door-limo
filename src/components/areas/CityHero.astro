---
// City landing hero: page-themed. Copy + CTAs on the left; on the right a local photo (or, for cities
// without local photography, an always-dark route map) with a "route ticket" on top.
import Icon from '../Icon.astro';
import Crumbs from './Crumbs.astro';
import RouteGlyph from './RouteGlyph.astro';
import CityMap from './CityMap.astro';
import { site, areaHref } from '../../data/site';
import { bookHref, etaMin, type AreaEntry } from '../../data/area-pages';

interface Props { area: AreaEntry }
const { area } = Astro.props;
const { page } = area;
const minutes = etaMin(area.eta).replace(/\s*min$/, '');
// Words joined by a no-break space in the data stay on one line (e.g. "limo &"), so a line never
// starts with the ampersand. Rendered as nowrap spans: the headline splitter treats NBSP as a space.
const glue = (s: string) =>
  s.split(' ').map((w, i) => ({ w: w.replace(/\u00a0/g, ' '), keep: w.includes('\u00a0'), sp: i > 0 }));
const photo = page.image;
---
<section class="ch" aria-labelledby="city-title">
  <div class="ch__glow" aria-hidden="true"></div>
  <div class="container ch__grid">
    <div class="ch__copy">
      <div data-reveal="fade"><Crumbs items={[['Service Areas', '/service-areas/'], [area.city, areaHref(area)]]} /></div>
      <p class="eyebrow ch__eyebrow" data-reveal="fade">Service area · {area.city}, WA</p>
      <h1 id="city-title" class="ch__title" data-split>{glue(page.h1.text).map((t) => <Fragment>{t.sp && ' '}{t.keep ? <span class="ch__keep">{t.w}</span> : t.w}</Fragment>)} <em>{glue(page.h1.em).map((t) => <Fragment>{t.sp && ' '}{t.keep ? <span class="ch__keep">{t.w}</span> : t.w}</Fragment>)}</em></h1>
      <p class="lead ch__lead" data-reveal data-delay="0.25">{page.intro[0]}</p>
      <div class="ch__ctas" data-reveal data-delay="0.35">
        <a href={bookHref({ from: area.city })} class="btn btn--gold btn--lg" data-magnetic="0.2">Reserve in {area.city} <Icon name="arrow" /></a>
        <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
      </div>
      <ul class="ch__facts" role="list" data-stagger="0.08">
        <li><Icon name="clock" /> <span>Reservations 24/7</span></li>
        <li><Icon name="plane" /> <span>Flight-tracked pickups</span></li>
        <li><Icon name="check" /> <span>Confirmed by a real person</span></li>
      </ul>
    </div>

    <div class:list={['ch__visual', !photo && 'ch__visual--map']} data-tone={photo?.tone ?? 'night'} data-grade={photo?.grade ? '' : undefined}>
      <div class="ch__media" data-reveal="scale">
        {photo ? (
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            decoding="async"
            fetchpriority="high"
            style={photo.position ? `object-position: ${photo.position}` : undefined}
          />
        ) : (
          <CityMap slug={area.slug} />
        )}
      </div>
      <div class="ch__ticket" data-reveal data-delay="0.45">
        {photo && <span class="ch__ticket-map" aria-hidden="true"><RouteGlyph slug={area.slug} /></span>}
        <div class="ch__ticket-body">
          <span class="ch__ticket-label">Typical drive</span>
          <p class="ch__ticket-route">
            <span>SeaTac</span>
            <svg viewBox="0 0 48 8" aria-hidden="true"><path d="M1 4h40" stroke-dasharray="2 3" /><path d="M40 1l4 3-4 3" /></svg>
            <span>{area.city}</span>
          </p>
          <p class="ch__ticket-eta"><b>{minutes}</b> min <small>in typical traffic</small></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ch {
    position: relative;
    isolation: isolate;
    padding: calc(var(--header-h) + 0.75rem) 0 clamp(3.5rem, 7vw, 6rem);
  }
  .ch__glow {
    position: absolute;
    inset: 0 0 auto;
    height: 80%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(55% 70% at 90% 10%, rgb(var(--accent-rgb) / 0.09), transparent 70%);
  }
  .ch__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .ch__copy { display: grid; justify-items: start; gap: 1.4rem; min-width: 0; }
  .ch__eyebrow { margin-top: clamp(0.5rem, 2vw, 1.5rem); }
  /* Page-hero tier of the site's H1 scale (city pages are not hubs). No phone override, like the
     other page heroes (FAQ, Journal, contact, post, 404): the token's 2.4rem floor applies. */
  .ch__title { font-size: var(--fs-page-h1); line-height: 0.98; letter-spacing: -0.04em; max-width: 12ch; text-wrap: balance; }
  .ch__keep { white-space: nowrap; }
  /* Tight display leading: give the word masks room for descenders (g, p, y). */
  .ch__title :global(.split-line) { vertical-align: top; padding-bottom: 0.2em; margin-bottom: -0.2em; }
  /* The gold gradient is clipped to each word box; extend it under the descenders. */
  .ch__title :global(em .split-word) { padding-bottom: 0.2em; margin-bottom: -0.2em; }
  .ch__lead { max-width: 52ch; }
  .ch__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.3rem; }
  .ch__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin: 0.6rem 0 0;
    padding: 1.3rem 0 0;
    border-top: 1px solid var(--line);
    width: 100%;
  }
  .ch__facts li { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.86rem; color: var(--text-2); }
  .ch__facts :global(svg) { width: 16px; height: 16px; color: var(--accent); flex: none; }
  .ch__facts b { color: var(--text); font-weight: 600; }

  /* ---------- Visual ---------- */
  /* Desktop: the photo fills the height of the copy column, starting level with the eyebrow,
     so every city hero has the same silhouette whatever the headline length. */
  .ch__visual { position: relative; align-self: stretch; display: flex; flex-direction: column; padding: clamp(2.6rem, 4.6vw, 4.4rem) 0 2.5rem; min-width: 0; }
  .ch__media {
    position: relative;
    flex: 1 1 auto;
    min-height: 440px;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--bg-3);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 50px 90px -50px rgb(var(--fg-rgb) / 0.5);
  }
  /* Out of the sizing flow: the frame's height comes from the copy column (desktop) or its
     aspect-ratio (tablet/phone), never from the photo, so nothing shifts when the file arrives. */
  .ch__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  :global([data-theme='dark']) .ch__visual[data-tone='day'] .ch__media img { filter: brightness(0.8) contrast(1.05) saturate(0.85); }
  .ch__visual[data-grade] .ch__media img { filter: brightness(0.97) contrast(1.04) saturate(0.72); }
  :global([data-theme='dark']) .ch__visual[data-grade] .ch__media img { filter: brightness(0.74) contrast(1.1) saturate(0.6); }
  .ch__media::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit; box-shadow: inset 0 0 0 1px rgb(var(--fg-rgb) / 0.06); }

  .ch__ticket {
    position: absolute;
    left: clamp(-2.5rem, -3vw, -1rem);
    bottom: 0;
    display: grid;
    grid-template-columns: 92px auto;
    align-items: center;
    gap: 1.1rem;
    padding: 0.9rem 1.5rem 0.9rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--glass);
    box-shadow: var(--glass-shadow);
    /* Prefixed first: in the other order the build minifier keeps only the -webkit- line. */
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    backdrop-filter: blur(22px) saturate(140%);
  }
  :global([data-theme='light']) .ch__ticket { background: rgb(var(--bg-rgb) / 0.86); }
  /* Map heroes: the big map already draws the route, so the ticket is text only. */
  .ch__visual--map .ch__ticket { grid-template-columns: auto; padding: 1rem 1.6rem 1.05rem; }
  .ch__visual--map .ch__media { background: var(--bg); }
  /* A screen set into the page: neutral bezel, so the dark panel keeps its edge on onyx too. */
  .ch__visual--map .ch__media::after { z-index: 3; box-shadow: inset 0 0 0 1px rgb(var(--fg-rgb) / 0.08), inset 0 1px 0 rgb(var(--fg-rgb) / 0.06); }
  /* (The scale reveal leaves a clip-path on the frame, so the bezel has to be drawn inside it.) */
  :global([data-theme='dark']) .ch__visual--map .ch__media::after { box-shadow: inset 0 0 0 1px rgb(var(--fg-rgb) / 0.13), inset 0 1px 0 rgb(var(--fg-rgb) / 0.08); }
  .ch__ticket-map {
    position: relative;
    width: 92px;
    height: 100px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: radial-gradient(circle, rgb(var(--fg-rgb) / 0.1) 1px, transparent 1.3px) 0 0 / 10px 10px;
    --rg-play: running;
  }
  .ch__ticket-map :global(.rg) { position: absolute; inset: 4px 0; height: calc(100% - 8px); }
  .ch__ticket-body { display: grid; gap: 0.3rem; }
  .ch__ticket-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .ch__ticket-route { display: flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); font-size: 1.1rem; font-weight: 500; letter-spacing: -0.02em; color: var(--text); white-space: nowrap; }
  .ch__ticket-route svg { width: 30px; height: 8px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .ch__ticket-eta { display: flex; align-items: baseline; gap: 0.35rem; font-size: 0.9rem; color: var(--text-2); }
  .ch__ticket-eta b { font-family: var(--font-display); font-size: 2.3rem; font-weight: 500; line-height: 1; letter-spacing: -0.04em; color: var(--text); font-variant-numeric: tabular-nums; }
  .ch__ticket-eta small { font-size: 0.74rem; color: var(--muted); margin-left: 0.2rem; }

  @media (max-width: 960px) {
    .ch__grid { grid-template-columns: 1fr; }
    .ch__visual { display: block; max-width: 560px; padding-top: 0; }
    .ch__ticket { left: 1rem; }
    .ch__media { min-height: 0; aspect-ratio: 4 / 3.4; }
  }
  @media (max-width: 640px) {
    .ch { padding-bottom: 3rem; }
    .ch__ctas { display: grid; width: 100%; }
    .ch__ctas .btn { width: 100%; padding-inline: 1rem; }
    .ch__facts { gap: 0.6rem 1.2rem; }
    .ch__media { aspect-ratio: 4 / 3.6; border-radius: var(--radius); }
    .ch__visual { padding-bottom: 3.5rem; }
    .ch__ticket { left: 0.75rem; right: 0.75rem; grid-template-columns: 72px minmax(0, 1fr); padding: 0.75rem 1rem 0.75rem 0.75rem; gap: 0.9rem; }
    .ch__visual--map .ch__ticket { grid-template-columns: minmax(0, 1fr); padding: 0.85rem 1.1rem; }
    /* Square map on phones: the route keeps clear of the ticket that overlaps its lower edge. */
    .ch__visual--map .ch__media { aspect-ratio: 1; }
    .ch__ticket-map { width: 72px; height: 80px; }
    .ch__ticket-route { font-size: 1rem; }
    .ch__ticket-eta b { font-size: 1.9rem; }
  }
</style>
