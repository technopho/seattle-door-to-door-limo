---
// City FAQ accordion (content mirrored in the FAQPage JSON-LD on the page).
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props { city: string; faqs: { q: string; a: string }[] }
const { city, faqs } = Astro.props;
---
<section class="section surface-2 af" aria-labelledby="af-title">
  <div class="container af__grid">
    <aside class="af__aside">
      <p class="eyebrow" data-reveal="fade">FAQ</p>
      <h2 id="af-title" data-split>{city} questions, <em>answered.</em></h2>
      <p class="lead af__lead" data-reveal data-delay="0.1">Anything else about your {city} trip? A real person answers the phone, day or night.</p>
      <!-- Same actions as the service-page FAQ (ServiceFaq.astro): call, text, then all questions. -->
      <div class="af__actions" data-reveal data-delay="0.2">
        <a href={site.phoneHref} class="btn btn--gold" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
        <a href={site.smsHref} class="btn btn--ghost"><Icon name="chat" /> Text us</a>
      </div>
      <a href="/faq/" class="link-underline af__all" data-reveal="fade" data-delay="0.3">All questions <Icon name="arrow" /></a>
    </aside>

    <div class="af__list" data-af>
      {faqs.map((f, i) => (
        <div class:list={['af__item', i === 0 && 'is-open']} data-af-item>
          <h3 class="af__q">
            <button type="button" class="af__btn" id={`af-btn-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`af-panel-${i}`} data-af-btn>
              <span class="af__qtext">{f.q}</span>
              <span class="af__icon" aria-hidden="true"><span></span><span></span></span>
            </button>
          </h3>
          <div class="af__panel" id={`af-panel-${i}`} role="region" aria-labelledby={`af-btn-${i}`}>
            <div class="af__panel-inner"><p>{f.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .af__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2.5rem, 6vw, 6.5rem); align-items: start; }
  .af__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); display: grid; gap: 1.3rem; justify-items: start; }
  /* Wide enough for "{City} questions," on one line (Bellevue/Kirkland are the longest). */
  .af__aside h2 { max-width: 19ch; text-wrap: balance; }
  .af__aside h2 :global(.split-line) { vertical-align: top; }
  .af__lead { max-width: 38ch; }
  .af__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.4rem; }
  .af__all { min-height: 44px; }
  .af__all::after { bottom: calc(50% - 0.95em); }
  .af__all :global(svg) { width: 14px; height: 14px; }

  .af__list { border-top: 1px solid var(--line-strong); counter-reset: af; }
  .af__item { position: relative; isolation: isolate; border-bottom: 1px solid var(--line); counter-increment: af; }
  /* Open-row tint, as on the service and FAQ pages. */
  .af__item::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.07), rgb(var(--accent-rgb) / 0) 72%);
    opacity: 0; transition: opacity 0.6s var(--ease-out);
  }
  .af__item:hover::after { opacity: 0.5; }
  .af__item.is-open::after { opacity: 1; }
  .af__item::before { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--accent-grad); transform: scaleX(0); transform-origin: left; transition: transform 0.9s var(--ease-out); }
  .af__item.is-open::before { transform: scaleX(1); }
  .af__q { font: inherit; margin: 0; }
  .af__btn {
    --row: 40px;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem;
    width: 100%;
    min-height: 80px;
    padding: 1.25rem 0;
    text-align: left;
    color: var(--text-2);
  }
  /* Question number: generated, so it is not part of the heading text (or its accessible name). */
  .af__btn::before {
    content: counter(af, decimal-leading-zero);
    content: counter(af, decimal-leading-zero) / '';
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: var(--row);
    color: var(--muted-2);
    font-variant-numeric: tabular-nums;
    transition: color 0.4s;
  }
  .af__qtext { font-family: var(--font-display); font-size: clamp(1.1rem, 1.45vw, 1.32rem); font-weight: 450; line-height: 1.3; letter-spacing: -0.02em; padding-top: calc((var(--row) - 1.3em) / 2); transition: color 0.4s, transform 0.6s var(--ease-out); }
  .af__btn:hover .af__qtext { color: var(--text); transform: translateX(4px); }
  .af__icon { position: relative; width: var(--row); height: var(--row); border-radius: 50%; border: 1px solid var(--line-strong); transition: transform 0.7s var(--ease-out), background 0.5s var(--ease-out), border-color 0.5s; }
  .af__icon span { position: absolute; left: 50%; top: 50%; width: 13px; height: 1.5px; margin: -0.75px 0 0 -6.5px; background: var(--text); border-radius: 2px; transition: transform 0.7s var(--ease-out), background 0.5s; }
  .af__icon span:last-child { transform: rotate(90deg); }
  .af__btn:focus-visible { outline-offset: 4px; }
  .af__item.is-open .af__btn::before { color: var(--accent); }
  .af__item.is-open .af__qtext { color: var(--text); }
  .af__item.is-open .af__icon { transform: rotate(180deg); background: var(--cta-bg); border-color: transparent; }
  .af__item.is-open .af__icon span { background: var(--cta-fg); }
  .af__item.is-open .af__icon span:last-child { transform: rotate(0deg); }

  .af__panel { display: grid; grid-template-rows: 1fr; transition: grid-template-rows 0.7s var(--ease-out); }
  .af__panel-inner { overflow: hidden; min-height: 0; }
  .af__panel p { padding: 0 3.4rem 1.6rem 3.4rem; color: var(--text-2); line-height: 1.7; max-width: 64ch; transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-out); }
  :global(.js) .af__item:not(.is-open) .af__panel { grid-template-rows: 0fr; }
  :global(.js) .af__item:not(.is-open) .af__panel-inner { visibility: hidden; transition: visibility 0s linear 0.7s; }
  :global(.js) .af__item:not(.is-open) .af__panel p { opacity: 0; transform: translateY(-8px); }

  @media (max-width: 900px) {
    .af__grid { grid-template-columns: 1fr; gap: 2.2rem; }
    .af__aside { position: static; }
  }
  @media (max-width: 560px) {
    .af__btn { grid-template-columns: minmax(0, 1fr) auto; min-height: 72px; padding: 1.1rem 0; gap: 0.9rem; }
    .af__btn::before { display: none; }
    .af__qtext { font-size: 1.08rem; }
    .af__panel p { padding: 0 0 1.4rem; font-size: 0.96rem; }
    .af__item::after { display: none; }
    .af__actions { display: grid; width: 100%; }
    .af__actions .btn { width: 100%; }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import gsap from 'gsap';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-af]').forEach((list) => {
    let timer = 0;
    // Panels animate their height; re-measure scroll positions once they settle.
    const refresh = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        ScrollTrigger.refresh();
        window.lenis?.resize?.();
      }, 750);
    };
    list.querySelectorAll<HTMLElement>('[data-af-item]').forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('[data-af-btn]');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        item.classList.toggle('is-open', open);
        refresh();
      });
    });
  });
</script>
