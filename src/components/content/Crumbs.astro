---
// Visible breadcrumb trail (pair with breadcrumbs() JSON-LD). Home is prepended; the last item is the current page.
interface Props { trail: [name: string, href: string][]; class?: string }
const { trail, class: cls } = Astro.props;
const items: [string, string][] = [['Home', '/'], ...trail];
---
<nav class:list={['crumbs', cls]} aria-label="Breadcrumb">
  <ol role="list">
    {items.map(([name, href], i) =>
      i < items.length - 1 ? (
        <li><a href={href}>{name}</a></li>
      ) : (
        <li aria-current="page"><span>{name}</span></li>
      ),
    )}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; align-items: center; flex-wrap: wrap; min-width: 0; }
  .crumbs li { display: inline-flex; align-items: center; min-width: 0; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-2); }
  .crumbs li + li::before { content: ''; flex: none; width: 1.1rem; height: 1px; margin: 0 0.8rem; background: var(--line-strong); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); transition: color 0.35s var(--ease-out); }
  .crumbs a:hover { color: var(--text); }
  .crumbs [aria-current] span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 560px) {
    .crumbs li { letter-spacing: 0.16em; }
    .crumbs li + li::before { width: 0.8rem; margin: 0 0.6rem; }
  }
</style>
