---
// Search field for the FAQ page (wired up by FaqBrowser's script through data attributes).
const suggestions = [
  { label: 'Flight delays', q: 'delayed' },
  { label: 'Pricing', q: 'price' },
  { label: 'Cancellation', q: 'cancel' },
  { label: 'Child seats', q: 'child seat' },
];
---
<div class="fs" role="search">
  <label for="faq-q" class="fs__label">Search the questions</label>
  <div class="fs__field">
    <svg class="fs__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" />
    </svg>
    <input
      id="faq-q"
      class="fs__input"
      type="search"
      name="q"
      placeholder="e.g. flight delays, luggage"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-controls="faq-results"
      aria-describedby="faq-status"
      data-faq-search
    />
    <kbd class="fs__kbd" aria-hidden="true" data-faq-kbd>/</kbd>
    <button type="button" class="fs__clear" data-faq-clear aria-label="Clear search" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>
    </button>
  </div>
  <div class="fs__popular">
    <span class="fs__pop-label">Popular</span>
    <ul role="list">
      {suggestions.map((s) => <li><button type="button" class="fs__pop" data-faq-suggest={s.q}>{s.label}</button></li>)}
    </ul>
  </div>
</div>

<style>
  .fs { display: grid; gap: 0.85rem; width: 100%; max-width: 560px; margin-left: auto; }
  .fs__label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .fs__field { position: relative; display: flex; align-items: center; }
  .fs__icon { position: absolute; left: 1.15rem; width: 20px; height: 20px; color: var(--accent); pointer-events: none; }
  .fs__input {
    width: 100%;
    min-height: 62px;
    padding: 0 3.6rem 0 3.2rem;
    border-radius: 999px;
    border: 1px solid var(--input-border);
    background: var(--input-bg);
    box-shadow: var(--input-shadow), 0 20px 50px -34px rgb(var(--fg-rgb) / 0.35);
    color: var(--text);
    font-size: 1.02rem;
    transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
    -webkit-appearance: none;
    appearance: none;
  }
  .fs__input::placeholder { color: var(--muted-2); opacity: 1; }
  .fs__input::-webkit-search-cancel-button, .fs__input::-webkit-search-decoration { -webkit-appearance: none; appearance: none; }
  .fs__input:hover { border-color: rgb(var(--fg-rgb) / 0.3); }
  .fs__input:focus { outline: none; border-color: var(--accent); background: var(--input-bg-focus); box-shadow: 0 0 0 4px rgb(var(--accent-rgb) / 0.15), 0 20px 50px -34px rgb(var(--fg-rgb) / 0.35); }
  .fs__kbd {
    position: absolute;
    right: 1.1rem;
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 0.4rem;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 7px;
    font: 600 0.75rem/1 var(--font-sans);
    color: var(--muted);
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .fs__input:focus ~ .fs__kbd, .fs__kbd[hidden] { opacity: 0; }
  .fs__clear {
    position: absolute;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: var(--text-2);
    transition: background 0.3s, color 0.3s;
  }
  .fs__clear[hidden] { display: none; }
  .fs__clear svg { width: 18px; height: 18px; }
  .fs__clear:hover { background: rgb(var(--fg-rgb) / 0.06); color: var(--text); }

  .fs__popular { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.9rem; }
  .fs__pop-label { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted-2); }
  .fs__popular ul { display: flex; flex-wrap: wrap; gap: 0 0.2rem; }
  .fs__pop {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.55rem;
    border-radius: 999px;
    font-size: 0.86rem;
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: rgb(var(--accent-rgb) / 0.4);
    text-underline-offset: 0.25em;
    transition: color 0.3s, text-decoration-color 0.3s;
  }
  .fs__pop:hover { color: var(--accent); text-decoration-color: currentColor; }

  @media (hover: none), (pointer: coarse) { .fs__kbd { display: none; } }
  @media (max-width: 900px) { .fs { margin-left: 0; max-width: none; } }
  @media (max-width: 560px) {
    .fs__input { min-height: 56px; font-size: 1rem; padding-left: 3rem; }
    .fs__icon { left: 1rem; }
    .fs__popular { gap: 0.2rem 0.6rem; }
    .fs__pop { padding: 0 0.45rem; font-size: 0.84rem; }
  }
</style>
