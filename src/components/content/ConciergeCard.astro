---
// "Still have questions?" card: call, text or write to the concierge.
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
  title?: string;
  text?: string;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  /** In a sticky desktop sidebar: drop the copy and email on laptop-height windows so the stack fits. */
  fit?: boolean;
}
const {
  title = 'Still have questions?',
  text = 'Quotes, availability, a multi-vehicle event or a last-minute airport run. A real person answers, day or night.',
  headingLevel = 'h2',
  class: cls,
  fit = false,
} = Astro.props;
const H = headingLevel;
const [emailUser, emailHost] = site.email.split('@');
---
<div class:list={['cc', { 'cc--fit': fit }, cls]}>
  <span class="cc__glow" aria-hidden="true"></span>
  <p class="cc__kicker"><span class="cc__pulse" aria-hidden="true"></span> Concierge · 24/7</p>
  <H class="cc__title">{title}</H>
  <p class="cc__text">{text}</p>
  <div class="cc__actions">
    <a href={site.phoneHref} class="btn btn--gold cc__call" data-cursor="Call"><Icon name="phone" /> Call {site.phone}</a>
    <a href={site.smsHref} class="btn btn--ghost"><Icon name="chat" /> Text us</a>
    <a href="/contact/" class="btn btn--ghost">Contact <Icon name="arrow" /></a>
  </div>
  <p class="cc__mail"><Icon name="mail" /> <a href={`mailto:${site.email}`}>{emailUser}@<wbr />{emailHost}</a></p>
</div>

<style>
  .cc {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--bg-3);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 24px 60px -34px rgb(var(--fg-rgb) / 0.3);
  }
  :global([data-theme='dark']) .cc { background: var(--bg-2); box-shadow: 0 30px 70px -40px rgb(0 0 0 / 0.7); }
  .cc__glow {
    position: absolute;
    inset: auto -30% -60% auto;
    z-index: -1;
    width: 80%;
    aspect-ratio: 1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.2), rgb(var(--accent-rgb) / 0));
    opacity: 0.5;
  }
  :global([data-theme='dark']) .cc__glow { opacity: 1; }
  .cc__kicker { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .cc__pulse { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .cc__pulse::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--ok); animation: cc-pulse 2.2s var(--ease-out) 3; }
  @keyframes cc-pulse { 0% { transform: scale(0.6); opacity: 1; } 100% { transform: scale(2); opacity: 0; } }
  .cc__title { font-size: clamp(1.45rem, 1.9vw, 1.75rem); line-height: 1.15; letter-spacing: -0.03em; }
  .cc__text { font-size: 0.93rem; color: var(--muted); max-width: 40ch; }
  .cc__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.4rem; }
  .cc__actions .btn { min-height: 48px; padding-inline: 1rem; font-size: 0.72rem; }
  .cc__call { grid-column: 1 / -1; }
  .cc__mail { display: flex; align-items: center; gap: 0.55rem; min-width: 0; padding-top: 0.9rem; margin-top: 0.3rem; border-top: 1px solid var(--line); font-size: 0.86rem; color: var(--muted); }
  .cc__mail :global(svg) { width: 16px; height: 16px; flex: none; color: var(--accent); }
  .cc__mail a { display: inline-block; min-width: 0; padding: 0.8rem 0; line-height: 1.4; color: var(--text-2); transition: color 0.3s; }
  .cc__mail a:hover { color: var(--accent); }

  /* Steps down with the window height so topics + card always fit in the viewport. */
  @media (min-width: 901px) and (max-height: 919px) {
    .cc--fit .cc__mail { display: none; }
  }
  @media (min-width: 901px) and (max-height: 819px) {
    .cc--fit { gap: 0.65rem; padding: 1.15rem 1.2rem 1.2rem; }
    .cc--fit .cc__title { font-size: 1.22rem; }
    .cc--fit .cc__text { display: none; }
    .cc--fit .cc__actions { margin-top: 0.15rem; gap: 0.5rem; }
    .cc--fit .cc__actions .btn { min-height: 44px; }
  }
  @media (min-width: 901px) and (max-height: 719px) {
    .cc--fit .cc__title { display: none; }
  }
</style>
