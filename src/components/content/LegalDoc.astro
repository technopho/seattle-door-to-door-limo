---
// Legal document layout: page head, review notice, sticky table of contents with scroll-spy, numbered sections.
// Section numbers on the headings come from a CSS counter (Prose `legal`), so the heading text stays clean.
import PageHead from './PageHead.astro';
import Prose from './Prose.astro';
import MobileToc from './MobileToc.astro';
import Icon from '../Icon.astro';
import { formatDate } from '../../data/posts';

export type LegalSection = { id: string; title: string; html: string };
interface Props {
  path: string;
  name: string;
  eyebrow: string;
  lead: string;
  /** ISO date (YYYY-MM-DD). */
  updated: string;
  sections: LegalSection[];
  related: { label: string; href: string };
  /** Shown until the client's counsel has reviewed the text. */
  pendingReview?: boolean;
}
const { path, name, eyebrow, lead, updated, sections, related, pendingReview = true } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const body = sections
  .map((s) => `<h2 id="${s.id}">${s.title}</h2>\n${s.html}`)
  .join('\n');
---
<PageHead trail={[[name, path]]} eyebrow={eyebrow} lead={lead} compact>
  <Fragment slot="title">{name}</Fragment>
  <Fragment slot="meta">
    <div class="ld-meta">
      <p class="ld-meta__date"><Icon name="calendar" /> Last updated <time datetime={updated}>{formatDate(updated)}</time></p>
      {pendingReview && (
        <p class="ld-note"><span class="ld-note__dot" aria-hidden="true"></span> Template — pending review by the client’s legal counsel</p>
      )}
    </div>
  </Fragment>
</PageHead>

<div class="ld container">
  <aside class="ld__aside">
    <nav class="ld-toc" aria-label="On this page" data-reveal="fade" data-lenis-prevent>
      <p class="ld-toc__label">On this page</p>
      <ol role="list" class="ld-toc__list" data-toc>
        {sections.map((s, i) => (
          <li><a href={`#${s.id}`} data-toc-link={s.id}><span class="ld-toc__num" aria-hidden="true">{pad(i + 1)}</span><span>{s.title}</span></a></li>
        ))}
      </ol>
    </nav>
  </aside>

  <div class="ld__main">
    <MobileToc items={sections.map((s) => ({ id: s.id, label: s.title }))} below={900} />

    <article class="ld__doc" aria-labelledby="page-title">
      <Prose size="legal" html={body} />
    </article>

    <div class="ld__end">
      <p class="ld__end-text">Questions about this document? <a href="/contact/">Contact us</a> and we’ll be glad to help.</p>
      <a href={related.href} class="link-underline">{related.label} <Icon name="arrow" size={14} /></a>
    </div>
  </div>
</div>

<style>
  /* ---------- Head meta ---------- */
  .ld-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 1.4rem; }
  .ld-meta__date { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.86rem; color: var(--text-2); }
  .ld-meta__date :global(svg) { width: 16px; height: 16px; color: var(--accent); }
  .ld-note {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.95rem;
    border: 1px dashed rgb(var(--accent-rgb) / 0.45);
    border-radius: 999px;
    background: rgb(var(--accent-rgb) / 0.06);
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--text-2);
  }
  .ld-note__dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  /* ---------- Layout ---------- */
  .ld {
    display: grid;
    grid-template-columns: minmax(220px, 290px) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: var(--section-y);
    border-top: 1px solid var(--line);
  }
  .ld__aside { align-self: stretch; }
  .ld-toc { position: sticky; top: calc(var(--header-h) + 1.25rem); max-height: calc(100vh - var(--header-h) - 2.5rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .ld-toc__label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); padding: 0 0 0.8rem 1rem; }
  .ld-toc__list { position: relative; display: grid; border-left: 1px solid var(--line); }
  .ld-toc__list a {
    position: relative;
    display: grid;
    grid-template-columns: 1.9rem 1fr;
    align-items: baseline;
    min-height: 40px;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    font-size: 0.88rem;
    line-height: 1.35;
    color: var(--muted);
    transition: color 0.3s;
  }
  .ld-toc__list a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.45rem;
    bottom: 0.45rem;
    width: 2px;
    border-radius: 2px;
    background: var(--accent-grad);
    transform: scaleY(0);
    transition: transform 0.5s var(--ease-out);
  }
  .ld-toc__list a:hover { color: var(--text); }
  .ld-toc__list a.is-active { color: var(--text); font-weight: 500; }
  .ld-toc__list a.is-active::before { transform: scaleY(1); }
  .ld-toc__num { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; color: var(--muted-2); font-variant-numeric: tabular-nums; }
  .ld-toc__list a.is-active .ld-toc__num { color: var(--accent); }

  .ld__main { min-width: 0; }
  .ld__doc { min-width: 0; }

  .ld__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: 68ch;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-strong);
  }
  .ld__end-text { color: var(--muted); font-size: 0.95rem; }
  .ld__end-text a { color: var(--text); text-decoration: underline; text-decoration-color: rgb(var(--accent-rgb) / 0.55); text-underline-offset: 0.22em; }
  .ld__end .link-underline { min-height: 44px; }
  .ld__end .link-underline::after { bottom: 9px; }

  @media (max-width: 900px) {
    .ld { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .ld__aside { display: none; }
  }
  @media (max-width: 560px) {
    .ld-note { border-radius: 14px; align-items: flex-start; }
    .ld-note__dot { margin-top: 0.4em; }
  }
</style>

<script>
  import { initTocSpy } from './tocSpy';

  initTocSpy();
</script>
