---
import Icon from '../Icon.astro';
import { fleet, site } from '../../data/site';
import { categories, paxRanges, meta, isStudio, catCount, pad, serviceLinks, cropStyle } from './fleetMeta';
const total = fleet.length;
---
<section class="fb" id="collection" aria-label="Browse the fleet">
  <div class="ff" data-ff>
    <div class="ff__inner container">
      <div class="ff__bar glass">
        <div class="ff__group ff__cats" role="group" aria-label="Vehicle type" data-ff-cats>
          <span class="ff__ind" aria-hidden="true"></span>
          {categories.map((c, i) => (
            <button type="button" class="ff__pill" data-cat={c.id} data-singular={c.singular} data-label={c.label} aria-pressed={i === 0 ? 'true' : 'false'}>
              {c.label}<span class="ff__n">{catCount(c.id)}</span>
            </button>
          ))}
        </div>

        <!-- Desktop: segmented guests control -->
        <div class="ff__paxwrap">
          <span class="ff__label"><Icon name="users" /> Guests</span>
          <div class="ff__group ff__seg" role="group" aria-label="Minimum number of guests" data-ff-pax>
            <span class="ff__ind" aria-hidden="true"></span>
            {paxRanges.map((p, i) => (
              <button type="button" class="ff__pill ff__pill--seg" data-pax={p.min} data-label={p.label} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>
            ))}
          </div>
        </div>

        <!-- Tablet & phone: one compact pill backed by a native select -->
        <label class="ff__select" data-ff-select-wrap>
          <Icon name="users" />
          <span class="ff__select-lab">Guests</span>
          <span class="ff__select-val" data-ff-pax-val>Any</span>
          <svg class="ff__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          <select data-ff-pax-select aria-label="Minimum number of guests">
            {paxRanges.map((p) => <option value={p.min}>{p.min ? `${p.label} guests` : 'Any group size'}</option>)}
          </select>
        </label>

        <p class="ff__count" aria-live="polite" data-ff-count><span class="ff__shown" data-ff-shown>{total}</span><span class="ff__of"> of {total}</span><span class="ff__word"> vehicles</span></p>
      </div>
      <p class="ff__toast" data-ff-toast aria-hidden="true"></p>
    </div>
  </div>

  <div class="container fb__list" data-ff-list>
    {fleet.map((v, i) => {
      const m = meta[v.id];
      const studio = isStudio(v);
      const reserve = `/book/?vehicle=${v.id}`;
      const links = serviceLinks(v.id);
      return (
        <article
          id={v.id}
          class:list={['vh', i % 2 === 1 && 'is-rev', i === 0 && 'is-first', studio && 'vh--studio', m.grade && 'vh--grade']}
          data-vehicle
          data-cat={m.cat}
          data-pax={v.passengers}
          aria-labelledby={`vh-${v.id}`}
        >
          <div class="vh__stage" data-tilt>
            <div class="vh__card" data-tilt-card>
              <a href={reserve} class="vh__frame media" data-reveal="scale" data-cursor="Reserve" data-theme={studio ? 'light' : undefined} tabindex="-1" aria-hidden="true">
                <div class="vh__zoom">
                  <div class:list={['vh__crop', m.crop && 'is-crop']} style={cropStyle(v.id)}>
                    <img src={v.image} alt={m.alt} width="1600" height="1000" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style={m.position ? `object-position:${m.position}` : undefined} />
                  </div>
                </div>
                <span class="vh__glare" aria-hidden="true"></span>
                <span class="vh__tag">{v.category}</span>
                {studio && <span class="vh__studio-note">Up to {v.passengers} guests · {v.luggage} bags</span>}
              </a>
            </div>
          </div>

          <div class="vh__info" data-stagger="0.07">
            <p class="vh__meta"><span class="vh__idx">{pad(i + 1)} <i>/ {pad(total)}</i></span><span class="eyebrow">{v.category}</span></p>
            <h2 class="vh__name" id={`vh-${v.id}`}>{m.make} <em>{m.model}</em></h2>
            <p class="vh__intro">{m.intro}</p>
            <dl class="vh__specs">
              <div class="vh__spec">
                <dt><Icon name="users" /> Passengers</dt>
                <dd><span class="vh__big">{v.passengers}</span> <span class="vh__unit">guests</span></dd>
              </div>
              <div class="vh__spec">
                <dt><Icon name="suitcase" /> Luggage</dt>
                <dd><span class="vh__big">{v.luggage}</span> <span class="vh__unit">bags</span></dd>
              </div>
              <div class="vh__spec vh__spec--wide">
                <dt><Icon name="sparkle" /> Best for</dt>
                <dd class="vh__best">{v.bestFor}</dd>
              </div>
            </dl>
            <ul class="vh__features" role="list">
              {v.features.map((f) => <li><Icon name="check" /> {f}</li>)}
            </ul>
            {links.length > 0 && (
              <div class="vh__svc">
                <span class="vh__svc-lab" id={`vh-${v.id}-svc`}>Ideal for</span>
                <ul class="vh__svc-list" role="list" aria-labelledby={`vh-${v.id}-svc`}>
                  {links.map((l) => (
                    <li><a href={l.href} class="vh__svc-link">{l.label}<Icon name="arrow-up-right" /></a></li>
                  ))}
                </ul>
              </div>
            )}
            <div class="vh__ctas">
              <a href={reserve} class="btn btn--gold" data-magnetic="0.2">Reserve the {m.short} <Icon name="arrow" /></a>
              <a href={site.phoneHref} class="vh__call"><Icon name="phone" /> <span>Or call <strong>{site.phone}</strong></span></a>
            </div>
          </div>
        </article>
      );
    })}

    <div class="fb__empty" data-ff-empty hidden>
      <span class="fb__empty-icon" aria-hidden="true"><Icon name="car" /></span>
      <p class="eyebrow">No exact match</p>
      <h3 class="fb__empty-title" data-ff-empty-title>Nothing fits that combination.</h3>
      <p class="muted">Try another vehicle type, or let our concierge recommend the right fit for your group.</p>
      <div class="fb__empty-ctas">
        <button type="button" class="btn btn--gold" data-ff-widen><span data-ff-widen-label>Show all vehicles</span> <Icon name="arrow" /></button>
        <button type="button" class="btn btn--ghost" data-ff-reset>Reset filters</button>
        <a href={site.phoneHref} class="link-underline fb__empty-call"><Icon name="phone" /> {site.phone}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* ---------- 3D tilt toward the cursor (desktop only) ---------- */
  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((stage) => {
      const card = stage.querySelector<HTMLElement>('[data-tilt-card]');
      if (!card) return;
      gsap.set(card, { transformPerspective: 1600, transformOrigin: '50% 50%' });
      const rx = gsap.quickTo(card, 'rotationX', { duration: 0.9, ease: 'power3.out' });
      const ry = gsap.quickTo(card, 'rotationY', { duration: 0.9, ease: 'power3.out' });
      let raf = 0;
      stage.addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = stage.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          ry(px * 7);
          rx(-py * 5);
          card.style.setProperty('--gx', `${(px + 0.5) * 100}%`);
          card.style.setProperty('--gy', `${(py + 0.5) * 100}%`);
        });
      });
      stage.addEventListener('pointerleave', () => { rx(0); ry(0); });
    });
  }

  /* ---------- Filtering ---------- */
  const root = document.querySelector<HTMLElement>('[data-ff]');
  const section = root?.closest<HTMLElement>('.fb') ?? null;
  const list = document.querySelector<HTMLElement>('[data-ff-list]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-vehicle]'));
  const total = rows.length;
  const empty = document.querySelector<HTMLElement>('[data-ff-empty]');
  const emptyTitle = document.querySelector<HTMLElement>('[data-ff-empty-title]');
  const shownEl = document.querySelector<HTMLElement>('[data-ff-shown]');
  const countEl = document.querySelector<HTMLElement>('[data-ff-count]');
  const toast = document.querySelector<HTMLElement>('[data-ff-toast]');
  const catGroup = document.querySelector<HTMLElement>('[data-ff-cats]');
  const paxGroup = document.querySelector<HTMLElement>('[data-ff-pax]');
  const paxSelect = document.querySelector<HTMLSelectElement>('[data-ff-pax-select]');
  const paxSelectWrap = document.querySelector<HTMLElement>('[data-ff-select-wrap]');
  const paxVal = document.querySelector<HTMLElement>('[data-ff-pax-val]');

  const widenLabel = document.querySelector<HTMLElement>('[data-ff-widen-label]');
  const emptyArr: HTMLElement[] = empty ? [empty] : [];
  const state = { cat: 'all', pax: 0 };
  let busy: gsap.core.Timeline | null = null;

  const matches = (el: HTMLElement) =>
    (state.cat === 'all' || el.dataset.cat === state.cat) && Number(el.dataset.pax) >= state.pax;

  const paxLabel = (min: number) => paxGroup?.querySelector<HTMLElement>(`[data-pax="${min}"]`)?.dataset.label ?? '';

  function moveIndicator(group: HTMLElement | null, instant = false) {
    if (!group) return;
    const ind = group.querySelector<HTMLElement>('.ff__ind');
    const active = group.querySelector<HTMLElement>('[aria-pressed="true"]');
    if (!ind || !active) return;
    const vars = { x: active.offsetLeft, width: active.offsetWidth, height: active.offsetHeight, y: active.offsetTop };
    if (instant || reduce) gsap.set(ind, vars);
    else gsap.to(ind, { ...vars, duration: 0.7, ease: 'expo.out' });
    // keep the active pill in view inside the horizontally scrollable group (tablet / mobile)
    if (group.scrollWidth > group.clientWidth + 2) {
      const target = active.offsetLeft - (group.clientWidth - active.offsetWidth) / 2;
      group.scrollTo({ left: Math.max(0, target), behavior: instant || reduce ? 'auto' : 'smooth' });
    }
  }

  function press(group: HTMLElement | null, btn: HTMLElement | null) {
    if (!group || !btn) return;
    group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
  }

  /* Feedback on every change, even when the visible set does not change. */
  let toastT = 0;
  function feedback(n: number) {
    if (countEl) {
      countEl.classList.remove('is-pulse');
      void countEl.offsetWidth;
      countEl.classList.add('is-pulse');
    }
    if (toast) {
      toast.textContent = n === 0 ? 'No exact match' : n === total ? `Showing all ${total} vehicles` : `Showing ${n} of ${total} vehicles`;
      toast.classList.add('is-show');
      clearTimeout(toastT);
      toastT = window.setTimeout(() => toast.classList.remove('is-show'), 1900);
    }
  }

  function layout() {
    let n = 0;
    rows.forEach((r) => {
      const show = matches(r);
      r.hidden = !show;
      if (show) { r.classList.toggle('is-rev', n % 2 === 1); r.classList.toggle('is-first', n === 0); n++; }
    });
    if (shownEl) shownEl.textContent = String(n);
    if (empty) {
      empty.hidden = n > 0;
      if (n === 0 && emptyTitle) {
        const catBtn = catGroup?.querySelector<HTMLElement>(`[data-cat="${state.cat}"]`);
        const lbl = paxLabel(state.pax);
        emptyTitle.innerHTML = `No ${catBtn?.dataset.singular ?? 'vehicle'} seats <em>${lbl} guests.</em>`;
        if (widenLabel) widenLabel.textContent = state.pax ? `Show every vehicle for ${lbl}` : 'Show all vehicles';
      }
    }
    return n;
  }

  function apply() {
    busy?.progress(1).kill();
    const before = rows.filter((r) => !r.hidden);
    const after = rows.filter(matches);
    const same = before.length === after.length && before.every((r, i) => r === after[i]) && (!empty || empty.hidden === after.length > 0);
    feedback(after.length);
    if (same) return;

    if (reduce) { layout(); ScrollTrigger.refresh(); window.lenis?.resize(); return; }

    const outgoing = [...before, ...emptyArr.filter((el) => !el.hidden)];
    busy = gsap.timeline();
    busy.to(outgoing, { opacity: 0, y: 24, duration: 0.38, ease: 'power2.in', stagger: 0.025 })
      .add(() => {
        layout();
        gsap.set([...rows, ...emptyArr], { clearProps: 'opacity,transform' });
        window.lenis?.resize();
        // If the visitor is deep in the list, bring the results back into view while they're hidden.
        if (list && list.getBoundingClientRect().top < 0) {
          const y = list.getBoundingClientRect().top + window.scrollY - 150;
          if (window.lenis) window.lenis.scrollTo(y, { immediate: true });
          else window.scrollTo(0, y);
        }
        ScrollTrigger.refresh();
      })
      .fromTo(
        [...after, ...(after.length ? [] : emptyArr)],
        { opacity: 0, y: 60 },
        { opacity: 1, y: 0, duration: 1.1, ease: 'expo.out', stagger: 0.09, clearProps: 'transform' },
      );
  }

  function setCat(id: string) {
    state.cat = id;
    press(catGroup, catGroup?.querySelector<HTMLElement>(`[data-cat="${id}"]`) ?? null);
    moveIndicator(catGroup);
  }
  function setPax(min: number) {
    state.pax = min;
    press(paxGroup, paxGroup?.querySelector<HTMLElement>(`[data-pax="${min}"]`) ?? null);
    moveIndicator(paxGroup);
    if (paxSelect) paxSelect.value = String(min);
    if (paxVal) paxVal.textContent = paxLabel(min) || 'Any';
    paxSelectWrap?.classList.toggle('is-active', min > 0);
  }

  catGroup?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-cat]');
    if (!b) return;
    if (b.getAttribute('aria-pressed') === 'true') { feedback(rows.filter(matches).length); return; }
    setCat(b.dataset.cat || 'all');
    apply();
  });
  paxGroup?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-pax]');
    if (!b) return;
    if (b.getAttribute('aria-pressed') === 'true') { feedback(rows.filter(matches).length); return; }
    setPax(Number(b.dataset.pax) || 0);
    apply();
  });
  paxSelect?.addEventListener('change', () => { setPax(Number(paxSelect.value) || 0); apply(); });

  document.querySelector('[data-ff-widen]')?.addEventListener('click', () => { setCat('all'); apply(); });
  document.querySelector('[data-ff-reset]')?.addEventListener('click', () => { setCat('all'); setPax(0); apply(); });

  // Deep links (footer, quick-match list, comparison table): make sure a filtered-out vehicle is visible
  // before scrolling to it. Runs in the capture phase, ahead of the global Lenis anchor handler.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!a) return;
    const url = new URL(a.href, location.href);
    if (url.pathname !== location.pathname || !url.hash) return;
    const row = rows.find((r) => `#${r.id}` === url.hash);
    if (!row || !row.hidden) return;
    busy?.progress(1).kill();
    setCat('all'); setPax(0); layout();
    gsap.set([...rows, ...emptyArr], { clearProps: 'opacity,transform' });
    ScrollTrigger.refresh();
    // The page just grew: refresh Lenis' cached scroll limit, otherwise scrollTo() is clamped
    // to the old (shorter) maximum and stops thousands of pixels short of the row.
    window.lenis?.resize();
  }, true);

  // Fade hint on the scrollable category row disappears once scrolled to the end (or when it fits).
  const checkEnd = () => {
    if (!catGroup) return;
    catGroup.classList.toggle('is-end', catGroup.scrollLeft + catGroup.clientWidth >= catGroup.scrollWidth - 4);
  };
  catGroup?.addEventListener('scroll', checkEnd, { passive: true });
  // Keyboard: keep a focused pill clear of the right-edge fade on narrow screens.
  catGroup?.addEventListener('focusin', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-cat]');
    if (!b || catGroup.scrollWidth <= catGroup.clientWidth + 2) return;
    const target = b.offsetLeft - (catGroup.clientWidth - b.offsetWidth) / 2;
    catGroup.scrollTo({ left: Math.max(0, target), behavior: reduce ? 'auto' : 'smooth' });
  });

  // Initial indicator placement (after fonts settle) + on resize.
  root?.classList.add('is-ready');
  const place = () => { moveIndicator(catGroup, true); moveIndicator(paxGroup, true); checkEnd(); };
  place();
  document.fonts?.ready.then(place);
  let rt = 0;
  window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(place, 120); });

  // Darken the bar only while it is actually pinned (its top sits at its sticky offset).
  if (root && section) {
    let ticking = false;
    const checkStuck = () => {
      ticking = false;
      const top = parseFloat(getComputedStyle(root).top) || 0;
      const r = root.getBoundingClientRect();
      const inSection = section.getBoundingClientRect().bottom > r.height + top + 40;
      root.classList.toggle('is-stuck', Math.abs(r.top - top) < 1.5 && inSection);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(checkStuck); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    root.addEventListener('transitionend', onScroll);
    checkStuck();
  }
</script>

<style>
  /* Local shading tokens. Ivory: soft onyx shadows and a light photo vignette.
     Onyx: deep shadows and photos that sink into the page, as before. */
  .fb {
    position: relative;
    padding-bottom: clamp(3rem, 7vw, 6rem);
    --fb-ink: var(--fg-rgb);
    --fb-scrim: 0.16;
    --fb-shadow-bar: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 18px 44px -26px rgb(var(--fg-rgb) / 0.32);
    --fb-shadow-bar-stuck: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 22px 50px -26px rgb(var(--fg-rgb) / 0.4);
    --fb-shadow-img: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 46px 80px -52px rgb(var(--fg-rgb) / 0.55);
    --fb-shadow-toast: 0 14px 30px -14px rgb(var(--fg-rgb) / 0.45);
  }
  :global([data-theme='dark']) .fb {
    --fb-ink: var(--bg-rgb);
    --fb-scrim: 0.55;
    --fb-shadow-bar: 0 18px 50px -20px rgb(var(--bg-rgb) / 0.8);
    --fb-shadow-bar-stuck: 0 24px 60px -24px rgb(var(--bg-rgb) / 0.95);
    --fb-shadow-img: 0 50px 90px -50px rgb(var(--bg-rgb) / 0.95);
    --fb-shadow-toast: 0 14px 30px -12px rgb(var(--bg-rgb) / 0.8);
  }

  /* ---------- Sticky filter bar ----------
     Only the sticky offset moves when the header hides, so the bar never shifts while it is still in normal flow. */
  .ff {
    position: sticky;
    top: 70px;
    z-index: 40;
    padding-block: 1rem 0.5rem;
    transition: top 0.6s var(--ease-out);
  }
  :global(body:has(.header.is-hidden)) .ff { top: 0; }
  .ff__inner { position: relative; }
  .ff__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 6px;
    border-radius: 999px;
    border-color: var(--line-strong);
    box-shadow: var(--fb-shadow-bar);
    transition: background 0.4s, box-shadow 0.4s;
  }
  .ff.is-stuck .ff__bar { background: rgb(var(--bg-rgb) / 0.88); box-shadow: var(--fb-shadow-bar-stuck); }
  .ff__group { position: relative; display: flex; align-items: center; gap: 2px; isolation: isolate; }
  .ff__cats {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(90deg, #000 80%, transparent);
    mask-image: linear-gradient(90deg, #000 80%, transparent);
  }
  .ff__cats.is-end { -webkit-mask-image: none; mask-image: none; }
  .ff__cats::-webkit-scrollbar { display: none; }
  .ff__ind {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 0;
    height: 44px;
    border-radius: 999px;
    background: var(--text);
    opacity: 0;
    pointer-events: none;
  }
  .ff.is-ready .ff__ind { opacity: 1; }
  .ff__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    min-height: 44px;
    padding: 0 1.05rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-2);
    white-space: nowrap;
    transition: color 0.45s var(--ease-out);
  }
  .ff__pill:hover { color: var(--text); }
  .ff__pill[aria-pressed='true'] { color: var(--bg); }
  /* The category row is a scroll container, so an outside ring would be clipped: draw it inside the pill.
     On the filled (pressed) pill the ring switches to the pill's text colour so it stays high-contrast. */
  .ff__pill:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .ff__pill[aria-pressed='true']:focus-visible { outline-color: var(--bg); outline-offset: -4px; }
  .ff:not(.is-ready) .ff__pill[aria-pressed='true'] { background: var(--text); }
  .ff__n { font-size: 0.62rem; font-weight: 500; letter-spacing: 0.04em; color: var(--muted); font-variant-numeric: tabular-nums; transition: color 0.45s; }
  .ff__pill[aria-pressed='true'] .ff__n { color: rgb(var(--bg-rgb) / 0.72); }
  .ff__paxwrap { display: flex; align-items: center; gap: 0.6rem; flex: none; padding-left: 1rem; border-left: 1px solid var(--line); }
  .ff__label { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .ff__label :global(svg) { width: 15px; height: 15px; color: var(--accent); }
  .ff__seg { padding: 0; }
  .ff__pill--seg { min-width: 52px; justify-content: center; padding: 0 0.85rem; letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }

  /* Compact guests pill (tablet & phone) */
  .ff__select {
    position: relative;
    display: none;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    min-height: 44px;
    padding: 0 0.95rem 0 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.4s, background 0.4s;
  }
  .ff__select :global(svg) { width: 15px; height: 15px; color: var(--accent); flex: none; }
  .ff__select .ff__chev { width: 13px; height: 13px; color: var(--muted); }
