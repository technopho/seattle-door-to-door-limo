---
import Icon from '../Icon.astro';
import { site, images, fleet } from '../../data/site';
import { meta } from './fleetMeta';

// Quick-match shortcuts derived from each vehicle's "best for" line in site.ts.
const picks = [
  { id: 's550', occasion: 'Airport runs & executives' },
  { id: 'escalade', occasion: 'Families & small groups' },
  { id: 'stretch', occasion: 'Weddings, proms & anniversaries' },
  { id: 'sprinter', occasion: 'Corporate groups & cruise transfers' },
  { id: 'party-sprinter', occasion: 'Bachelor parties & birthdays' },
].map((p) => {
  const v = fleet.find((f) => f.id === p.id)!;
  return { ...p, name: `${meta[p.id].make} ${meta[p.id].model}`, pax: v.passengers };
});
---
<section class="section help" aria-labelledby="help-title">
  <div class="container">
    <div class="help__card">
      <div class="help__bg" aria-hidden="true">
        <div class="help__par" data-parallax="0.08"><img src={images.skyline} alt="" loading="lazy" decoding="async" /></div>
      </div>

      <div class="help__copy">
        <p class="eyebrow" data-reveal="fade">Concierge</p>
        <h2 id="help-title" data-split><span>Not</span> <span>sure</span> <span>which</span> <em><span>to</span> <span>choose?</span></em></h2>
        <p class="lead" data-reveal data-delay="0.15">Tell us the occasion, the headcount and the luggage. Our team will recommend the right vehicle, and every booking is confirmed by a real person within minutes.</p>
        <div class="help__ctas" data-reveal data-delay="0.25">
          <a href="/book/" class="btn btn--gold btn--lg" data-magnetic>Help me choose <Icon name="arrow" /></a>
          <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-cursor="Call"><Icon name="phone" /> Call {site.phone}</a>
        </div>
        <p class="help__live" data-reveal="fade" data-delay="0.35"><span class="help__dot" aria-hidden="true"></span> Concierge available 24/7</p>
      </div>

      <div class="help__match">
        <p class="help__label" data-reveal="fade">Quick match</p>
        <ol class="help__list" role="list" data-stagger="0.07">
          {picks.map((p) => (
            <li>
              <a href={`#${p.id}`} class="help__item">
                <span class="help__occ">{p.occasion}</span>
                <span class="help__veh">{p.name}</span>
                <span class="help__pax"><Icon name="users" /> {p.pax}</span>
                <span class="help__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .help { padding-top: clamp(4rem, 9vw, 8rem); }
  .help__card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(2rem, 5.5vw, 5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--ink-2);
  }
  .help__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 10, 12, 0.94) 0%, rgba(10, 10, 12, 0.82) 45%, rgba(10, 10, 12, 0.9) 100%),
      radial-gradient(60% 80% at 15% 0%, rgba(201, 168, 106, 0.16), transparent 70%);
  }
  .help__bg { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .help__par { position: absolute; inset: -10% 0; }
  .help__par img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; filter: grayscale(0.25) contrast(1.05); }

  .help__copy { display: grid; gap: 1.4rem; justify-items: start; }
  .help__copy h2 { max-width: 14ch; }
  .help__copy h2 :global(.split-line) { vertical-align: top; }
  .help__copy h2 :global(em .split-word) { background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.06em; }
  .help__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }
  .help__live { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .help__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px rgba(127, 200, 160, 0.15); }

  .help__match {
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: rgba(14, 14, 17, 0.6);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .help__label { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--gold); padding: 0 0.6rem 0.8rem; }
  .help__list { display: grid; }
  .help__list li + li { border-top: 1px solid var(--line); }
  .help__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas: 'occ pax arrow' 'veh pax arrow';
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.15rem;
    min-height: 64px;
    padding: 0.85rem 0.6rem;
    border-radius: 12px;
    transition: background 0.4s var(--ease-out);
  }
  .help__item:hover { background: rgba(243, 238, 228, 0.04); }
  .help__occ { grid-area: occ; font-size: 0.78rem; color: var(--muted); }
  .help__veh { grid-area: veh; font-family: var(--font-display); font-size: 1.45rem; line-height: 1.1; color: var(--ivory); transition: color 0.4s; }
  .help__item:hover .help__veh { color: var(--gold-2); }
  .help__pax { grid-area: pax; display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; font-weight: 600; color: var(--ivory-2); font-variant-numeric: tabular-nums; }
  .help__pax :global(svg) { width: 15px; height: 15px; color: var(--gold); }
  .help__arrow { grid-area: arrow; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background 0.4s var(--ease-out), border-color 0.4s, color 0.4s; }
  .help__arrow :global(svg) { width: 14px; height: 14px; }
  .help__item:hover .help__arrow { background: var(--gold-grad); border-color: transparent; color: #17130b; }

  @media (max-width: 980px) {
    .help__card { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .help__card { padding: 1.6rem 1.15rem 1.2rem; border-radius: var(--radius); }
    .help__ctas { display: grid; width: 100%; }
    .help__ctas .btn { width: 100%; padding-inline: 1rem; }
    .help__match { padding: 0.8rem 0.4rem; margin-inline: -0.35rem; }
    .help__veh { font-size: 1.3rem; }
  }
</style>
