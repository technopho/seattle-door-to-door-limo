---
// Typeset wordmark with a Space Needle monogram (replaces the old blue PNG logo).
interface Props { class?: string; compact?: boolean }
const { class: cls = '', compact = false } = Astro.props;
// Unique gradient id per instance: the header and footer logos can sit in different
// theme scopes, and a shared id would paint both with the first instance's colors.
const gid = `lg-${Math.random().toString(36).slice(2, 8)}`;
// The accessible name starts with the visible wordmark (WCAG 2.5.3 label in name), so voice users
// can say what they see; the icon-only compact logo carries the full business name.
const label = compact ? 'Seattle Door to Door Limo, home' : 'Door to Door Seattle Limousine, home';
---
<a href="/" class:list={['logo', cls, compact && 'logo--compact']} aria-label={label} data-cursor="Home">
  <svg class="logo__mark" viewBox="0 0 40 48" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color: var(--accent-2)" /><stop offset=".55" style="stop-color: var(--accent)" /><stop offset="1" style="stop-color: var(--accent-3)" />
      </linearGradient>
    </defs>
    <path d="M20 2 L21.4 15 L20 46 L18.6 15 Z" fill={`url(#${gid})`} />
    <ellipse cx="20" cy="14" rx="11" ry="2.8" fill="none" stroke={`url(#${gid})`} stroke-width="1.6" />
    <path d="M13 18 L17.5 46 M27 18 L22.5 46" stroke={`url(#${gid})`} stroke-width="1" fill="none" opacity=".7" />
    <path d="M8 46 H32" stroke={`url(#${gid})`} stroke-width="1.2" />
  </svg>
  {!compact && (
    <span class="logo__text">
      <span class="logo__name">Door <em>to</em> Door</span>{' '}{/* keeps "Door Seattle" two words in the text (grid ignores it) */}
      <span class="logo__sub">Seattle <i aria-hidden="true"></i> Limousine</span>
    </span>
  )}
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--text); }
  .logo__mark { width: 28px; height: 36px; flex: none; transition: transform 0.6s var(--ease-out); }
  .logo:hover .logo__mark { transform: translateY(-2px) scale(1.04); }
  .logo__text { display: grid; justify-items: start; line-height: 1; gap: 6px; padding-left: 0.75rem; border-left: 1px solid var(--line-strong); }
  .logo__name { font-family: var(--font-display); font-weight: 600; font-size: 1.12rem; letter-spacing: 0.2em; margin-right: -0.2em; text-transform: uppercase; white-space: nowrap; }
  .logo__name em { font-style: normal; font-weight: 300; color: var(--accent); }
  .logo__sub { display: inline-flex; align-items: center; gap: 0.5em; font-size: 0.6rem; letter-spacing: 0.32em; margin-right: -0.32em; text-transform: uppercase; color: var(--muted); font-weight: 600; white-space: nowrap; }
  .logo__sub i { width: 3px; height: 3px; border-radius: 50%; background: var(--accent); margin-right: 0.4em; }
  @media (max-width: 420px) {
    .logo { gap: 0.6rem; }
    .logo__text { padding-left: 0.6rem; gap: 5px; }
    .logo__name { font-size: 1rem; letter-spacing: 0.17em; margin-right: -0.17em; }
    .logo__sub { font-size: 0.58rem; letter-spacing: 0.28em; margin-right: -0.28em; }
  }
</style>
