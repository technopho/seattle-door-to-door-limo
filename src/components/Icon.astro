  facebook: '<path d="M14 8.5V6.8c0-.8.5-1.3 1.3-1.3H17V2.3h-2.6C11.8 2.3 10.5 4 10.5 6.4v2.1H8v3.2h2.5V21.7H14V11.7h2.6l.5-3.2z"/>',
