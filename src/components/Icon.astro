};
const body = paths[name] ?? paths.arrow;
---
<svg
  class:list={['icon', `icon-${name}`, name === 'arrow' && 'arrow', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={body}
/>
