  ship: '<path d="M3 17l1.5 3.5h15L21 17l-9-3zM5 15.3V9h14v6.3M12 4v10M9 6.5h6"/>',
  rings: '<circle cx="9" cy="14" r="5.5"/><circle cx="15" cy="14" r="5.5"/><path d="M9 5l1.5-2h3L15 5l-3 3z"/>',
