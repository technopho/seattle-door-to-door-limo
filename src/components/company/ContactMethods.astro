---
import Icon from '../Icon.astro';
import { site } from '../../data/site';

const methods = [
  {
    href: site.phoneHref,
    icon: 'phone',
    k: 'Call · fastest',
    v: site.phone,
    note: 'Best for same-day rides, airport pickups and changes to a booking.',
    primary: true,
    cursor: 'Call',
  },
  {
    href: site.smsHref,
    icon: 'chat',
    k: 'Text',
    v: site.phone,
    note: 'Send your pickup, time and party size, and we reply by text.',
    cursor: 'Text',
  },
  {
    href: `mailto:${site.email}`,
    icon: 'mail',
    k: 'Email',
    v: site.email,
    email: true,
    note: 'Best for quotes, corporate accounts and event planning.',
    cursor: 'Email',
  },
];
---
<section class="cm" aria-labelledby="cm-title">
  <h2 id="cm-title" class="cm__title">Ways to reach us</h2>
  <ul class="cm__list" role="list" data-stagger="0.08">
    {methods.map((m) => (
      <li>
        <a href={m.href} class:list={['cm__card', m.primary && 'cm__card--primary']} data-cursor={m.cursor}>
          <span class="cm__icon" aria-hidden="true"><Icon name={m.icon} /></span>
          <span class="cm__body">
            <span class="cm__k">{m.k}</span>
            {m.email
              ? <span class="cm__v cm__v--email">{m.v.split('@')[0]}@<wbr />{m.v.split('@')[1]}</span>
              : <span class="cm__v">{m.v}</span>}
            <span class="cm__note">{m.note}</span>
          </span>
          <span class="cm__go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
        </a>
      </li>
    ))}
  </ul>

  <div class="cm__hours" data-reveal data-delay="0.2">
    <span class="cm__dot" aria-hidden="true"></span>
    <p><strong>Available 24/7.</strong> Reservations, changes and questions, any hour of the day or night.</p>
  </div>
</section>

<style>
  .cm { display: grid; gap: 1.1rem; }
  .cm__title { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .cm__list { display: grid; gap: 0.75rem; }
  .cm__card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    min-height: 96px;
    padding: 1.15rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card-bg);
    box-shadow: var(--card-highlight), var(--card-shadow);
    transition: transform 0.6s var(--ease-out), border-color 0.4s, box-shadow 0.6s var(--ease-out);
  }
  .cm__card:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: var(--card-highlight), var(--card-shadow-hover); }
  .cm__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--accent);
    transition: background 0.4s var(--ease-out), color 0.4s, border-color 0.4s;
  }
  .cm__icon :global(svg) { width: 21px; height: 21px; }
  .cm__body { display: grid; gap: 0.2rem; min-width: 0; }
  .cm__k { font-size: 0.64rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .cm__v {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text);
    overflow-wrap: anywhere;
    font-variant-numeric: lining-nums;
  }
  .cm__v--email { font-size: clamp(1rem, 1.3vw, 1.18rem); letter-spacing: -0.015em; }
  .cm__note { font-size: 0.82rem; line-height: 1.45; color: var(--muted); }
  .cm__go {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background 0.4s var(--ease-out), color 0.4s, border-color 0.4s, transform 0.5s var(--ease-out);
  }
  .cm__go :global(svg) { width: 14px; height: 14px; }
  .cm__card:hover .cm__go { background: var(--cta-bg); color: var(--cta-fg); border-color: transparent; }
  .cm__card:hover .cm__icon { border-color: var(--accent); }

  /* Call is the primary channel: an onyx card in Ivory, a champagne-lit card in Onyx */
  .cm__card--primary { background: var(--cta-bg); background-size: 200% 100%; border-color: transparent; box-shadow: var(--cta-glow); }
  .cm__card--primary:hover { border-color: transparent; box-shadow: var(--cta-glow); }
  .cm__card--primary .cm__v, .cm__card--primary .cm__k { color: var(--cta-fg); }
  .cm__card--primary .cm__note { color: var(--cta-fg); opacity: 0.72; }
  .cm__card--primary .cm__icon, .cm__card--primary .cm__go { color: var(--cta-fg); border-color: color-mix(in srgb, var(--cta-fg) 28%, transparent); }
  .cm__card--primary:hover .cm__go { background: var(--cta-fg); color: var(--text); }
  :global([data-theme='dark']) .cm__card--primary:hover .cm__go { color: var(--on-accent); }
  .cm__card--primary:hover .cm__icon { border-color: var(--cta-fg); }

  .cm__hours { display: flex; align-items: flex-start; gap: 0.8rem; padding: 0.9rem 0.2rem 0; font-size: 0.88rem; line-height: 1.5; color: var(--text-2); }
  .cm__hours strong { color: var(--text); font-weight: 600; }
  .cm__dot { flex: none; width: 8px; height: 8px; margin-top: 0.45em; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent); animation: cm-pulse 2.4s var(--ease-in-out) 3; }
  /* Three beats, then rest (like the header's live dot): an endless box-shadow pulse keeps an idle page repainting. */
  @keyframes cm-pulse { 50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--ok) 6%, transparent); } }

  @media (max-width: 640px) {
    .cm__card { gap: 0.9rem; min-height: 88px; padding: 1rem; }
    .cm__icon { width: 46px; height: 46px; }
    .cm__go { display: none; }
    .cm__card { grid-template-columns: auto minmax(0, 1fr); }
  }
</style>
