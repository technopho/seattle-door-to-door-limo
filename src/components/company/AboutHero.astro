---
import Icon from '../Icon.astro';
import Crumbs from './Crumbs.astro';
import { site, images } from '../../data/site';

const facts = [
  { k: 'Established', v: String(site.since), sub: 'Seattle, Washington' },
  { k: 'Rated', v: site.rating.score, sub: `From ${site.rating.count} reviews`, stars: true },
  { k: 'Concierge', v: '24/7', sub: 'Real people, every hour' },
  { k: 'Chauffeurs', v: 'Vetted', sub: 'Licensed & background-checked' },
];
---
<section class="ah" aria-labelledby="about-title">
  <div class="ah__wash" aria-hidden="true"></div>
  <div class="container">
    <Crumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} class="ah__crumbs" />

    <div class="ah__head">
      <div class="ah__main">
        <p class="eyebrow" data-reveal="fade">About Seattle Door to Door Limo</p>
        <h1 id="about-title" class="ah__title" data-split>Seattle’s private chauffeur service <em>since {site.since}.</em></h1>
      </div>
      <div class="ah__aside" data-reveal data-delay="0.25">
        <p class="lead">Executives, families, couples and night owls ride with us for the same reason: we drive punctually, discreetly, door to door. This is who we are, and the standard we hold every ride to.</p>
        <div class="ah__ctas">
          <a href="/book/" class="btn btn--gold" data-magnetic>Reserve a ride <Icon name="arrow" /></a>
          <a href="#standard" class="ah__link link-underline">Our standard <Icon name="chevron" /></a>
        </div>
      </div>
    </div>

    <figure class="ah__figure">
      <div class="ah__media" data-reveal="scale">
        <div class="ah__par" data-parallax="0.035">
          <img
            src={images.skyline}
            alt="Seattle skyline and the Space Needle with Mount Rainier on the horizon"
            width="1280"
            height="853"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <span class="ah__shade" data-theme="dark" aria-hidden="true"></span>
        <figcaption class="ah__cap" data-theme="dark"><Icon name="pin" /> Seattle, WA</figcaption>
      </div>

      <dl class="ah__facts" data-stagger="0.08">
        {facts.map((f) => (
          <div class="ah__fact">
            <dt class="ah__fact-k">{f.k}</dt>
            <dd class="ah__fact-v">
              {f.v}
              {f.stars && <span class="ah__stars" aria-hidden="true"><Icon name="star" /></span>}
            </dd>
            <dd class="ah__fact-sub">{f.sub}</dd>
          </div>
        ))}
      </dl>
    </figure>
  </div>
</section>

<style>
  .ah { position: relative; isolation: isolate; padding: calc(var(--header-h) + 0.6rem) 0 clamp(3.5rem, 7vw, 6rem); overflow: clip; }
  /* Soft daylight bloom behind the headline (ivory) / a faint champagne glow (onyx) */
  .ah__wash {
    position: absolute;
    z-index: -1;
    inset: -20% -10% auto 30%;
    height: 80%;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--bg-3), transparent 75%);
  }
  :global([data-theme='dark']) .ah__wash { background: radial-gradient(closest-side, rgb(var(--accent-rgb) / 0.08), transparent 75%); }

  .ah__head {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem clamp(2.5rem, 6vw, 6rem);
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }
  .ah__main { display: grid; gap: 1.4rem; }
  .ah__title {
    font-size: var(--fs-hero); /* hub-page H1 tier, shared with home, fleet, services and service areas */
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 13ch;
  }
  /* split masks are inline-blocks: align them to the top so they keep the tight display leading */
  .ah__title :global(.split-line) { vertical-align: top; }
  .ah__aside { display: grid; gap: 1.6rem; padding-bottom: 0.5rem; }
  .ah__aside .lead { max-width: 44ch; }
  .ah__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.8rem; }
  .ah__link { min-height: 44px; }
  .ah__link::after { bottom: 9px; }
  .ah__link :global(svg) { width: 15px; height: 15px; }

  /* ---------- Cinematic frame + facts ---------- */
  .ah__figure { position: relative; margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .ah__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-l);
    aspect-ratio: 2.4 / 1;
    background: var(--bg-3);
    box-shadow: var(--card-shadow);
  }
  /* Light overscan: the skyline source is 1280px wide, so keep it as close to 1:1 as the frame allows */
  .ah__par { position: absolute; inset: -4% 0; }
  .ah__par img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }
  .ah__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(var(--bg-rgb) / 0) 55%, rgb(var(--bg-rgb) / 0.42) 100%); pointer-events: none; }
  .ah__cap {
    position: absolute;
    left: clamp(1rem, 2.4vw, 1.8rem);
    top: clamp(1rem, 2.4vw, 1.6rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
    background: rgb(var(--bg-rgb) / 0.38);
    border: 1px solid var(--line-strong);
    /* -webkit- first: lightningcss drops the standard declaration when it follows the prefixed one */
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .ah__cap :global(svg) { width: 14px; height: 14px; }

  /* Facts float over the lower edge of the frame on desktop */
  .ah__facts {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: calc(clamp(3.5rem, 6vw, 4.8rem) * -1) clamp(1rem, 3vw, 2.5rem) 0;
    padding: clamp(1.1rem, 2vw, 1.6rem) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--glass);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    backdrop-filter: blur(22px) saturate(140%);
  }
  /* Ivory: a near-opaque panel, so the dark skyline never smudges through the frosted glass */
  :global([data-theme='light']) .ah__facts {
    background: color-mix(in srgb, var(--bg-3) 97%, transparent);
    box-shadow: var(--card-highlight), var(--card-shadow);
  }
  .ah__fact { display: grid; align-content: start; gap: 0.35rem; padding: 0.2rem clamp(1rem, 2.2vw, 1.8rem); }
  .ah__fact + .ah__fact { border-left: 1px solid var(--line); }
  .ah__fact-k { font-size: 0.64rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .ah__fact-v {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.3vw, 2.1rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    font-variant-numeric: lining-nums;
  }
  .ah__stars { display: inline-flex; color: var(--accent); }
  .ah__stars :global(svg) { width: 0.62em; height: 0.62em; }
  .ah__fact-sub { font-size: 0.8rem; line-height: 1.4; color: var(--muted); }

  @media (max-width: 980px) {
    .ah__head { grid-template-columns: 1fr; }
    .ah__media { aspect-ratio: 16 / 9; }
    .ah__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1rem; }
    .ah__fact:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 640px) {
    .ah__head { padding-top: 0.75rem; gap: 1.6rem; }
    .ah__ctas .btn { flex: 1 1 auto; }
    .ah__media { aspect-ratio: 4 / 3.4; border-radius: var(--radius); }
    .ah__par img { object-position: 30% 50%; }
    .ah__cap { font-size: 0.6rem; letter-spacing: 0.14em; }
    .ah__facts { margin: -2.2rem 0.6rem 0; padding: 1rem 0; }
    .ah__fact { padding: 0.2rem 1rem; }
    .ah__fact-sub { font-size: 0.74rem; }
  }
</style>
