---
// /services/ hero: editorial headline on the page canvas, a wide Seattle waterfront photograph (web-sized LCP image) and a quick index of the six services.
import Icon from '../Icon.astro';
import Crumbs from './Crumbs.astro';
import { site, images, services, serviceHref } from '../../data/site';
import { serviceIcon } from '../../data/service-pages';
---
<section class="ih" aria-labelledby="ih-title">
  <div class="ih__glow" aria-hidden="true"></div>
  <div class="container">
    <div data-reveal="fade"><Crumbs trail={[['Services']]} /></div>
    <div class="ih__row">
      <div class="ih__main">
        <p class="eyebrow" data-reveal="fade" data-delay="0.05">Chauffeur & limousine services</p>
        <h1 id="ih-title" class="ih__title" data-split>Chauffeured service for <em>every occasion.</em></h1>
      </div>
      <div class="ih__aside">
        <p class="lead" data-reveal data-delay="0.3">Six ways we move Seattle, each planned to the minute and driven by a professional chauffeur: early flights, executive days, weddings, cruise sailings, big nights out and unhurried afternoons in wine country.</p>
        <div class="ih__ctas" data-reveal data-delay="0.4">
          <a href="/book/" class="btn btn--gold btn--lg" data-magnetic>Reserve a ride <Icon name="arrow" /></a>
          <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
        </div>
      </div>
    </div>

    <div class="ih__stage">
      <div class="ih__banner media" data-reveal="scale" data-delay="0.15">
        <div class="ih__par" data-parallax="0.08">
          <img src={images.waterfront} alt="Downtown Seattle and the Elliott Bay waterfront at dusk, with the Great Wheel lit up" width="2600" height="1371" decoding="async" fetchpriority="high" />
        </div>
        <p class="ih__proof">
          <span class="stars" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
          <span><strong>{site.rating.score}</strong> from {site.rating.count} reviews · Since {site.since}</span>
        </p>
      </div>
      <nav class="ih__index glass" aria-label="Jump to a service" data-reveal data-delay="0.35">
        <ul role="list">
          {services.map((s) => (
            <li>
              <a href={serviceHref(s)} class="ih__link">
                <span class="ih__icon" aria-hidden="true"><Icon name={serviceIcon[s.slug] ?? 'car'} /></span>
                <span class="ih__name">{s.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</section>

<style>
  .ih { position: relative; isolation: isolate; padding: calc(var(--header-h) + clamp(0.5rem, 2vw, 1.5rem)) 0 clamp(2rem, 5vw, 4rem); overflow: hidden; }
  .ih__glow {
    position: absolute; z-index: -1; inset: -10% -10% auto 30%; height: 70%; pointer-events: none;
    background: radial-gradient(50% 50% at 60% 40%, rgb(var(--accent-rgb) / 0.11), rgb(var(--accent-rgb) / 0) 70%);
  }
  .ih__row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 2rem clamp(3rem, 6vw, 6rem);
    align-items: end;
    margin: clamp(1rem, 2.5vw, 2rem) 0 clamp(2.2rem, 4.5vw, 3.6rem);
  }
  .ih__main { display: grid; gap: 1.4rem; justify-items: start; }
  .ih__title { font-size: var(--fs-hero); line-height: 0.98; letter-spacing: -0.04em; max-width: 12ch; }
  .ih__title :global(.split-line) { vertical-align: top; }
  .ih__aside { display: grid; gap: 1.6rem; justify-items: start; padding-bottom: 0.4rem; }
  .ih__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .ih__stage { position: relative; }
  .ih__banner {
    height: clamp(320px, 40vw, 560px);
    border-radius: var(--radius-l);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 40px 80px -50px rgb(var(--fg-rgb) / 0.45);
  }
  :global([data-theme='dark']) .ih__banner { border: 1px solid var(--line); box-shadow: none; }
  .ih__par { position: absolute; inset: -10% 0; }
  /* Dusk waterfront: temper the pink sky slightly so it sits with the restrained ivory and onyx palette. */
  .ih__par img { width: 100%; height: 100%; object-fit: cover; object-position: 55% 62%; filter: saturate(0.82) contrast(1.02); }
  :global([data-theme='dark']) .ih__par img { filter: brightness(0.82) saturate(0.75) contrast(1.04); }
  .ih__proof {
    position: absolute; top: 1.1rem; right: 1.1rem;
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 1rem; border-radius: 999px;
    font-size: 0.8rem; color: var(--text-2);
    background: rgb(var(--bg-rgb) / 0.84); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  }
  .ih__proof strong { color: var(--text); font-weight: 600; }

  .ih__index {
    position: relative;
    z-index: 1;
    margin: -2.6rem clamp(1rem, 3vw, 2.5rem) 0;
    padding: 0.5rem;
    border-radius: 999px;
  }
  .ih__index ul { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.25rem; }
  .ih__link {
    display: flex; align-items: center; gap: 0.6rem;
    min-height: 56px; height: 100%; padding: 0.4rem 0.9rem 0.4rem 0.45rem;
    border-radius: 999px;
    font-size: 0.86rem; font-weight: 500; line-height: 1.2; color: var(--text-2);
    transition: background 0.4s var(--ease-out), color 0.3s;
  }
  .ih__link:hover { background: rgb(var(--fg-rgb) / 0.05); color: var(--text); }
  .ih__icon { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: rgb(var(--accent-rgb) / 0.1); color: var(--accent); transition: background 0.4s, color 0.4s; }
  .ih__icon :global(svg) { width: 17px; height: 17px; }
  .ih__link:hover .ih__icon { background: var(--cta-bg); color: var(--cta-fg); }

  @media (max-width: 1180px) {
    .ih__index { border-radius: var(--radius-l); }
    .ih__index ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .ih__row { grid-template-columns: 1fr; align-items: start; }
    .ih__title { max-width: 14ch; }
  }
  @media (max-width: 640px) {
    .ih__ctas { display: grid; width: 100%; }
    .ih__ctas .btn { width: 100%; }
    .ih__banner { height: auto; aspect-ratio: 4 / 3; border-radius: var(--radius); }
    .ih__proof { top: auto; bottom: 0.8rem; right: auto; left: 0.8rem; font-size: 0.74rem; padding: 0.45rem 0.8rem; }
    .ih__index { margin: 0.8rem 0 0; padding: 0.4rem; border-radius: var(--radius); }
    .ih__index ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ih__link { font-size: 0.8rem; padding-right: 0.5rem; gap: 0.5rem; }
    .ih__icon { width: 36px; height: 36px; }
  }
</style>
