---
// Service landing hero: editorial copy on the page canvas (always legible), photograph framed on the right.
import Icon from '../Icon.astro';
import Crumbs from './Crumbs.astro';
import { site, type Service } from '../../data/site';
import type { ServicePage } from '../../data/service-pages';

interface Props { service: Service; page: ServicePage }
const { service: s, page: p } = Astro.props;
const reserve = `/book/?type=${s.slug}`;
// Kicker phrases render as unbreakable units (same pattern as the home service cards). On phones, phrases past
// ~39 characters are dropped so the pill stays on one line and still hugs its text.
let run = 0;
const phrases = s.kicker.split(' · ').map((text, i) => {
  run += text.length + (i ? 3 : 0);
  return { text, phone: i === 0 || run <= 39 };
});
const imgStyle = [p.hero.position && `--pos:${p.hero.position}`, p.hero.positionSm && `--pos-sm:${p.hero.positionSm}`].filter(Boolean).join(';') || undefined;
---
<section class="sh" aria-labelledby="sh-title">
  <div class="sh__glow" aria-hidden="true"></div>
  <div class="container sh__grid">
    <div class="sh__copy">
      <div class="sh__crumbs" data-reveal="fade"><Crumbs trail={[['Services', '/services/'], [p.crumb ?? s.title]]} /></div>
      <p class="eyebrow" data-reveal="fade" data-delay="0.05">{p.eyebrow}</p>
      <h1 id="sh-title" class="sh__title" data-split>{p.h1.text} <em>{p.h1.em}</em></h1>
      <p class="lead sh__lead" data-reveal data-delay="0.3">{p.intro[0]}</p>
      <div class="sh__ctas" data-reveal data-delay="0.4">
        <a href={reserve} class="btn btn--gold btn--lg" data-magnetic>{p.reserveLabel} <Icon name="arrow" /></a>
        <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>
      </div>
      <ul class="sh__proof" role="list" data-reveal="fade" data-delay="0.5">
        <li>
          <span class="stars" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
          <span><strong>{site.rating.score}</strong> from {site.rating.count} reviews</span>
        </li>
        <li>Since {site.since}</li>
        <li><span class="sh__dot" aria-hidden="true"></span> Concierge 24/7</li>
      </ul>
    </div>

    <div class="sh__visual">
      <div class:list={['sh__frame media', p.hero.matte && 'sh__frame--matte']} style={p.hero.matte ? `--matte:${p.hero.matte}` : undefined} data-reveal="scale" data-delay="0.1">
        <div class="sh__par" data-parallax="0.06">
          <img
            src={p.hero.image}
            alt={p.hero.alt}
            width={p.hero.width}
            height={p.hero.height}
            decoding="async"
            fetchpriority="high"
            style={imgStyle}
          />
        </div>
        <span class="sh__tag"><Icon name="pin" /><span class="sh__tag-text"><span class="sh__tag-in">{phrases.map((k) => <span class:list={[!k.phone && 'sh__tag-x']}>{k.text}</span>)}</span></span></span>
      </div>
      <div class="sh__card glass" data-reveal data-delay="0.45">
        <p class="sh__card-k">At a glance</p>
        <ul role="list" class="sh__card-list">
          {s.points.map((pt) => <li><span class="sh__check" aria-hidden="true"><Icon name="check" /></span>{pt}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .sh {
    position: relative;
    isolation: isolate;
    padding: calc(var(--header-h) + clamp(0.5rem, 2vw, 1.5rem)) 0 clamp(2rem, 4vw, 3rem);
    overflow: hidden;
  }
  /* A warm wash behind the photograph: bronze on ivory, champagne on onyx. */
  .sh__glow {
    position: absolute;
    z-index: -1;
    inset: -20% -10% auto 35%;
    height: 120%;
    pointer-events: none;
    background:
      radial-gradient(50% 45% at 62% 40%, rgb(var(--accent-rgb) / 0.12), rgb(var(--accent-rgb) / 0) 70%),
      radial-gradient(35% 30% at 20% 85%, rgb(var(--accent-rgb) / 0.06), rgb(var(--accent-rgb) / 0) 70%);
  }
  .sh__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 5vw, 5.5rem);
    align-items: center;
  }
  /* minmax(0, 1fr): a long breadcrumb can never widen the column past the container. */
  .sh__copy { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; gap: 1.35rem; min-width: 0; }
  .sh__crumbs { justify-self: stretch; min-width: 0; }
  .sh__copy .eyebrow { margin-top: 0.4rem; }
  .sh__title {
    font-size: clamp(2.45rem, 4.9vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.038em;
    max-width: 13ch;
  }
  .sh__title :global(.split-line) { vertical-align: top; }
  .sh__lead { max-width: 52ch; }
  .sh__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }
  .sh__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.4rem;
    margin-top: 0.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    width: 100%;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .sh__proof li { display: inline-flex; align-items: center; gap: 0.55rem; }
  .sh__proof li + li::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--line-strong); margin-right: 0.85rem; }
  .sh__proof strong { color: var(--text); font-weight: 600; }
  .sh__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent); }

  /* ---------- Photograph ---------- */
  .sh__visual { position: relative; }
  .sh__frame {
    height: clamp(440px, 70vh, 680px);
    border-radius: var(--radius-l);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.05), 0 40px 80px -46px rgb(var(--fg-rgb) / 0.45);
  }
  :global([data-theme='dark']) .sh__frame { box-shadow: 0 40px 90px -50px rgb(0 0 0 / 0.9); border: 1px solid var(--line); }
  .sh__par { position: absolute; inset: -7% 0; }
  .sh__par img { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); }
  .sh__tag {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100% - 2.2rem);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    background: rgb(var(--bg-rgb) / 0.82);
    border: 1px solid var(--line);
    /* Prefixed first: in the reverse order the build minifier keeps only the -webkit- declaration. */
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .sh__tag :global(svg) { width: 14px; height: 14px; color: var(--accent); flex: none; }
  /* One line, whole phrases only: phrases that do not fit wrap onto a clipped second line (still read by
     screen readers), and each phrase's dot sits in a 1.4em lead-in that is clipped at the start of the line. */
  .sh__tag-text { min-width: 0; overflow: hidden; line-height: 1.5; max-height: 1.5em; }
  .sh__tag-in { display: flex; flex-wrap: wrap; margin-left: -1.4em; }
  .sh__tag-in > span { position: relative; padding-left: 1.4em; white-space: nowrap; }
  .sh__tag-in > span::before { content: '·'; content: '·' / ''; position: absolute; left: 0; width: 1.4em; text-align: center; opacity: 0.7; }

  /* Studio shots on a plain backdrop (matte): on the tall desktop frame the whole photo is letterboxed on
     the backdrop colour instead of cropped, so the subject is never cut off; its edges fade into the matte.
     The wide tablet/phone frames below keep the normal cover crop. */
  @media (min-width: 901px) {
    .sh__frame--matte { background: var(--matte); }
    .sh__frame--matte .sh__par img {
      position: absolute;
      left: 0;
      top: 44%;
      height: auto;
      translate: 0 -50%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 78%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 78%, transparent 100%);
    }
  }

  .sh__card {
    position: absolute;
    left: clamp(-3rem, -3vw, -1.5rem);
    bottom: clamp(1.5rem, 3vw, 2.5rem);
    width: min(300px, 78%);
    padding: 1.3rem 1.4rem 1.35rem;
    border-radius: var(--radius);
  }
  /* An opaque plate in both themes, so the copy keeps its contrast whatever photograph sits behind it
     (a translucent ivory turned grey over dark photos; translucent onyx let bright photos wash out the gold label). */
  :global([data-theme='light']) .sh__card { background: var(--bg-3); }
  :global([data-theme='dark']) .sh__card { background: color-mix(in srgb, var(--bg-3) 94%, transparent); }
  .sh__card-k { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.85rem; }
  .sh__card-list { display: grid; gap: 0.6rem; }
  .sh__card-list li { display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.9rem; line-height: 1.4; color: var(--text); }
  .sh__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 0.05rem;
    border-radius: 50%;
    background: rgb(var(--accent-rgb) / 0.12);
    color: var(--accent);
  }
  .sh__check :global(svg) { width: 12px; height: 12px; stroke-width: 2; }

  @media (max-width: 1100px) {
    .sh__card { left: -1.25rem; }
  }
  @media (max-width: 900px) {
    .sh__grid { grid-template-columns: minmax(0, 1fr); gap: 2.4rem; }
    .sh__title { max-width: 16ch; }
    .sh__frame { height: auto; aspect-ratio: 4 / 3; }
    .sh__par img { object-position: var(--pos-sm, var(--pos, 50% 50%)); }
    .sh__card { position: relative; left: auto; bottom: auto; width: auto; margin: -3rem 1rem 0; }
  }
  @media (max-width: 560px) {
    .sh__copy { gap: 1.15rem; }
    .sh__ctas { display: grid; width: 100%; }
    .sh__ctas .btn { width: 100%; }
    /* Items wrap on phones: drop the dot separators so no line starts with one. */
    .sh__proof { gap: 0.55rem 1.25rem; font-size: 0.8rem; }
    .sh__proof li + li::before { display: none; }
    .sh__frame { aspect-ratio: 5 / 4; border-radius: var(--radius); }
    .sh__tag { top: 0.8rem; left: 0.8rem; max-width: calc(100% - 1.6rem); font-size: 0.6rem; letter-spacing: 0.1em; }
    .sh__tag-in > .sh__tag-x { display: none; }
    .sh__card { margin: -2.5rem 0.6rem 0; padding: 1.1rem 1.15rem; }
  }
</style>
