---
// "Why us" band: commitments that apply to every service (sourced from site.ts FAQs and rating).
import Icon from '../Icon.astro';
import { site, areas } from '../../data/site';
import { reasons } from '../../data/service-pages';

const proof = [
  { value: site.rating.score, label: `Average rating from ${site.rating.count} reviews` },
  { value: String(site.since), label: 'Serving Seattle since' },
  { value: '24/7', label: 'Reservations desk' },
  { value: String(areas.length), label: 'Cities served, plus SeaTac' },
];
---
<section class="wu section surface-2" aria-labelledby="wu-title">
  <div class="container">
    <header class="section-head section-head--split wu__head">
      <div class="wu__head-main">
        <p class="eyebrow" data-reveal="fade">Why Door to Door</p>
        <h2 id="wu-title" data-split>The standard behind <em>every ride.</em></h2>
      </div>
      <p class="lead" data-reveal data-delay="0.1">Whatever the occasion, the essentials never change. They come with every booking, from a solo airport run to a fleet for a wedding.</p>
    </header>

    <ul class="wu__grid" role="list" data-stagger="0.07">
      {reasons.map((r, i) => (
        <li class="wu__item">
          <span class="wu__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="wu__icon" aria-hidden="true"><Icon name={r.icon} /></span>
          <h3 class="wu__title">{r.title}</h3>
          <p class="wu__text">{r.text}</p>
        </li>
      ))}
    </ul>

    <dl class="wu__proof" data-stagger="0.06">
      {proof.map((p) => (
        <div class="wu__stat">
          <dt class="wu__label">{p.label}</dt>
          <dd class="wu__value">{p.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .wu__head h2 :global(.split-line) { vertical-align: top; }
  .wu__head .lead { max-width: 52ch; }

  .wu__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); }
  .wu__item { position: relative; display: grid; align-content: start; gap: 0.75rem; padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1.2rem, 2vw, 1.8rem) 0 0; }
  .wu__item + .wu__item { padding-left: clamp(1.2rem, 2vw, 1.8rem); border-left: 1px solid var(--line); }
  /* --muted, not --muted-2: this band sits on surface-2, where --muted-2 falls below 4.5:1 in light mode. */
  .wu__idx { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .wu__icon { display: grid; place-items: center; width: 48px; height: 48px; margin: 0.4rem 0 0.3rem; border-radius: 50%; background: var(--cta-bg); color: var(--cta-fg); box-shadow: var(--cta-glow); }
  .wu__icon :global(svg) { width: 20px; height: 20px; }
  .wu__title { font-size: 1.22rem; letter-spacing: -0.02em; }
  .wu__text { color: var(--muted); font-size: 0.94rem; line-height: 1.6; }

  .wu__proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--bg-3);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 30px 60px -44px rgb(var(--fg-rgb) / 0.3);
  }
  :global([data-theme='dark']) .wu__proof { background: var(--card-bg); box-shadow: none; }
  .wu__stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.35rem; padding: clamp(1.3rem, 2.6vw, 2rem); }
  .wu__stat + .wu__stat { border-left: 1px solid var(--line); }
  .wu__value { font-family: var(--font-display); font-size: clamp(2rem, 3.4vw, 3rem); font-weight: 500; line-height: 1; letter-spacing: -0.04em; background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.05em; }
  .wu__label { font-size: 0.82rem; line-height: 1.45; color: var(--muted); }

  @media (max-width: 980px) {
    .wu__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wu__item + .wu__item:nth-child(3) { padding-left: 0; border-left: 0; }
    .wu__item:nth-child(n + 3) { border-top: 1px solid var(--line); margin-top: 1.6rem; }
    .wu__item { padding-bottom: 0; }
    .wu__proof { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wu__stat + .wu__stat:nth-child(3) { border-left: 0; }
    .wu__stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .wu__grid { grid-template-columns: 1fr; }
    .wu__item, .wu__item + .wu__item { padding: 1.5rem 0 0; border-left: 0; }
    .wu__item + .wu__item { border-top: 1px solid var(--line); margin-top: 1.5rem; }
    .wu__item { grid-template-columns: auto minmax(0, 1fr); column-gap: 1rem; row-gap: 0.35rem; }
    .wu__idx { display: none; }
    .wu__icon { grid-row: span 2; margin: 0; width: 44px; height: 44px; }
    .wu__proof { border-radius: var(--radius); }
    .wu__stat { padding: 1.1rem; }
  }
</style>
