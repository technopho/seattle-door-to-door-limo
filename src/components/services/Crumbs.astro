---
// Visible breadcrumb trail for light editorial heroes (the JSON-LD BreadcrumbList is added by the page).
interface Props { trail: [name: string, href?: string][] }
const { trail } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    <li><a href="/">Home</a></li>
    {trail.map(([name, href], i) =>
      i === trail.length - 1 || !href ? <li aria-current="page">{name}</li> : <li><a href={href}>{name}</a></li>
    )}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; align-items: center; flex-wrap: wrap; min-width: 0; max-width: 100%; }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .crumbs li + li::before { content: ''; width: 1.1rem; height: 1px; margin: 0 0.8rem; background: var(--line-strong); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); transition: color 0.35s var(--ease-out); }
  .crumbs a:hover { color: var(--text); }
  .crumbs [aria-current] { color: var(--text); }
  /* Phones: keep the trail on one line and let the current page truncate. */
  @media (max-width: 560px) {
    .crumbs ol { flex-wrap: nowrap; }
    .crumbs li { flex: none; white-space: nowrap; letter-spacing: 0.13em; }
    .crumbs li + li::before { width: 0.8rem; margin: 0 0.55rem; }
    .crumbs li[aria-current] { flex: 0 1 auto; min-width: 0; display: block; line-height: 44px; overflow: hidden; text-overflow: ellipsis; }
    .crumbs li[aria-current]::before { display: inline-block; vertical-align: middle; }
  }
</style>
