---
// Closing call to action: copy on a clean field, a Seattle photograph dissolving in from the right half (never under the text).
// Pass image={false} for the concierge variant, which lists the direct contact routes instead of a photo.
import Icon from '../Icon.astro';
import { site, images } from '../../data/site';
import type { Heading } from '../../data/service-pages';

interface Props {
  heading: Heading;
  text?: string;
  reserveHref?: string;
  reserveLabel?: string;
  image?: string | false;
  eyebrow?: string;
}
const {
  heading,
  text = 'Reserve online in four quick steps or speak to our reservations desk, day or night. Every booking is confirmed by a real person.',
  reserveHref = '/book/',
  reserveLabel = 'Reserve your ride',
  image = images.bellevue,
  eyebrow = 'Ready when you are',
} = Astro.props;
const [emailUser, emailDomain] = site.email.split('@');
const contacts = [
  { icon: 'phone', label: 'Call the reservations desk', value: site.phone, href: site.phoneHref },
  { icon: 'chat', label: 'Text your trip details', value: 'Text us', href: site.smsHref },
  { icon: 'mail', label: 'Email for quotes & accounts', value: site.email, href: `mailto:${site.email}`, email: true },
];
---
<section class="sc section" aria-labelledby="sc-title">
  <div class="container">
    <div class:list={['sc__card', image ? 'sc__card--photo' : 'sc__card--concierge']}>
      {image && (
        <div class="sc__bg" aria-hidden="true">
          <div class="sc__par" data-parallax="0.08"><img src={image} alt="" loading="lazy" decoding="async" width="1080" height="607" /></div>
        </div>
      )}
      <div class="sc__inner">
        <p class="eyebrow" data-reveal="fade">{eyebrow}</p>
        <h2 id="sc-title" data-split>{heading.text} <em>{heading.em}</em></h2>
        <p class="lead" data-reveal data-delay="0.1">{text}</p>
        <div class="sc__ctas" data-reveal data-delay="0.2">
          <a href={reserveHref} class="btn btn--gold btn--lg" data-magnetic>{reserveLabel} <Icon name="arrow" /></a>
          {image && <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-cursor="Call"><Icon name="phone" /> {site.phone}</a>}
        </div>
        {image ? (
          <p class="sc__alt" data-reveal="fade" data-delay="0.3">
            <span class="sc__dot" aria-hidden="true"></span> Concierge 24/7 · <a href={site.smsHref}>Text us</a> or <a href={`mailto:${site.email}`}>email</a>
          </p>
        ) : (
          <p class="sc__alt" data-reveal="fade" data-delay="0.3"><span class="sc__dot" aria-hidden="true"></span> A real person answers, 24/7</p>
        )}
      </div>
      {!image && (
        <ul class="sc__panel" role="list" data-stagger="0.08">
          {contacts.map((c) => (
            <li>
              <a href={c.href} class="sc__contact">
                <span class="sc__contact-icon" aria-hidden="true"><Icon name={c.icon} /></span>
                <span class="sc__contact-text">
                  <span>{c.label}</span>
                  {/* Email: allow a line break only after the @, never mid-word. */}
                  {c.email ? <strong class="sc__email">{emailUser}@<wbr />{emailDomain}</strong> : <strong>{c.value}</strong>}
                </span>
                <Icon name="arrow" class="sc__contact-arrow" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .sc { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .sc__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    min-height: clamp(420px, 46vw, 560px);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--bg-3);
    box-shadow: 0 1px 2px rgb(var(--fg-rgb) / 0.04), 0 40px 80px -50px rgb(var(--fg-rgb) / 0.4);
  }
  :global([data-theme='dark']) .sc__card { background: var(--bg-2); box-shadow: none; }
  .sc__card::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(60% 80% at 10% 0%, rgb(var(--accent-rgb) / 0.12), transparent 70%);
  }
  /* Photo variant: the copy ends before the card's midline and the photograph fades in from it,
     so text and buttons never sit on the image. A slimmer right padding keeps both buttons on one row. */
  .sc__card--photo .sc__inner { padding-right: clamp(1.5rem, 2.5vw, 2.5rem); }
  @media (min-width: 901px) and (max-width: 1200px) {
    .sc__card--photo .sc__inner .lead { max-width: 40ch; }
  }
  .sc__bg {
    position: absolute;
    inset: 0 0 0 50%;
    z-index: -2;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 35%);
  }
  .sc__par { position: absolute; inset: -10% 0; }
  .sc__par img { width: 100%; height: 100%; object-fit: cover; object-position: 55% 40%; filter: saturate(0.85); }
  :global([data-theme='dark']) .sc__par img { filter: saturate(0.7) brightness(0.72); }

  .sc__inner { display: grid; align-content: center; justify-items: start; gap: 1.3rem; padding: clamp(2rem, 5.5vw, 5rem); }
  .sc__inner h2 { max-width: 18ch; text-wrap: balance; }
  .sc__inner h2 :global(.split-line) { vertical-align: top; }
  .sc__inner .lead { max-width: 46ch; }
  .sc__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }
  /* Solid fill so the ghost button keeps its edge if it ever meets the photograph. */
  .sc__ctas .btn--ghost { background: rgb(var(--bg-rgb) / 0.9); }
  .sc__alt { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; font-size: 0.86rem; color: var(--muted); }
  .sc__alt a { display: inline-flex; align-items: center; min-height: 44px; color: var(--text); text-decoration: underline; text-decoration-color: rgb(var(--accent-rgb) / 0.5); text-underline-offset: 4px; transition: color 0.3s; }
  .sc__alt a:hover { color: var(--accent); }
  .sc__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent); }

  /* Concierge variant: direct contact routes in place of the photograph */
  .sc__card--concierge { align-items: center; min-height: 0; }
  .sc__panel { display: grid; gap: 0.7rem; padding: clamp(1.5rem, 4vw, 4rem) clamp(1.5rem, 4.5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem) 0; }
  .sc__contact {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
    min-height: 76px; padding: 0.8rem 1.3rem 0.8rem 0.8rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: rgb(var(--bg-rgb) / 0.55);
    transition: border-color 0.4s, transform 0.6s var(--ease-out), background 0.4s;
  }
  .sc__contact:hover { border-color: var(--line-strong); transform: translateX(4px); background: var(--bg); }
  .sc__contact-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--cta-bg); color: var(--cta-fg); box-shadow: var(--cta-glow); }
  .sc__contact-icon :global(svg) { width: 19px; height: 19px; }
  .sc__contact-text { display: grid; gap: 0.15rem; min-width: 0; line-height: 1.3; }
  .sc__contact-text span { font-size: 0.78rem; color: var(--muted); }
  .sc__contact-text strong { font-family: var(--font-display); font-size: clamp(1.05rem, 1.4vw, 1.25rem); font-weight: 500; letter-spacing: -0.015em; color: var(--text); overflow-wrap: break-word; }
  .sc__contact :global(.sc__contact-arrow) { width: 16px; height: 16px; color: var(--accent); transition: transform 0.4s var(--ease-out); }
  .sc__contact:hover :global(.sc__contact-arrow) { transform: translateX(3px); }

  @media (max-width: 900px) {
    .sc__card { grid-template-columns: 1fr; min-height: 0; }
    .sc__card--concierge .sc__inner { padding-top: clamp(2rem, 5vw, 3rem); padding-bottom: 0.5rem; }
    .sc__panel { padding: 0 clamp(1.2rem, 5vw, 3rem) clamp(1.6rem, 5vw, 3rem); }
    .sc__bg { inset: 0 0 auto 0; height: 260px; -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 100%); mask-image: linear-gradient(180deg, #000 30%, transparent 100%); }
    .sc__inner { padding-top: 236px; }
  }
  @media (max-width: 560px) {
    .sc__card { border-radius: var(--radius); }
    .sc__bg { height: 200px; }
    .sc__inner { padding: 186px 1.2rem 1.6rem; gap: 1.1rem; }
    .sc__ctas { display: grid; width: 100%; }
    .sc__ctas .btn { width: 100%; padding-inline: 1rem; }
    .sc__panel { padding: 0 1.2rem 1.4rem; gap: 0.55rem; }
    .sc__contact { gap: 0.8rem; min-height: 68px; padding: 0.7rem 1rem 0.7rem 0.7rem; }
    .sc__contact-icon { width: 44px; height: 44px; }
    .sc__contact-text .sc__email { font-size: 0.98rem; }
  }
</style>
