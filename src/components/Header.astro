---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, services, serviceHref } from '../data/site';

interface Props {
  /** Show the Reserve button (Base `headerCta`; off on the booking page itself). */
  cta?: boolean;
  /** Page opens on an always-dark hero (Base `darkHero`): render the bar dark from the first paint. */
  darkHero?: boolean;
}
const { cta = true, darkHero = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const menuLinks = [{ label: 'Home', href: '/' }, ...nav];
// Unique mask id for the sun/moon morph (kept per instance like the logo gradient).
const mid = `tt-${Math.random().toString(36).slice(2, 8)}`;
---
{/* Over a dark hero the bar starts dark server-side; global.ts drops data-theme once past the hero. */}
<header class="header" data-header data-theme={darkHero ? 'dark' : undefined}>
  <div class="header__bar container">
    <Logo class="header__logo" />

    <nav class="header__nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="header__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="header__roll"><span>{item.label}</span><span aria-hidden="true">{item.label}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={site.phoneHref} class="header__phone" data-cursor="Call" aria-label={`Call 24/7 Concierge ${site.phone}`}>
        <span class="header__phone-icon" aria-hidden="true"><Icon name="phone" /></span>
        <span class="header__phone-text" aria-hidden="true">
          <span class="header__phone-meta"><span class="header__pulse"></span>24/7 Concierge</span>
          <span class="header__phone-num">{site.phone}</span>
        </span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch theme">
        <svg class="tt" viewBox="0 0 24 24" aria-hidden="true">
          <mask id={mid}>
            <rect width="24" height="24" fill="#fff" />
            <circle class="tt__cut" cx="16.2" cy="7.8" r="7.4" fill="#000" />
          </mask>
          <circle class="tt__core" cx="12" cy="12" r="8" fill="currentColor" mask={`url(#${mid})`} />
          <path class="tt__rays" d="M12 1.8v2.4M12 19.8v2.4M4.8 4.8l1.7 1.7M17.5 17.5l1.7 1.7M1.8 12h2.4M19.8 12h2.4M4.8 19.2l1.7-1.7M17.5 6.5l1.7-1.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      {cta && <a href="/book/" class="btn btn--gold btn--sm header__cta" data-magnetic="0.25">Reserve <Icon name="arrow" /></a>}
      <button class="header__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu data-lenis-prevent inert>
  <div class="menu__glow" aria-hidden="true"></div>
  <div class="menu__scroll" data-menu-scroll>
  <div class="menu__inner container">
    <nav class="menu__nav" aria-label="Menu">
      <ul role="list" class="menu__list">
        {menuLinks.map((item, i) => (
          <li>
            <a href={item.href} data-menu-item aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="menu__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="menu__aside">
      <div class="menu__reveal"><div data-menu-item>
        <button class="menu__theme" type="button" data-theme-toggle role="switch" aria-checked="false">
          <span class="menu__theme-text">
            <span class="menu__theme-k">Dark mode</span>
            <span class="menu__theme-v" aria-hidden="true"><span class="menu__theme-light">Ivory · light</span><span class="menu__theme-dark">Onyx · dark</span></span>
          </span>
          <span class="menu__theme-track" aria-hidden="true">
            <span class="menu__theme-thumb"><Icon name="sun" class="menu__theme-sun" /><Icon name="moon" class="menu__theme-moon" /></span>
          </span>
        </button>
      </div></div>

      <div class="menu__reveal"><div data-menu-item>
        <p class="menu__h"><a href="/services/">Services</a></p>
        <ul role="list" class="menu__services">
          {services.map((s) => <li><a href={serviceHref(s)}>{s.title}<Icon name="arrow" /></a></li>)}
        </ul>
      </div></div>

      <div class="menu__reveal menu__reveal--contact"><div class="menu__contact" data-menu-item>
        <a href="/book/" class="btn btn--gold btn--block">Reserve a ride <Icon name="arrow" /></a>
        <div class="menu__contact-row">
          <a href={site.phoneHref} class="btn btn--ghost" aria-label={`Call ${site.phone}`}><Icon name="phone" /> Call</a>
          <a href={site.smsHref} class="btn btn--ghost" aria-label={`Text ${site.phone}`}><Icon name="chat" /> Text</a>
        </div>
        <p class="menu__note"><span class="menu__note-dot" aria-hidden="true"></span>Concierge on call 24/7 · {site.phone}</p>
      </div></div>
    </div>
  </div>
  </div>
</div>

<style>
  /* ---------- Bar ---------- */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    transition: transform 0.6s var(--ease-out), border-color 0.5s, height 0.5s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  /* Glass sheet: page-themed (ivory in light, obsidian in dark); fades in once scrolled */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--bg-rgb) / 0.8);
    /* Prefixed first: lightningcss (build minifier) drops the unprefixed property when it comes first */
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 1px 0 rgb(var(--fg-rgb) / 0.02), 0 14px 34px -28px rgb(var(--fg-rgb) / 0.35);
    opacity: 0;
    transition: opacity 0.5s;
  }
  /* Over a dark hero, a soft scrim keeps the links legible against bright footage */
  .header::after {
    content: '';
    position: absolute;
    inset: 0 0 -40px;
    z-index: -2;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0));
    opacity: 0;
    transition: opacity 0.5s;
  }
  :global(.header[data-theme='dark']:not(.is-scrolled))::after { opacity: 1; }
  :global(.header.is-scrolled) { height: 70px; border-bottom-color: var(--line); }
  :global(.header.is-scrolled)::before { opacity: 1; }
  :global(html[data-theme='dark'] .header.is-scrolled)::before,
  :global(.header[data-theme='dark'].is-scrolled)::before { box-shadow: 0 14px 34px -24px rgb(0 0 0 / 0.7); }
  /* Pages without a dark hero: the bar is always a solid glass sheet */
  :global(body:not([data-dark-hero])) .header { border-bottom-color: var(--line); }
  :global(body:not([data-dark-hero])) .header::before { opacity: 1; }
  :global(body.menu-open) .header { border-bottom-color: transparent; transform: none; }
  :global(body.menu-open) .header::before,
  :global(body.menu-open) .header::after { opacity: 0; }
  :global(.header.is-hidden) { transform: translateY(-100%); }
  :global(.header.is-hidden:focus-within) { transform: none; }

  /* Equal side columns keep the nav centred on the page, whatever the logo or the
     action cluster measure (and when a page hides the Reserve button). */
  .header__bar { display: grid; grid-template-columns: 1fr auto 1fr; grid-template-areas: 'logo nav actions'; align-items: center; gap: clamp(1.25rem, 2.5vw, 2.5rem); }
  .header__bar > :global(.logo) { grid-area: logo; justify-self: start; }
  .header__nav { grid-area: nav; }

  /* ---------- Primary nav ---------- */
  .header__nav ul { display: flex; gap: clamp(1.15rem, 2.1vw, 2.4rem); }
  /* Inline padding is cancelled by negative margins: same layout, room for a pill focus ring */
  .header__link { position: relative; display: block; padding: 0.95rem 0.5rem; margin-inline: -0.5rem; border-radius: 999px; font-size: 0.73rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; color: var(--text-2); transition: color 0.3s; }
  .header__link:focus-visible { outline-offset: -4px; color: var(--text); }
  .header__roll { position: relative; display: block; overflow: hidden; height: 1.3em; line-height: 1.3; }
  .header__roll span { display: block; transition: transform 0.5s var(--ease-out); }
  .header__roll span + span { position: absolute; inset: 100% 0 auto; color: var(--accent); }
  .header__link:hover .header__roll span { transform: translateY(-100%); }
  .header__link[aria-current='page'] { color: var(--text); }
  .header__link::after { content: ''; position: absolute; left: 50%; bottom: 0.35rem; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--accent); transform: scale(0); transition: transform 0.5s var(--ease-out); }
  .header__link[aria-current='page']::after { transform: scale(1); }

  /* ---------- Actions ---------- */
  .header__actions { grid-area: actions; justify-self: end; display: flex; align-items: center; gap: 0.75rem; }
  /* The open menu carries its own Reserve / Call / Text and a labelled theme switch,
     so the bar keeps only the close button. */
  .header__actions > :not(.header__burger) { transition: opacity 0.35s var(--ease-out), visibility 0s linear 0s; }
  :global(body.menu-open) .header__actions > :not(.header__burger) { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.25s, visibility 0s linear 0.25s; }
  .header__phone { position: relative; display: flex; align-items: center; min-height: 44px; padding-inline: 0.6rem; margin-inline: -0.6rem -0.25rem; line-height: 1.15; text-align: left; border-radius: 999px; }
  .header__phone-text { display: grid; gap: 3px; }
  .header__phone-meta { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .header__phone-num { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; letter-spacing: 0.005em; font-variant-numeric: tabular-nums; color: var(--text); transition: color 0.3s; }
  .header__phone:hover .header__phone-num { color: var(--accent); }
  .header__pulse { position: relative; width: 6px; height: 6px; flex: none; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); animation: pulse 2.2s ease-out 3; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--ok) 0%, transparent); } 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 0%, transparent); } }
  .header__phone-icon { display: none; }

  /* Round icon buttons share one look: hairline ring on a whisper of glass */
  .theme-toggle,
  .header__phone-icon,
  .header__burger {
    position: relative;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(var(--bg-rgb) / 0.3);
    color: var(--text);
    transition: border-color 0.3s, background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .theme-toggle { display: grid; place-items: center; }
  .theme-toggle:hover,
  .header__phone:hover .header__phone-icon,
  .header__burger:hover { border-color: rgb(var(--accent-rgb) / 0.6); color: var(--accent); background: rgb(var(--accent-rgb) / 0.08); }
  .header__phone-icon :global(svg) { width: 17px; height: 17px; }

  /* Sun/moon morph: shows the mode you'd switch to (moon in Ivory, sun in Onyx) */
  .tt { width: 19px; height: 19px; overflow: visible; transform: rotate(-12deg); transition: transform 0.7s var(--ease-out); }
  .tt__core { transform-origin: 12px 12px; transition: transform 0.7s var(--ease-out); }
  .tt__cut { transition: transform 0.7s var(--ease-out); }
  .tt__rays { transform-origin: 12px 12px; opacity: 0; transform: rotate(-60deg) scale(0.6); transition: transform 0.7s var(--ease-out), opacity 0.4s; }
  .theme-toggle:hover .tt { transform: rotate(-24deg); }
  :global(html[data-theme='dark']) .tt { transform: rotate(0deg); }
  :global(html[data-theme='dark']) .theme-toggle:hover .tt { transform: rotate(30deg); }
  :global(html[data-theme='dark']) .tt__core { transform: scale(0.54); }
  :global(html[data-theme='dark']) .tt__cut { transform: translate(11px, -11px); }
  :global(html[data-theme='dark']) .tt__rays { opacity: 1; transform: none; }

  .header__burger { display: none; }
  .header__burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; border-radius: 2px; background: currentColor; transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out); }
  .header__burger span:first-child { top: 17px; }
  .header__burger span:last-child { top: 25px; }
  :global(body.menu-open) .header__burger span:first-child { top: 21px; transform: rotate(45deg); }
  :global(body.menu-open) .header__burger span:last-child { top: 21px; transform: rotate(-45deg); }

  /* ---------- Responsive tiers ---------- */
  /* 1101–1280: phone collapses to an icon so five links + toggle + Reserve fit */
  @media (max-width: 1280px) {
    .header__phone { margin: 0; padding: 0; }
    .header__phone-text { display: none; }
    .header__phone-icon { display: grid; place-items: center; }
  }
  @media (max-width: 1100px) {
    .header__bar { grid-template-columns: 1fr auto; grid-template-areas: 'logo actions'; }
    .header__nav { display: none; }
    .header__burger { display: block; }
  }
  /* The mobile action bar carries Call / Text / Reserve below 760px */
  @media (max-width: 760px) {
    .header__phone { display: none; }
  }
  @media (max-width: 520px) {
    .header__actions { gap: 0.5rem; }
    .header__actions .header__cta { display: none; }
  }
  /* ≤ 350px (e.g. 320px, or 1280px at 400% zoom): logo + toggle + menu button no longer fit,
     so the bar keeps the menu button and the theme switch lives in the menu (its labelled switch). */
  @media (max-width: 350px) {
    .header__actions .theme-toggle { display: none; }
  }

  /* ---------- Overlay menu ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    overflow: hidden;
    background: var(--bg);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.9s var(--ease-in-out), visibility 0s linear 0.9s;
  }
  :global(body.menu-open) .menu { clip-path: inset(0 0 0 0); visibility: visible; transition: clip-path 0.9s var(--ease-in-out), visibility 0s; }
  .menu__glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(90% 60% at 85% 0%, rgb(var(--accent-rgb) / 0.1), transparent 60%), radial-gradient(120% 80% at 80% 0%, var(--bg-2) 0%, transparent 60%); }
  /* Scroll region starts under the header so links never slide beneath the bar */
  .menu__scroll {
    position: absolute;
    inset: var(--header-h) 0 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: env(safe-area-inset-bottom);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 18px);
    mask-image: linear-gradient(180deg, transparent 0, #000 18px);
  }
  .menu__inner { position: relative; margin-block: auto; display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem 4rem; align-items: end; padding-block: clamp(1.25rem, 4vh, 3rem); }

  .menu__list { display: grid; }
  .menu__list li { overflow: hidden; border-bottom: 1px solid var(--line); }
  .menu__list li:first-child { border-top: 1px solid var(--line); }
  .menu__list a { display: flex; align-items: baseline; gap: 1.1rem; padding-block: 0.32em; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.9rem, 4.6vw, 3.4rem); line-height: 1.1; letter-spacing: -0.035em; color: var(--text); transition: color 0.3s; }
  .menu__label { transition: transform 0.5s var(--ease-out); }
  .menu__idx { min-width: 1.8rem; font-family: var(--font-sans); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.16em; color: var(--muted); font-variant-numeric: tabular-nums; transform: translateY(-0.9em); transition: color 0.3s; }
  .menu__list a:hover, .menu__list a[aria-current='page'] { color: var(--accent); }
  .menu__list a:hover .menu__label { transform: translateX(8px); }
  .menu__list a:hover .menu__idx, .menu__list a[aria-current='page'] .menu__idx { color: var(--accent); }
  /* li clips the reveal animation, so the focus ring sits inside the row */
  .menu__list a:focus-visible { outline-offset: -2px; border-radius: 6px; color: var(--accent); }

  .menu__aside { display: grid; gap: 1.75rem; }
  .menu__reveal { overflow: hidden; padding: 6px; margin: -6px; } /* room for focus rings inside the reveal mask */
  .menu__h { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
  .menu__h a { display: inline-flex; align-items: center; min-height: 44px; }
  .menu__services { display: grid; }
  .menu__services a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; font-size: 0.98rem; color: var(--text-2); border-bottom: 1px solid var(--line); transition: color 0.3s; }
  .menu__services :global(svg) { width: 15px; height: 15px; flex: none; color: var(--muted-2); transition: transform 0.4s var(--ease-out), color 0.3s; }
  .menu__services a:hover { color: var(--text); }
  .menu__services a:hover :global(svg) { color: var(--accent); transform: translateX(3px); }
  .menu__services a:focus-visible { outline-offset: 2px; border-radius: 6px; }

  .menu__contact { display: grid; gap: 0.6rem; }
  .menu__contact-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .menu__note { display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 0.4rem; font-size: 0.8rem; color: var(--muted); }
  .menu__note-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); }

  /* Labeled theme switch */
  .menu__theme { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; min-height: 64px; padding: 0.75rem 1rem 0.75rem 1.1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card-bg); box-shadow: var(--card-shadow); text-align: left; transition: border-color 0.3s; }
  .menu__theme:hover { border-color: rgb(var(--accent-rgb) / 0.5); }
  .menu__theme-text { display: grid; gap: 0.15rem; }
  .menu__theme-k { font-size: 0.95rem; font-weight: 500; color: var(--text); }
  .menu__theme-v { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .menu__theme-dark { display: none; }
  .menu__theme-track { position: relative; width: 58px; height: 32px; flex: none; border-radius: 999px; background: rgb(var(--fg-rgb) / 0.07); border: 1px solid var(--line-strong); transition: background 0.4s, border-color 0.4s; }
  .menu__theme-thumb { position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-3); color: var(--text); box-shadow: 0 2px 6px -1px rgb(var(--fg-rgb) / 0.3); transition: transform 0.5s var(--ease-out), background 0.4s; }
  .menu__theme-thumb :global(svg) { grid-area: 1 / 1; width: 13px; height: 13px; stroke-width: 1.7; transition: opacity 0.3s, transform 0.5s var(--ease-out); }
  .menu__theme-thumb :global(.menu__theme-moon) { opacity: 0; transform: rotate(-60deg); }
  :global(html[data-theme='dark']) .menu__theme-track { background: rgb(var(--accent-rgb) / 0.22); border-color: rgb(var(--accent-rgb) / 0.5); }
  :global(html[data-theme='dark']) .menu__theme-thumb { transform: translateX(26px); background: var(--accent); color: var(--on-accent); box-shadow: none; }
  :global(html[data-theme='dark']) .menu__theme-thumb :global(.menu__theme-sun) { opacity: 0; transform: rotate(60deg); }
  :global(html[data-theme='dark']) .menu__theme-thumb :global(.menu__theme-moon) { opacity: 1; transform: none; }
  :global(html[data-theme='dark']) .menu__theme-light { display: none; }
  :global(html[data-theme='dark']) .menu__theme-dark { display: inline; }

  @media (max-width: 760px) {
    .menu__inner { grid-template-columns: 1fr; gap: 1.75rem; align-items: start; }
    .menu__list a { font-size: clamp(1.75rem, 8.4vw, 2.4rem); padding-block: 0.28em; }
    .menu__aside { gap: 1.4rem; }
    /* Phones: booking actions first (the quick-action bar is hidden while the menu is open) */
    .menu__reveal--contact { order: -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header__pulse { animation: none; }
  }
</style>
