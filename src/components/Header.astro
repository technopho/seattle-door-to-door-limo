---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, services } from '../data/site';
---
<header class="header" data-header>
  <div class="header__bar container">
    <Logo />
    <nav class="header__nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={item.href} class="header__link"><span>{item.label}</span><span aria-hidden="true">{item.label}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <a href={site.phoneHref} class="header__phone" data-cursor="Call">
        <span class="header__pulse" aria-hidden="true"></span>
        <span class="header__phone-meta">24/7 Concierge</span>
        <span class="header__phone-num">{site.phone}</span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch theme">
        <span class="theme-toggle__icon theme-toggle__sun"><Icon name="sun" /></span>
        <span class="theme-toggle__icon theme-toggle__moon"><Icon name="moon" /></span>
      </button>
      <a href="/book/" class="btn btn--gold btn--sm" data-magnetic="0.25">Reserve <Icon name="arrow" /></a>
      <button class="header__burger" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu inert>
  <div class="menu__inner container">
    <ul role="list" class="menu__list">
      <li><a href="/" data-menu-item>Home</a></li>
      {nav.map((item) => <li><a href={item.href} data-menu-item>{item.label}</a></li>)}
      <li><a href="/book/" data-menu-item>Reserve <em>a ride</em></a></li>
    </ul>
    <div class="menu__aside" data-menu-item>
      <button class="menu__theme" type="button" data-theme-toggle role="switch" aria-checked="false">
        <span class="menu__theme-text">
          <span class="menu__theme-k">Dark mode</span>
          <span class="menu__theme-v" aria-hidden="true"><span class="menu__theme-light">Ivory</span><span class="menu__theme-dark">Onyx</span></span>
        </span>
        <span class="menu__theme-track" aria-hidden="true">
          <span class="menu__theme-thumb"><Icon name="sun" class="menu__theme-sun" /><Icon name="moon" class="menu__theme-moon" /></span>
        </span>
      </button>
      <p class="eyebrow">Services</p>
      <ul role="list" class="menu__services">
        {services.map((s) => <li><a href={`/#services`}>{s.title}</a></li>)}
      </ul>
      <a href={site.phoneHref} class="btn btn--ghost btn--block mt"><Icon name="phone" /> {site.phone}</a>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    transition: transform 0.6s var(--ease-out), background 0.5s, border-color 0.5s, height 0.5s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--bg-rgb) / 0.84);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    box-shadow: 0 12px 32px -26px rgb(var(--fg-rgb) / 0.35);
    opacity: 0;
    transition: opacity 0.5s;
  }
  :global(.header.is-scrolled) { height: 70px; border-bottom-color: var(--line); }
  :global(.header.is-scrolled)::before { opacity: 1; }
  /* Pages without a dark hero: the bar is always a solid glass sheet */
  :global(body:not([data-dark-hero])) .header { border-bottom-color: var(--line); }
  :global(body:not([data-dark-hero])) .header::before { opacity: 1; }
  :global(body.menu-open) .header { border-bottom-color: transparent; }
  :global(body.menu-open) .header::before { opacity: 0; }
  :global(.header.is-hidden) { transform: translateY(-100%); }
  :global(body.menu-open) .header { transform: none; }

  .header__bar { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .header__nav ul { display: flex; gap: clamp(1.2rem, 2.4vw, 2.4rem); }
  .header__link { position: relative; display: block; overflow: hidden; height: 1.3em; font-size: 0.74rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-2); }
  .header__link span { display: block; transition: transform 0.5s var(--ease-out); }
  .header__link span + span { position: absolute; inset: 100% 0 auto; color: var(--accent); }
  .header__link:hover span { transform: translateY(-100%); }

  .header__actions { display: flex; align-items: center; gap: 1rem; }
  .header__phone { position: relative; display: grid; gap: 2px; padding-left: 1.05rem; margin-right: 0.4rem; line-height: 1.15; text-align: left; }
  .header__phone-meta { font-size: 0.58rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .header__phone-num { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; letter-spacing: 0.01em; font-variant-numeric: tabular-nums; transition: color 0.3s; }
  .header__phone:hover .header__phone-num { color: var(--accent); }
  .header__pulse { position: absolute; left: 0; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--ok) 0%, transparent); } 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 0%, transparent); } }

  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(var(--bg-rgb) / 0.25);
    color: var(--text);
    overflow: hidden;
    transition: border-color 0.3s, background 0.3s, color 0.3s;
  }
  .theme-toggle:hover { border-color: rgb(var(--accent-rgb) / 0.6); color: var(--accent); background: rgb(var(--accent-rgb) / 0.08); }
  .theme-toggle__icon { position: absolute; inset: 0; display: grid; place-items: center; transition: transform 0.6s var(--ease-out), opacity 0.4s; }
  .theme-toggle__icon :global(svg) { width: 17px; height: 17px; stroke-width: 1.5; }
  /* Show the mode you'd switch to: moon in light, sun in dark */
  .theme-toggle__sun { opacity: 0; transform: rotate(-90deg) scale(0.5); }
  :global(html[data-theme='dark']) .theme-toggle__sun { opacity: 1; transform: none; }
  :global(html[data-theme='dark']) .theme-toggle__moon { opacity: 0; transform: rotate(90deg) scale(0.5); }

  .header__burger { display: none; position: relative; width: 44px; height: 44px; flex: none; border-radius: 50%; border: 1px solid var(--line-strong); background: rgb(var(--bg-rgb) / 0.25); transition: border-color 0.3s; }
  .header__burger:hover { border-color: rgb(var(--accent-rgb) / 0.6); }
  .header__burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--text); transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out); }
  .header__burger span:first-child { top: 17px; }
  .header__burger span:last-child { top: 25px; }
  :global(body.menu-open) .header__burger span:first-child { top: 21px; transform: rotate(45deg); }
  :global(body.menu-open) .header__burger span:last-child { top: 21px; transform: rotate(-45deg); }

  @media (max-width: 1100px) {
    .header__nav, .header__phone { display: none; }
    .header__burger { display: block; }
  }
  @media (max-width: 520px) {
    .header__actions { gap: 0.6rem; }
    .header__actions .btn { display: none; }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: radial-gradient(120% 80% at 80% 0%, var(--bg-2) 0%, var(--bg) 55%);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-in-out);
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
    overflow-y: auto;
  }
  :global(body.menu-open) .menu { clip-path: inset(0 0 0 0); }
  .menu__inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; padding-block: 2rem; }
  .menu__list li { overflow: hidden; }
  .menu__list a { display: block; padding-block: 0.06em; font-family: var(--font-display); font-weight: 500; font-size: clamp(2.2rem, 6.4vw, 4.2rem); line-height: 1.1; letter-spacing: -0.035em; transition: color 0.3s, transform 0.5s var(--ease-out); }
  .menu__list a:hover { color: var(--accent); transform: translateX(10px); }
  .menu__list em { font-style: normal; font-weight: 400; color: var(--accent); }
  .menu__aside { align-self: end; display: grid; }
  .menu__aside .eyebrow { margin-top: 1.8rem; }
  .menu__services { margin-top: 1.1rem; display: grid; gap: 0.6rem; color: var(--text-2); }
  .menu__services a:hover { color: var(--accent); }

  /* Labeled theme switch inside the menu */
  .menu__theme { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; padding: 1rem 0; border-block: 1px solid var(--line); text-align: left; }
  .menu__theme-text { display: grid; gap: 0.2rem; }
  .menu__theme-k { font-size: 0.95rem; font-weight: 500; color: var(--text); }
  .menu__theme-v { font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .menu__theme-dark { display: none; }
  .menu__theme-track { position: relative; width: 58px; height: 32px; flex: none; border-radius: 999px; background: rgb(var(--fg-rgb) / 0.08); border: 1px solid var(--line-strong); transition: background 0.4s, border-color 0.4s; }
  .menu__theme-thumb { position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-3); color: var(--text); box-shadow: 0 2px 6px -1px rgb(var(--fg-rgb) / 0.3); transition: transform 0.5s var(--ease-out), background 0.4s; }
  .menu__theme-thumb :global(svg) { grid-area: 1 / 1; width: 13px; height: 13px; stroke-width: 1.7; transition: opacity 0.3s, transform 0.5s var(--ease-out); }
  .menu__theme-thumb :global(.menu__theme-moon) { opacity: 0; transform: rotate(-60deg); }
  :global(html[data-theme='dark']) .menu__theme-track { background: rgb(var(--accent-rgb) / 0.22); border-color: rgb(var(--accent-rgb) / 0.5); }
  :global(html[data-theme='dark']) .menu__theme-thumb { transform: translateX(26px); background: var(--accent); color: var(--on-accent); }
  :global(html[data-theme='dark']) .menu__theme-thumb :global(.menu__theme-sun) { opacity: 0; transform: rotate(60deg); }
  :global(html[data-theme='dark']) .menu__theme-thumb :global(.menu__theme-moon) { opacity: 1; transform: none; }
  :global(html[data-theme='dark']) .menu__theme-light { display: none; }
  :global(html[data-theme='dark']) .menu__theme-dark { display: inline; }
  @media (max-width: 760px) { .menu__inner { grid-template-columns: 1fr; gap: 2.2rem; } }
</style>
