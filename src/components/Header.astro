---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, services } from '../data/site';
---
<header class="header" data-header>
  <div class="header__bar container">
    <Logo />
    <nav class="header__nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={item.href} class="header__link"><span>{item.label}</span><span aria-hidden="true">{item.label}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <a href={site.phoneHref} class="header__phone" data-cursor="Call">
        <span class="header__pulse" aria-hidden="true"></span>
        <span class="header__phone-meta">24/7 Concierge</span>
        <span class="header__phone-num">{site.phone}</span>
      </a>
      <a href="/book/" class="btn btn--gold btn--sm" data-magnetic="0.25">Reserve <Icon name="arrow" /></a>
      <button class="header__burger" data-menu-toggle aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu inert>
  <div class="menu__inner container">
    <ul role="list" class="menu__list">
      <li><a href="/" data-menu-item>Home</a></li>
      {nav.map((item) => <li><a href={item.href} data-menu-item>{item.label}</a></li>)}
      <li><a href="/book/" data-menu-item>Reserve <em>a ride</em></a></li>
    </ul>
    <div class="menu__aside" data-menu-item>
      <p class="eyebrow">Services</p>
      <ul role="list" class="menu__services">
        {services.map((s) => <li><a href={`/#services`}>{s.title}</a></li>)}
      </ul>
      <a href={site.phoneHref} class="btn btn--ghost btn--block mt"><Icon name="phone" /> {site.phone}</a>
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    transition: transform 0.6s var(--ease-out), background 0.5s, border-color 0.5s, height 0.5s var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(10, 10, 12, 0.62);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    opacity: 0;
    transition: opacity 0.5s;
  }
  :global(.header.is-scrolled) { height: 70px; border-bottom-color: var(--line); }
  :global(.header.is-scrolled)::before { opacity: 1; }
  :global(.header.is-hidden) { transform: translateY(-100%); }
  :global(body.menu-open) .header { transform: none; }

  .header__bar { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .header__nav ul { display: flex; gap: clamp(1.2rem, 2.4vw, 2.4rem); }
  .header__link { position: relative; display: block; overflow: hidden; height: 1.3em; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ivory-2); }
  .header__link span { display: block; transition: transform 0.5s var(--ease-out); }
  .header__link span + span { position: absolute; inset: 100% 0 auto; color: var(--gold-2); }
  .header__link:hover span { transform: translateY(-100%); }

  .header__actions { display: flex; align-items: center; gap: 1.4rem; }
  .header__phone { position: relative; display: grid; padding-left: 1.1rem; line-height: 1.15; text-align: left; }
  .header__phone-meta { font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .header__phone-num { font-weight: 700; font-size: 0.95rem; letter-spacing: 0.02em; transition: color 0.3s; }
  .header__phone:hover .header__phone-num { color: var(--gold-2); }
  .header__pulse { position: absolute; left: 0; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 0 rgba(127, 200, 160, 0.6); animation: pulse 2.2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 9px rgba(127, 200, 160, 0); } 100% { box-shadow: 0 0 0 0 rgba(127, 200, 160, 0); } }

  .header__burger { display: none; position: relative; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line-strong); }
  .header__burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--ivory); transition: transform 0.5s var(--ease-out), top 0.5s var(--ease-out); }
  .header__burger span:first-child { top: 18px; }
  .header__burger span:last-child { top: 26px; }
  :global(body.menu-open) .header__burger span:first-child { top: 22px; transform: rotate(45deg); }
  :global(body.menu-open) .header__burger span:last-child { top: 22px; transform: rotate(-45deg); }

  @media (max-width: 1100px) {
    .header__nav, .header__phone { display: none; }
    .header__burger { display: block; }
  }
  @media (max-width: 520px) {
    .header__actions .btn { display: none; }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: radial-gradient(120% 80% at 80% 0%, #1c1912 0%, var(--ink) 55%);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-in-out);
    display: flex;
    align-items: center;
    padding-top: var(--header-h);
    overflow-y: auto;
  }
  :global(body.menu-open) .menu { clip-path: inset(0 0 0 0); }
  .menu__inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; padding-block: 2rem; }
  .menu__list li { overflow: hidden; }
  .menu__list a { display: block; font-family: var(--font-display); font-size: clamp(2.4rem, 7vw, 4.6rem); line-height: 1.1; transition: color 0.3s, transform 0.5s var(--ease-out); }
  .menu__list a:hover { color: var(--gold-2); transform: translateX(10px); }
  .menu__list em { font-style: italic; color: var(--gold); }
  .menu__aside { align-self: end; }
  .menu__services { margin-top: 1.2rem; display: grid; gap: 0.6rem; color: var(--ivory-2); }
  .menu__services a:hover { color: var(--gold-2); }
  @media (max-width: 760px) { .menu__inner { grid-template-columns: 1fr; } }
</style>
