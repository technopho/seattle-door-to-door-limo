---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; preloader?: boolean; footer?: boolean }
const {
  title = `${site.name} | Luxury Chauffeur & Limousine Service in Seattle`,
  description = 'Private chauffeured transportation across Seattle, Bellevue and the Puget Sound. Airport transfers, corporate travel, weddings and nights out. 24/7.',
  preloader = false,
  footer = true,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://www.seattledoortodoorlimo.com" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    {preloader && (
      <div class="preloader" data-preloader aria-hidden="true">
        <div class="preloader__inner">
          <span class="preloader__mask"><span data-pre-word>Seattle</span></span>
          <span class="preloader__mask preloader__big"><span data-pre-word>Door <em>to</em> Door</span></span>
          <span class="preloader__line" data-pre-line></span>
        </div>
      </div>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}

    <nav class="mobile-bar" aria-label="Quick actions">
      <a href={site.phoneHref} class="mobile-bar__btn"><Icon name="phone" /> Call</a>
      <a href={site.smsHref} class="mobile-bar__btn"><Icon name="chat" /> Text</a>
      <a href="/book/" class="mobile-bar__btn mobile-bar__btn--gold">Reserve <Icon name="arrow" /></a>
    </nav>

    <script>
      import '../scripts/global.ts';
    </script>
  </body>
</html>

<style>
  .preloader { position: fixed; inset: 0; z-index: 10000; display: grid; place-items: center; background: var(--ink); clip-path: inset(0 0 0 0); }
  .preloader__inner { display: grid; justify-items: center; gap: 0.6rem; }
  .preloader__mask { display: block; overflow: hidden; }
  .preloader__mask > span { display: block; font-size: 0.7rem; letter-spacing: 0.5em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
  .preloader__big > span { font-family: var(--font-display); font-size: clamp(2.6rem, 7vw, 5rem); letter-spacing: -0.01em; text-transform: none; color: var(--ivory); line-height: 1.05; }
  .preloader__big em { font-style: italic; color: var(--gold); }
  .preloader__line { display: block; width: min(320px, 60vw); height: 1px; background: var(--gold-grad); transform-origin: left; margin-top: 0.8rem; }

  .mobile-bar { display: none; }
  @media (max-width: 760px) {
    .mobile-bar {
      position: fixed;
      left: 10px;
      right: 10px;
      bottom: calc(10px + env(safe-area-inset-bottom));
      z-index: 80;
      display: grid;
      grid-template-columns: 1fr 1fr 1.4fr;
      gap: 6px;
      padding: 6px;
      border-radius: 999px;
      background: rgba(16, 16, 19, 0.82);
      border: 1px solid var(--line-strong);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      transform: translateY(150%);
      transition: transform 0.6s var(--ease-out);
    }
    :global(body.past-hero) .mobile-bar { transform: none; }
    :global(body.menu-open) .mobile-bar { transform: translateY(150%); }
    .mobile-bar__btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; min-height: 48px; border-radius: 999px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
    .mobile-bar__btn :global(svg) { width: 16px; height: 16px; }
    .mobile-bar__btn--gold { background: var(--gold-grad); color: #17130b; }
  }
</style>
